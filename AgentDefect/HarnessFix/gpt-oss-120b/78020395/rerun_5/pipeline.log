    {
      "id": "ADF-001",
      "title": "Include `assertions` field in StructuredOutputParser schema",
      "priority": "high",
      "target_files": [
        "task_agent/agentdefect_program/run_buggy.py"
      ],
      "target_symbols": [
        "get_output_parser"
      ],
      "problem_statement": "The current parser schema only defines `identifier` and `text`. The test expects an additional `assertions` key (list of dicts). Missing schema leads to parsing failure and test error.",
      "required_behavior_delta": "run_agent now returns a dict containing `identifier`, `text`, **and** `assertions` as defined by the new schema. The test `test_output_has_assertions` passes.",
      "implementation_steps": [
        "1. Import `ResponseSchema` for the new field.",
        "2. Define a ResponseSchema named `assertions` with a clear description and type `list[dict]` (you can use a nested schema for the dict elements).",
        "3. Append the new schema object to the `response_schemas` list in `get_output_parser`.",
        "4. (Optional) Create a helper `validate_parsed_output(result: dict)` that asserts `'assertions' in result` and raises a descriptive `ValueError` otherwise; call it after parsing inside `predict_result`.",
        "5. Run the existing test suite to verify the failure is resolved.",
        "6. Add a new pytest `test_parser_includes_assertions` that supplies a mock model response containing an `assertions` block, invokes `get_output_parser().parse`, and asserts the key presence."
      ],
      "tests": [
        "test_output_has_assertions (existing) – must now pass.",
        "test_parser_includes_assertions (new) – validates schema correctness."
      ],
      "risk_level": "low",
      "dependencies": [],
