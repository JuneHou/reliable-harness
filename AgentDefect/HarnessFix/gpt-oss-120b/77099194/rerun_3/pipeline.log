  },
  "fixes": [
    {
      "id": "R001",
      "title": "Increase CSV retriever top‑k to 5",
      "priority": "high",
      "target_files": ["run_buggy.py"],
      "target_symbols": ["ConversationalRetrievalChain.from_llm"],
      "problem_statement": "Retriever is configured with `k=1`, truncating context when multiple rows match the query. This causes the test `test_response_contains_movies` to miss the expected movie title.",
      "required_behavior_delta": "The agent must include answers derived from all matching CSV rows (up to a reasonable limit). When only one row matches, behavior remains unchanged.",
      "implementation_steps": [
        "Locate the `ConversationalRetrievalChain.from_llm` call in `run_buggy.py`.",
        "Change `search_kwargs={\"k\": 1}` to `search_kwargs={\"k\": 5}` (or a configurable constant).",
        "Optionally expose a module‑level constant `RETRIEVER_TOP_K = 5` and reference it in the call for future tuning.",
        "Add a comment explaining the rationale and the impact on test coverage.",
        "Create a new test `test_retriever_top_k.py` that loads a CSV with three matching rows and asserts that the answer mentions all three movie titles."
