+LANGUAGES = {".py": "Python", ".ts": "TypeScript", ".tsx": "TypeScript", ".js": "JavaScript", ".sh": "shell",
+             ".toml": "TOML", ".yml": "YAML", ".yaml": "YAML", ".cfg": "plain text", ".txt": "plain text",
+             ".md": "Markdown", ".ipynb": "Jupyter notebook JSON", ".json": "JSON"}
