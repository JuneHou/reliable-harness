+  /**
+   * Detect simple self‑introspection queries and answer them directly.
+   * This avoids delegating such queries to sub‑agents and prevents unnecessary loops.
+   */
+  private isIntrospectionQuery(messages: ChatMessage[]): boolean {
+    // Find the most recent user message
+    const lastUser = messages
+      .filter((m) => m.role === "user")
+      .pop()?.content?.toLowerCase() ?? "";
+    // Simple patterns that indicate a request for Evo's capabilities
+    const patterns = [
+      /what can (you|evo) do/, // e.g., "what can you do"
+      /your capabilities/,
+      /your abilities/,
+      /what are you able to/,
+      /help/i,
+    ];
+    return patterns.some((p) => p.test(lastUser));
+  }
+
+  private buildIntrospectionResponse(): string {
+    // A concise description of Evo's core abilities.
+    return (
+      "I am Evo, an evolving assistant that can achieve user goals by delegating tasks to specialized agents. " +
+      "I have access to a Developer agent (writes and edits code), a CsvAnalyst agent (processes CSV data), " +
+      "a Researcher agent (fetches information), and a Synthesizer agent (combines results). " +
+      "I can also call functions that interact with the internet, the file system, or other external tools. " +
+      "Ask me to perform a task and I will choose the best approach for you."
+    );
+  }
