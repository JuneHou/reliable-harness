++"""Export core classes and types for the ``autogen_agentchat.base`` package.
++
++The original implementation imported the primary classes from the submodules but
++omitted the :class:`~autogen_core.base.CancellationToken` (and its related
++types) which are part of the public API used throughout the documentation and
++example notebooks.  Importing ``CancellationToken`` from ``autogen_core.base``
++here ensures that ``from autogen_agentchat.base import CancellationToken``
++works without requiring consumers to know the exact location of the token's
++definition.  This mirrors the behaviour of other top‑level ``__init__`` files in
++the project and resolves import errors in the tutorial notebooks.
++"""
++
++from ._chat_agent import ChatAgent, Response
++from ._task import TaskResult, TaskRunner
++from ._team import Team
++from ._termination import TerminatedException, TerminationCondition
++
++# The CancellationToken lives in ``autogen_core.base``.  It is re‑exported here
++# for convenience so that tutorial code can import it directly from the
++# ``autogen_agentchat.base`` package.
++from autogen_core.base import CancellationToken
++
++__all__ = [
++    "ChatAgent",
++    "Response",
++    "Team",
++    "TerminatedException",
++    "TerminationCondition",
++    "TaskResult",
++    "TaskRunner",
++    "CancellationToken",
++]
