         @staticmethod
         def load_yaml(config_path: Path):
+            """Load a YAML file with automatic encoding detection.
+
+            The function reads the file in binary mode, attempts to detect the
+            encoding using ``chardet`` (if available), and falls back to UTF‑8.
+            This prevents ``UnicodeDecodeError`` when the file is encoded in
+            formats such as GBK, UTF‑16, etc.
+            """
             try:
-                with open(config_path, "r") as file:
-                    return yaml.safe_load(file)
+                # Read raw bytes first
+                with open(config_path, "rb") as file:
+                    raw_data = file.read()
+
+                # Try to detect encoding using chardet if the library is installed
+                encoding = "utf-8"
+                try:
+                    import chardet
+
+                    detection = chardet.detect(raw_data)
+                    if detection.get("encoding"):
+                        encoding = detection["encoding"]
+                except Exception:
+                    # If chardet is not installed or detection fails, keep default
+                    pass
+
+                try:
+                    text = raw_data.decode(encoding)
+                except UnicodeDecodeError:
+                    # As a last resort, decode with UTF‑8 while replacing errors
+                    text = raw_data.decode("utf-8", errors="replace")
+
+                return yaml.safe_load(text)
             except FileNotFoundError:
                 print(f"File not found: {config_path}")
                 raise
