index 67e85f9..0aa8be0 100644
--- a/src/crewai/project/crew_base.py
+++ b/src/crewai/project/crew_base.py
@@ -34,9 +34,32 @@ def CrewBase(cls):
 
         @staticmethod
         def load_yaml(config_path: Path):
+            """Load a YAML file with automatic encoding detection.
+
+            The function first attempts to read the file using UTF-8 encoding.
+            If a ``UnicodeDecodeError`` occurs, it falls back to detecting the
+            encoding with ``chardet`` (if available).  As a final fallback it
+            reads the file using ``latin-1`` which can decode any byte sequence.
+            """
+            # Primary attempt with UTF-8 (the common case)
             try:
-                with open(config_path, "r") as file:
+                with open(config_path, "r", encoding="utf-8") as file:
                     return yaml.safe_load(file)
+            except UnicodeDecodeError:
+                # Try to detect encoding using chardet if installed
+                try:
+                    import chardet
+
+                    raw_data = config_path.read_bytes()
+                    detection = chardet.detect(raw_data)
+                    encoding = detection.get("encoding") or "utf-8"
+                    # Use the detected encoding; replace errors to avoid crashes
+                    with open(config_path, "r", encoding=encoding, errors="replace") as file:
+                        return yaml.safe_load(file)
+                except Exception:
+                    # Final fallback – latin-1 (maps bytes directly to the first 256 Unicode code points)
+                    with open(config_path, "r", encoding="latin-1") as file:
+                        return yaml.safe_load(file)
             except FileNotFoundError:
                 print(f"File not found: {config_path}")
                 raise
