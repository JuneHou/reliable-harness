+# Mapping from attribute name to the module that defines it. This enables lazy loading of heavy
+# sub‑modules (e.g., those that initialise telemetry) only when the attribute is actually used.
+_MODULE_MAP = {
+    "Agent": "crewai.agent",
+    "Crew": "crewai.crew",
+    "Flow": "crewai.flow.flow",
+    "LLM": "crewai.llm",
+    "Pipeline": "crewai.pipeline",
+    "Process": "crewai.process",
+    "Router": "crewai.routers",
+    "Task": "crewai.task",
+}
+
+def __getattr__(name: str):
+    """Lazily import objects listed in ``__all__``.
+
+    This function is invoked for attribute accesses that are not found in the module's
+    ``globals()``. By importing the heavy sub‑modules only when needed we dramatically
+    reduce the import time of ``import crewai``.
+    """
+    if name in _MODULE_MAP:
+        module = importlib.import_module(_MODULE_MAP[name])
+        obj = getattr(module, name)
+        # Cache the imported object in the module's globals for subsequent accesses.
+        globals()[name] = obj
+        return obj
+    raise AttributeError(f"module 'crewai' has no attribute {name!r}")
