+# Public API symbols that the package intends to expose.  They will be lazily imported
+# on first access to dramatically reduce the import time of the top‑level package.
+__all__ = [
+    "Agent",
+    "Crew",
+    "Process",
+    "Task",
+    "Pipeline",
+    "Router",
+    "LLM",
+    "Flow",
+]
+
+# Mapping from the exposed attribute name to the module that actually defines it.
+# This allows us to import the heavy sub‑modules only when the attribute is accessed.
+_name_to_module = {
+    "Agent": "crewai.agent",
+    "Crew": "crewai.crew",
+    "Process": "crewai.process",
+    "Task": "crewai.task",
+    "Pipeline": "crewai.pipeline",
+    "Router": "crewai.routers",
+    "LLM": "crewai.llm",
+    "Flow": "crewai.flow.flow",
+}
+
+
+def __getattr__(name: str):
+    """Lazily import symbols defined in ``__all__``.
+
+    Python will call this function for attribute look‑ups that fail the normal
+    lookup process.  We use it to import the required sub‑module only when the
+    attribute is first accessed, avoiding the heavy imports that were previously
+    executed at package import time.
+    """
+    if name in _name_to_module:
+        module = importlib.import_module(_name_to_module[name])
+        attr = getattr(module, name)
+        # Cache the attribute in the package namespace so subsequent look‑ups
+        # are fast and do not trigger another import.
+        globals()[name] = attr
+        return attr
+    raise AttributeError(f"module 'crewai' has no attribute {name!r}")
+
+
+def __dir__():
+    """Return the list of available attributes for ``dir(crewai)``.
+
+    This combines the module's globals with the lazily exported symbols.
+    """
+    return sorted(list(globals().keys()) + __all__)
