diff --git a/src/crewai/__init__.py b/src/crewai/__init__.py
index 0833afd..d116f72 100644
--- a/src/crewai/__init__.py
+++ b/src/crewai/__init__.py
@@ -1,12 +1,22 @@
-import warnings
+"""Top level package for CrewAI.
+
+The original implementation imported a large number of sub‑modules at import time. Some of those
+sub‑modules depend on optional heavy dependencies (for example ``litellm`` which pulls in
+``tiktoken``). Importing them unconditionally caused the package installation to try to import
+``tiktoken`` even when the user did not request the optional ``embeddings`` extra, leading to a
+build failure on platforms where pre‑compiled wheels for ``tiktoken`` are unavailable.
+
+To avoid this problem we now lazily import the public objects. ``__getattr__`` is used so that the
+objects are only imported when they are first accessed. This keeps the package lightweight at
+import time and prevents unnecessary optional dependencies from being installed during a
+standard ``pip install crewai``.
+"""
 
-from crewai.agent import Agent
-from crewai.crew import Crew
-from crewai.flow.flow import Flow
-from crewai.knowledge.knowledge import Knowledge
-from crewai.llm import LLM
-from crewai.process import Process
-from crewai.task import Task
+import importlib
+import sys
+import warnings
+from types import ModuleType
+from typing import Any
 
 warnings.filterwarnings(
     "ignore",
@@ -14,7 +24,10 @@ warnings.filterwarnings(
     category=UserWarning,
     module="pydantic.main",
 )
+
 __version__ = "0.86.0"
+
+# Public symbols that are part of the stable API.  They will be loaded lazily.
 __all__ = [
     "Agent",
     "Crew",
@@ -24,3 +37,36 @@ __all__ = [
     "Flow",
     "Knowledge",
 ]
+
+# Mapping from attribute name to the module that actually defines it.
+_lazy_imports = {
+    "Agent": "crewai.agent",
+    "Crew": "crewai.crew",
+    "Process": "crewai.process",
+    "Task": "crewai.task",
+    "LLM": "crewai.llm",
+    "Flow": "crewai.flow.flow",
+    "Knowledge": "crewai.knowledge.knowledge",
+}
+
+
+def __getattr__(name: str) -> Any:
+    """Dynamically import objects listed in ``__all__``.
+
+    This function is invoked by Python when an attribute lookup on the package fails.
+    If the attribute is one of the lazily‑loadable public symbols we import the target
+    module and return the requested object.
+    """
+    if name in _lazy_imports:
+        module_name = _lazy_imports[name]
+        module: ModuleType = importlib.import_module(module_name)
+        attr = getattr(module, name)
+        # Cache the attribute on the package so future lookups are fast.
+        setattr(sys.modules[__name__], name, attr)
+        return attr
+    raise AttributeError(f"module 'crewai' has no attribute {name!r}")
+
+
+def __dir__() -> list[str]:
+    """Ensure that ``dir(crewai)`` includes the lazily imported names."""
+    return sorted(list(globals().keys()) + list(_lazy_imports.keys()))
