++"""Utility callbacks for token usage counting.
++
++This module integrates with **litellm**'s custom logger system to collect token
++usage statistics from successful LLM calls.  The original implementation made
++strong assumptions about the availability of internal CrewAI modules and the
++structure of the ``response_obj`` returned by litellm.  Those assumptions caused
++import errors during package installation, especially when the optional
++``base_token_process`` module is not present (e.g. when only a subset of CrewAI
++is installed).
++
++To make the package robust we:
++
++* Guard the import of ``TokenProcess`` with a ``try/except`` block and provide a
++  lightweight fallback stub that implements the expected methods as no‑ops.
++* Accept ``None`` for ``token_cost_process`` and handle it gracefully.
++* Use ``dict`` access with ``dict.get`` to avoid ``KeyError`` if the ``usage``
++  field is missing.
++* Add type hints that tolerate the optional nature of the dependencies.
++
++These changes prevent import‑time failures and allow the rest of CrewAI to be
++installed and used even when the optional token‑processing utilities are not
++available.
++"""
++
++from __future__ import annotations
++
++from typing import Any, Optional
++
++from litellm.integrations.custom_logger import CustomLogger
++
++# ``TokenProcess`` is an optional internal class used for aggregating token
++# statistics.  It may not be present in minimal installations, so we provide a
++# safe fallback.
++try:
++    from crewai.agents.agent_builder.utilities.base_token_process import (
++        TokenProcess,
++    )
++except Exception:  # pragma: no cover – import may fail in stripped builds
++
++    class TokenProcess:  # type: ignore[misc]
++        """Fallback stub that mimics the real ``TokenProcess`` API.
++
++        The real implementation records token usage metrics.  The stub simply
++        implements the methods as no‑ops so that callers can interact with it
++        without side effects.
++        """
++
++        def sum_successful_requests(self, _: int) -> None:  # noqa: D401
++            """Record a successful request – no‑op fallback."""
++
++        def sum_prompt_tokens(self, _: int) -> None:  # noqa: D401
++            """Add prompt token count – no‑op fallback."""
++
++        def sum_completion_tokens(self, _: int) -> None:  # noqa: D401
++            """Add completion token count – no‑op fallback."""
++
++        def sum_cached_prompt_tokens(self, _: int) -> None:  # noqa: D401
++            """Add cached prompt token count – no‑op fallback."""
++
++
++class TokenCalcHandler(CustomLogger):
++    """Custom logger that updates a :class:`TokenProcess` with usage data.
++
++    Parameters
++    ----------
++    token_cost_process:
++        An instance of ``TokenProcess`` (or ``None``).  If ``None`` the handler
++        becomes a passive logger.
++    """
++
++    def __init__(self, token_cost_process: Optional[TokenProcess] = None):
++        self.token_cost_process = token_cost_process
++
++    # The signature matches litellm's ``CustomLogger.log_success_event``.
++    def log_success_event(
++        self,
++        kwargs: dict[str, Any] | None,
++        response_obj: dict[str, Any] | None,
++        start_time: Any,
++        end_time: Any,
++    ) -> None:
++        """Handle a successful LLM call and update token metrics.
++
++        The function is defensive: if ``token_cost_process`` is ``None`` or the
++        ``response_obj`` does not contain the expected ``usage`` dictionary, the
++        method simply returns without raising.
++        """
++
++        if self.token_cost_process is None or not response_obj:
++            return
++
++        usage = response_obj.get("usage", {})
++        # ``usage`` is expected to be a mapping with integer fields.  We use
++        # ``dict.get`` with default ``0`` to guard against missing keys.
++        prompt_tokens = int(usage.get("prompt_tokens", 0))
++        completion_tokens = int(usage.get("completion_tokens", 0))
++        prompt_details = usage.get("prompt_tokens_details", {}) or {}
++        cached_prompt_tokens = int(prompt_details.get("cached_tokens", 0))
++
++        self.token_cost_process.sum_successful_requests(1)
++        self.token_cost_process.sum_prompt_tokens(prompt_tokens)
++        self.token_cost_process.sum_completion_tokens(completion_tokens)
++        if cached_prompt_tokens:
++            self.token_cost_process.sum_cached_prompt_tokens(cached_prompt_tokens)
