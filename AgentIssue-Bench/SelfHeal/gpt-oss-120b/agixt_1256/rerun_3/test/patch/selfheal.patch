++    """Return the list of extensions and their commands for a specific agent.
++
++    The previous implementation delegated to ``agent.get_agent_extensions()``
++    which constructed an ``Extensions`` instance without providing the agent's
++    configuration. As a result the ``Extensions`` object defaulted to an empty
++    ``agent_config`` (no saved command enable/disable states). The UI therefore
++    displayed the default state after a page refresh, making it appear that the
++    selected commands were not persisted.
++
++    To fix this we retrieve the agent's configuration explicitly and pass it to
++    the ``Extensions`` constructor. ``Extensions`` uses ``agent_config["commands"]``
++    to determine which commands are enabled, ensuring the persisted state is
++    honoured.
++    """
++    ApiClient = get_api_client()
++    agent = Agent(agent_name=agent_name, user=user, ApiClient=ApiClient)
++    # Retrieve the full agent configuration, which includes the saved commands
++    agent_config = agent.get_agent_config()
++    # Initialise Extensions with the retrieved configuration so that command
++    # enable/disable states are correctly reflected.
++    extensions_helper = Extensions(
++        agent_name=agent_name,
++        agent_id=agent.agent_id,
++        agent_config=agent_config,
++        ApiClient=ApiClient,
++        user=user,
++    )
++    extensions = extensions_helper.get_extensions()
++    return {"extensions": extensions}
