+        """Register the telemetry tracer provider if telemetry is enabled.
+
+        When telemetry is disabled ``self.ready`` is ``False`` and ``self.provider``
+        is never created. The original implementation attempted to access
+        ``self.provider`` unconditionally which raised an ``AttributeError`` and
+        could trigger fallback behaviour that still tried to export spans.
+        This guard ensures we only interact with the provider when it exists.
+        """
+        if not self.ready or self.trace_set:
+            return
+        # ``self.provider`` is only defined when telemetry is enabled.
+        if not hasattr(self, "provider") or self.provider is None:
+            return
+        try:
+            with suppress_warnings():
+                trace.set_tracer_provider(self.provider)
+                self.trace_set = True
+        except Exception:
+            # If anything goes wrong we keep telemetry disabled.
+            self.ready = False
+            self.trace_set = False
 
