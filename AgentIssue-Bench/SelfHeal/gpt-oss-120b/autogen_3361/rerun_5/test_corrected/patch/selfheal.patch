--- a/autogen/coding/func_with_reqs.py
+++ b/autogen/coding/func_with_reqs.py
@@ -34,7 +34,6 @@ class ImportFromModule:
     module: str
     imports: List[Union[str, Alias]]
 
-
 Import = Union[str, ImportFromModule, Alias]
 
 
@@ -156,13 +155,44 @@ def with_requirements(
 def _build_python_functions_file(
     funcs: List[Union[FunctionWithRequirements[Any, P], Callable[..., Any], FunctionWithRequirementsStr]]
 ) -> str:
-    # First collect all global imports
-    global_imports = set()
+    """Build a python file containing all required global imports and function definitions.
+
+    The previous implementation used a ``set`` to collect imports, which fails for
+    ``ImportFromModule`` objects because they are mutable dataclasses and therefore
+    unhashable.  This resulted in a ``TypeError: unhashable type: 'ImportFromModule'``
+    when a user supplied such an import via ``global_imports``.
+
+    To fix the issue we now collect imports in a list, deduplicate them while
+    preserving order, and then generate the import statements.
+    """
+    # Collect all imports in order of appearance
+    all_imports: List[Import] = []
     for func in funcs:
         if isinstance(func, (FunctionWithRequirements, FunctionWithRequirementsStr)):
-            global_imports.update(func.global_imports)
-
-    content = "\n".join(map(_import_to_str, global_imports)) + "\n\n"
+            all_imports.extend(func.global_imports)
+
+    # Deduplicate while preserving order. Since ImportFromModule is unhashable we
+    # construct a hashable key for each import kind.
+    seen_keys = set()
+    unique_imports: List[Import] = []
+    for imp in all_imports:
+        if isinstance(imp, ImportFromModule):
+            # Build a deterministic key using the module name and a tuple of the
+            # imported names (including alias information). ``Alias`` objects are
+            # also unhashable, so we convert them to a tuple.
+            imports_key = tuple(
+                (i.name, i.alias) if isinstance(i, Alias) else (i, None) for i in imp.imports
+            )
+            key = ("from", imp.module, imports_key)
+        elif isinstance(imp, Alias):
+            key = ("alias", imp.name, imp.alias)
+        else:  # plain string import
+            key = ("import", imp)
+        if key not in seen_keys:
+            seen_keys.add(key)
+            unique_imports.append(imp)
+
+    content = "\n".join(map(_import_to_str, unique_imports)) + "\n\n"
 
     for func in funcs:
         content += _to_code(func) + "\n\n"
