+# ``Alias`` objects are stored in a ``set`` inside ``build_python_functions_file``.
+# To be usable as set elements they must be hashable.  By default a ``dataclass``
+# is mutable and therefore unhashable.  Marking the class as ``frozen`` makes it
+# immutable and automatically provides a ``__hash__`` implementation based on its
+# fields.
++@dataclass(frozen=True)
++class Alias:
++    name: str
++    alias: str
+
+
+# ``ImportFromModule`` is also stored in a ``set``.  Its ``imports`` attribute was
+# originally a mutable ``list`` which is itself unhashable, causing a ``TypeError``
+# when the containing ``ImportFromModule`` instance was added to the set.  We
+# change the attribute to an immutable ``tuple`` and make the dataclass frozen so
+# the whole object becomes hashable.
++@dataclass(frozen=True)
++class ImportFromModule:
++    module: str
++    imports: tuple[Union[str, Alias], ...]
++
++    def __init__(self, module: str, imports: Sequence[Union[str, Alias]]) -> None:
++        # ``Sequence`` allows both list and tuple inputs from user code.
++        object.__setattr__(self, "module", module)
++        object.__setattr__(self, "imports", tuple(imports))
 
 Import = Union[str, ImportFromModule, Alias]
 
