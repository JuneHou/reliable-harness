+    def _clean_think_tags(self, messages: List[OpenAIMessage]) -> List[OpenAIMessage]:
+        """Remove any <think>...</think> tags from the content of messages.
+
+        This method works with both dict‑style messages and pydantic/model
+        objects that expose a ``content`` attribute and support ``copy``.
+        """
+        cleaned: List[OpenAIMessage] = []
+        for msg in messages:
+            # Extract original content safely
+            if isinstance(msg, dict):
+                original_content = msg.get("content", "")
+            else:
+                original_content = getattr(msg, "content", "")
+
+            # Strip <think> tags
+            new_content = re.sub(r"<think>.*?</think>", "", original_content, flags=re.DOTALL).strip()
+
+            if isinstance(msg, dict):
+                new_msg = {**msg, "content": new_content}
+            else:
+                # Most OpenAIMessage instances are pydantic BaseModel objects
+                if hasattr(msg, "copy"):
+                    new_msg = msg.copy(update={"content": new_content})  # type: ignore[arg-type]
+                else:
+                    # Fallback – mutate a shallow copy of __dict__
+                    tmp = dict(msg.__dict__)
+                    tmp["content"] = new_content
+                    new_msg = tmp  # type: ignore[assignment]
+            cleaned.append(new_msg)  # type: ignore[arg-type]
+        return cleaned
+
