+    def _strip_think_tags(self, content: str) -> str:
+        """Remove any <think>...</think> blocks from a string.
+
+        The DeepSeek API does not accept these tags, so they must be stripped
+        before sending the request.
+        """
+        return re.sub(r'<think>.*?</think>', '', content, flags=re.DOTALL).strip()
+
+    def _remove_think_from_messages(self, messages: List[OpenAIMessage]) -> List[OpenAIMessage]:
+        """Return a new list of messages with <think> tags removed from the
+        ``content`` field.
+        Supports both dict‑like messages and objects with a ``content`` attribute.
+        """
+        cleaned: List[OpenAIMessage] = []
+        for msg in messages:
+            # Dict‑like message
+            if isinstance(msg, dict):
+                original = msg.get("content", "")
+                cleaned_msg = {**msg, "content": self._strip_think_tags(original)}
+                cleaned.append(cleaned_msg)  # type: ignore[arg-type]
+            else:
+                # Assume attribute access
+                original = getattr(msg, "content", "")
+                new_content = self._strip_think_tags(original)
+                try:
+                    setattr(msg, "content", new_content)
+                except Exception:
+                    # If the message is immutable, fall back to creating a copy
+                    if hasattr(msg, "copy"):
+                        msg = msg.copy()  # type: ignore[assignment]
+                        setattr(msg, "content", new_content)
+                cleaned.append(msg)
+        return cleaned
+
