+    def _strip_think_tags_from_message(self, msg: OpenAIMessage) -> OpenAIMessage:
+        """Utility to remove <think>...</think> tags from a single message.
+
+        The function works for both dict‑like messages and pydantic/BaseModel
+        messages that expose a ``content`` attribute.
+        """
+        # Extract original content safely
+        if isinstance(msg, dict):
+            content = msg.get("content")
+        else:  # Assume pydantic/BaseModel like object
+            content = getattr(msg, "content", None)
+
+        if isinstance(content, str):
+            new_content = re.sub(r'<think>.*?</think>', '', content, flags=re.DOTALL).strip()
+        else:
+            new_content = content
+
+        # Re‑create message preserving its original type
+        if isinstance(msg, dict):
+            new_msg = {**msg, "content": new_content}
+        else:
+            # For pydantic models we use ``model_dump`` (pydantic v2) or ``dict``
+            if hasattr(msg, "model_dump"):
+                data = msg.model_dump()
+            else:
+                data = dict(msg)
+            data["content"] = new_content
+            new_msg = msg.__class__(**data)
+        return new_msg
+
