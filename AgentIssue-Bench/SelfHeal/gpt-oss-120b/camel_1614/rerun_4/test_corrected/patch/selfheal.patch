+    def _remove_think_tags(self, messages: List[OpenAIMessage]) -> List[OpenAIMessage]:
+        """Utility to strip <think>...</think> blocks from message contents.
+
+        Handles both dict‑like messages and objects with a ``content`` attribute.
+        Returns a new list with the cleaned messages (the original objects are
+        modified in‑place for compatibility)."""
+        cleaned_messages: List[OpenAIMessage] = []
+        for msg in messages:
+            # Extract original content safely
+            if isinstance(msg, dict):
+                original_content = msg.get("content", "")
+            else:
+                original_content = getattr(msg, "content", "")
+            # Remove any <think>...</think> blocks
+            new_content = re.sub(r"<think>.*?</think>", "", original_content, flags=re.DOTALL).strip()
+            # Apply the cleaned content back to the message
+            if isinstance(msg, dict):
+                msg = {**msg, "content": new_content}
+            else:
+                setattr(msg, "content", new_content)
+            cleaned_messages.append(msg)
+        return cleaned_messages
+
