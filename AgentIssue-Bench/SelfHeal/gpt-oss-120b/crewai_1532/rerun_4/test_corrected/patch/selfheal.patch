+# ---------------------------------------------------------------------------
+# Telemetry can be globally disabled via the OTEL_SDK_DISABLED environment
+# variable.  The OpenTelemetry SDK performs imports and internal registration at
+# import time, which can trigger network activity even if we later decide not to
+# initialise a TracerProvider.  To prevent any side‑effects we guard the imports
+# of the OpenTelemetry packages behind the environment check.  When telemetry is
+# disabled we provide lightweight no‑op stand‑ins so the rest of the module can
+# continue to reference the same names without causing errors.
+# ---------------------------------------------------------------------------
+
+_DISABLE_TELEMETRY = os.getenv("OTEL_SDK_DISABLED", "false").lower() == "true"
+
+if not _DISABLE_TELEMETRY:
+    # Real OpenTelemetry imports – only executed when telemetry is enabled.
+    from opentelemetry import trace  # noqa: E402
+    from opentelemetry.exporter.otlp.proto.http.trace_exporter import (
+        OTLPSpanExporter,  # noqa: E402
+    )
+    from opentelemetry.sdk.resources import SERVICE_NAME, Resource  # noqa: E402
+    from opentelemetry.sdk.trace import TracerProvider  # noqa: E402
+    from opentelemetry.sdk.trace.export import BatchSpanProcessor  # noqa: E402
+else:
+    # Minimal no‑op shims – they expose the attributes used in the code but do
+    # nothing.  This avoids import errors while guaranteeing that no network
+    # calls are made.
+    class _NoOp:
+        def __getattr__(self, name: str):
+            # Return a callable that ignores its arguments and returns None.
+            def _ignore(*_args, **_kwargs):
+                return None
+
+            return _ignore
+
+    trace = _NoOp()
+    OTLPSpanExporter = _NoOp  # type: ignore
+    ServiceName = None  # placeholder – not used when telemetry is disabled
+    Resource = _NoOp  # type: ignore
+    TracerProvider = _NoOp  # type: ignore
+    BatchSpanProcessor = _NoOp  # type: ignore
+    SERVICE_NAME = "crewAI-telemetry"  # dummy value for consistency
+
+if TYPE_CHECKING:
+    from crewai.crew import Crew
+    from crewai.task import Task
+
 
