+# library robust we provide lightweight fallback stubs that mimic the public
+# interface required by this module.  The stubs simply return the original
+# function without performing any retries – this is sufficient for basic
+# functionality and keeps the dependency optional.
+try:
+    from tenacity import retry, retry_if_result, stop_after_attempt, wait_fixed
+except ImportError:  # pragma: no cover
+    def retry(*dargs, **dkwargs):  # type: ignore
+        """Fallback ``retry`` decorator that returns the original function.
+
+        The real ``tenacity.retry`` returns a decorator that wraps the target
+        function with retry logic.  Our stub accepts arbitrary positional and
+        keyword arguments so existing call sites remain valid.
+        """
+
+        def decorator(func):
+            return func
+
+        return decorator
+
+    class retry_if_result:  # type: ignore
+        def __init__(self, predicate):
+            self.predicate = predicate
+
+    class stop_after_attempt:  # type: ignore
+        def __init__(self, attempts):
+            self.attempts = attempts
+
+    class wait_fixed:  # type: ignore
+        def __init__(self, seconds):
+            self.seconds = seconds
 
