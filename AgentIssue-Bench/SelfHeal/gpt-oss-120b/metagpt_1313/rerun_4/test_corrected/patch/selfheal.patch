     async def _observe(self, ignore_memory=False) -> int:
+        """Override Role._observe to handle Werewolf‑specific message routing.
+
+        The generic :class:`Message` used throughout MetaGPT does not define a ``restricted_to``
+        attribute – only the specialised :class:`WwMessage` does.  The original implementation
+        accessed ``m.restricted_to`` directly which raised an ``AttributeError`` when a normal
+        ``Message`` (e.g., a user requirement) was observed.  To make the method robust we use
+        ``getattr`` with a default empty ``set``.  This preserves the intended semantics:
+
+        * If ``restricted_to`` is empty, the message is public.
+        * If it contains entries, the current role only processes the message when its
+          ``profile`` or ``name`` is listed.
+        """
         if self.status != RoleState.ALIVE:
             # 死者不再参与游戏
             return 0
@@ -60,20 +72,17 @@ class BasePlayer(Role):
