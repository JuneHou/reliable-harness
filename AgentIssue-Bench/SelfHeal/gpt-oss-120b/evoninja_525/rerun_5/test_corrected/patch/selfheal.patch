+  /**
+   * Approximate token count using a simple character based heuristic.
+   * This is not exact but works well enough to keep the request under the model's context limit.
+   */
+  private _estimateTokens(text: string): number {
+    // Rough estimate: 1 token ~= 4 characters (common heuristic for English text)
+    return Math.ceil(text.length / 4);
+  }
+
+  /**
+   * Trim the list of messages so that the total estimated token count does not exceed
+   * the model's maximum context tokens. It retains the most recent messages.
+   */
+  private _trimMessages(messages: ChatCompletionMessageParam[], maxTokens: number): ChatCompletionMessageParam[] {
+    const trimmed: ChatCompletionMessageParam[] = [];
+    let usedTokens = 0;
+    // Process from newest to oldest to preserve recent context.
+    for (let i = messages.length - 1; i >= 0; i--) {
+      const msg = messages[i];
+      // Determine the textual content of the message (role + content).
+      const content = typeof msg === "object" && "content" in msg && typeof msg.content === "string"
+        ? msg.content
+        : "";
+      const tokenCount = this._estimateTokens(content);
+      if (usedTokens + tokenCount > maxTokens) {
+        // If adding this message would exceed the limit, stop adding older messages.
+        break;
+      }
+      usedTokens += tokenCount;
+      // Prepend because we are iterating backwards.
+      trimmed.unshift(msg);
+    }
+    return trimmed;
+  }
