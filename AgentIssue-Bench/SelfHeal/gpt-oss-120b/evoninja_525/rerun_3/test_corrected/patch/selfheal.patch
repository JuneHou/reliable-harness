+// Utility to split a long string into safe‑size chunks (approximate token limit).
+export function splitIntoChunks(text: string, maxChunkLength: number): string[] {
+  const chunks: string[] = [];
+  let start = 0;
+  while (start < text.length) {
+    const end = Math.min(start + maxChunkLength, text.length);
+    chunks.push(text.slice(start, end));
+    start = end;
+  }
+  return chunks;
+}
