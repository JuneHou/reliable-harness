diff --git a/docs/en/conf.py b/docs/en/conf.py
index 0d92c9f..b64be9c 100644
--- a/docs/en/conf.py
+++ b/docs/en/conf.py
@@ -13,9 +13,28 @@
 import os
 import re
 import sys
+import types
 
 sys.path.insert(0, os.path.abspath('../..'))
 
+# Compatibility shim for newer versions of ``griffe``
+# ``sphinx-autoapi`` historically imported ``griffe.enumerations`` which was
+# renamed to ``griffe.enums`` in recent releases.  To keep the documentation
+# build working without pinning a specific ``griffe`` version, we create a
+# lightweight shim that re‑exports the new module under the old name.
+try:
+    import griffe.enumerations  # noqa: F401
+except Exception:  # pragma: no cover
+    try:
+        import griffe.enums as _griffe_enums
+        shim = types.ModuleType('griffe.enumerations')
+        shim.__dict__.update(_griffe_enums.__dict__)
+        sys.modules['griffe.enumerations'] = shim
+    except Exception:
+        # If ``griffe`` itself is missing we simply ignore – the import will be
+        # handled later when the package is installed.
+        pass
+
