+def __getattr__(name: str) -> Any:
+    r"""Lazily imports and returns a public attribute of the package.
+
+    Toolkits usually depend on optional third-party packages (for instance
+    :obj:`TwitterToolkit` requires ``requests_oauthlib``). Importing every
+    toolkit eagerly in this module would make the whole ``camel.toolkits``
+    package unusable whenever one of those optional dependencies is missing,
+    even when only unrelated toolkits are needed. Therefore each submodule is
+    imported on first access only.
+
+    Args:
+        name (str): The name of the attribute being accessed.
+
+    Returns:
+        Any: The requested object, either defined in this module or resolved
+            from the submodule that defines it.
+
+    Raises:
+        AttributeError: If the package has no attribute (nor submodule) with
+            the requested name.
+    """
+    if name.startswith('__') and name.endswith('__'):
+        # Do not trigger imports for special (dunder) attributes.
+        raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
+
+    module_path = _NAME_TO_MODULE.get(name)
+    if module_path is not None:
+        # Let the (possible) ImportError of a missing optional dependency
+        # propagate: it only happens for the toolkit that was asked for.
+        module = importlib.import_module(module_path, __name__)
+        value = getattr(module, name)
+        globals()[name] = value
+        return value
+
+    # Fall back to submodules so that ``camel.toolkits.<submodule>`` stays
+    # accessible right after ``import camel.toolkits``.
+    try:
+        module = importlib.import_module(f'.{name}', __name__)
+    except ModuleNotFoundError as exc:
+        if exc.name == f'{__name__}.{name}':
+            raise AttributeError(
+                f"module {__name__!r} has no attribute {name!r}"
+            ) from None
+        raise
+    globals()[name] = module
+    return module
+
+
+def __dir__() -> List[str]:
+    r"""Returns the list of names exposed by this package.
+
+    Returns:
+        List[str]: The sorted names of the module globals and of ``__all__``.
+    """
+    return sorted(set(globals()) | set(__all__))
