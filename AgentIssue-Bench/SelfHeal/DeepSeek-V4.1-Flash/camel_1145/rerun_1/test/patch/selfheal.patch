+
+# Mapping between the public names exported by this package and the submodule
+# that defines them. These names are imported lazily (see ``__getattr__``
+# below) so that a missing *optional* dependency of one toolkit (for example
+# ``requests_oauthlib`` required by the Twitter toolkit) does not prevent
+# importing this package or any unrelated toolkit (for example
+# ``MathToolkit``) from it.
+_LAZY_IMPORTS: Dict[str, str] = {
+    'MathToolkit': '.math_toolkit',
+    'MATH_FUNCS': '.math_toolkit',
+    'SearchToolkit': '.search_toolkit',
+    'SEARCH_FUNCS': '.search_toolkit',
+    'WeatherToolkit': '.weather_toolkit',
+    'WEATHER_FUNCS': '.weather_toolkit',
+    'DalleToolkit': '.dalle_toolkit',
+    'DALLE_FUNCS': '.dalle_toolkit',
+    'AskNewsToolkit': '.ask_news_toolkit',
+    'AsyncAskNewsToolkit': '.ask_news_toolkit',
+    'LinkedInToolkit': '.linkedin_toolkit',
+    'RedditToolkit': '.reddit_toolkit',
+    'GoogleMapsToolkit': '.google_maps_toolkit',
+    'CodeExecutionToolkit': '.code_execution',
+    'GithubToolkit': '.github_toolkit',
+    'GoogleScholarToolkit': '.google_scholar_toolkit',
+    'ArxivToolkit': '.arxiv_toolkit',
+    'SlackToolkit': '.slack_toolkit',
+    'TwitterToolkit': '.twitter_toolkit',
+    'TWITTER_FUNCS': '.twitter_toolkit',
+    'OpenAPIToolkit': '.open_api_toolkit',
+    'RetrievalToolkit': '.retrieval_toolkit',
+    'NotionToolkit': '.notion_toolkit',
+}
+
+
+def __getattr__(name: str) -> Any:
+    r"""Lazily imports toolkit classes and their function lists on first
+    access.
+
+    Optional dependencies of a toolkit are only imported when the toolkit
+    that needs them is actually used, so importing unrelated toolkits never
+    fails because of a missing optional package.
+
+    Args:
+        name (str): The name of the attribute being accessed.
+
+    Returns:
+        Any: The requested attribute, imported from its submodule.
+
+    Raises:
+        AttributeError: If the requested attribute is not provided by this
+            package.
+    """
+    module_name = _LAZY_IMPORTS.get(name)
+    if module_name is None:
+        raise AttributeError(
+            f"module {__name__!r} has no attribute {name!r}"
+        )
+    module = importlib.import_module(module_name, __name__)
+    value = getattr(module, name)
+    # Cache the resolved object so later lookups are cheap.
+    globals()[name] = value
+    return value
+
+
+def __dir__() -> List[str]:
+    r"""Returns the list of names publicly exposed by this package.
+
+    Returns:
+        List[str]: The sorted public names of this package.
+    """
+    return sorted(set(__all__))
