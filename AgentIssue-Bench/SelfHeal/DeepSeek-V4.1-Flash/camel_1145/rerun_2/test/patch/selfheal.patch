+    'NotionToolkit': 'notion_toolkit',
+    'OpenAPIToolkit': 'open_api_toolkit',
+    'RedditToolkit': 'reddit_toolkit',
+    'RetrievalToolkit': 'retrieval_toolkit',
+    'SEARCH_FUNCS': 'search_toolkit',
+    'SearchToolkit': 'search_toolkit',
+    'SlackToolkit': 'slack_toolkit',
+    'TWITTER_FUNCS': 'twitter_toolkit',
+    'TwitterToolkit': 'twitter_toolkit',
+    'WEATHER_FUNCS': 'weather_toolkit',
+    'WeatherToolkit': 'weather_toolkit',
+}
+
+
+def __getattr__(name: str) -> Any:
+    r"""Lazily imports toolkits (and their function lists) on first access.
+
+    Importing a toolkit module may require optional third-party
+    dependencies. Deferring the import until the toolkit is actually used
+    keeps ``camel.toolkits`` importable even when some of those optional
+    dependencies are not installed.
+
+    Args:
+        name (str): The attribute being accessed on the package.
+
+    Returns:
+        Any: The requested toolkit class or function list.
+
+    Raises:
+        AttributeError: If the attribute is unknown to this package.
+    """
+    module_name = _TOOLKIT_MODULES.get(name)
+    if module_name is None:
+        raise AttributeError(
+            f"module {__name__!r} has no attribute {name!r}"
+        )
+
+    module = importlib.import_module(f'.{module_name}', __name__)
+
+    try:
+        attribute = getattr(module, name)
+    except AttributeError as exc:  # pragma: no cover - defensive
+        raise AttributeError(
+            f"module {__name__!r} has no attribute {name!r}"
+        ) from exc
+
+    # Cache the resolved attribute so subsequent lookups skip ``__getattr__``.
+    globals()[name] = attribute
+    return attribute
+
+
+def __dir__() -> list:
+    r"""Lists the public attributes of the package, including lazy ones."""
+    return sorted(set(globals()) | set(_TOOLKIT_MODULES))
