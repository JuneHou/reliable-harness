+# Mapping between the public names exposed by this package and the modules
+# that actually define them. The modules are imported lazily (see
+# ``__getattr__`` below) so that importing ``camel.toolkits`` does not require
+# the optional third-party dependencies of *every* toolkit to be installed.
+_TOOLKIT_MODULES = {
+    'AskNewsToolkit': 'ask_news_toolkit',
+    'AsyncAskNewsToolkit': 'ask_news_toolkit',
+    'ArxivToolkit': 'arxiv_toolkit',
+    'CodeExecutionToolkit': 'code_execution',
+    'DALLE_FUNCS': 'dalle_toolkit',
+    'DalleToolkit': 'dalle_toolkit',
+    'GithubToolkit': 'github_toolkit',
+    'GoogleMapsToolkit': 'google_maps_toolkit',
+    'GoogleScholarToolkit': 'google_scholar_toolkit',
+    'LinkedInToolkit': 'linkedin_toolkit',
+    'MATH_FUNCS': 'math_toolkit',
