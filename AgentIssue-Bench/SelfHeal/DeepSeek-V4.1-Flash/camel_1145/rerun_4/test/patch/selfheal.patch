+def __getattr__(name: str) -> Any:
+    r"""Lazily imports and returns an attribute of the toolkits package.
+
+    This implements lazy loading of the toolkit modules (PEP 562), so that
+    importing :mod:`camel.toolkits` does not import every single toolkit and
+    therefore does not require the optional third-party dependencies of the
+    toolkits that are not used.
+
+    Args:
+        name (str): The name of the attribute to retrieve.
+
+    Returns:
+        Any: The requested attribute (a toolkit class, function, or
+            submodule).
+
+    Raises:
+        AttributeError: If the attribute does not exist in this package.
+    """
+    module_path = _ATTR_TO_MODULE.get(name)
+    if module_path is not None:
+        module = importlib.import_module(module_path, __name__)
+        return getattr(module, name)
+
+    if name in _SUBMODULES:
+        return importlib.import_module(f'.{name}', __name__)
+
+    raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
+
+
+def __dir__() -> List[str]:
+    r"""Returns the list of names available in this package.
+
+    Returns:
+        List[str]: The sorted list of public names plus the names that are
+            already present in the module namespace.
+    """
+    return sorted(set(list(globals().keys()) + __all__))
