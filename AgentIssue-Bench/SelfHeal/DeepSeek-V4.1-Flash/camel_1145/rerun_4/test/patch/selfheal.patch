+def _get_oauth1() -> Any:
+    r"""Lazily imports :obj:`requests_oauthlib.OAuth1` and builds an
+    authentication object from the Twitter credentials in the environment.
+
+    The :obj:`requests_oauthlib` package is an optional dependency that is
+    only required when the Twitter/X API is actually called, therefore the
+    import is performed inside this helper instead of at module level. This
+    keeps ``import camel.toolkits.twitter_toolkit`` (and the import of other,
+    unrelated toolkits) working when ``requests_oauthlib`` is not installed.
+
+    Returns:
+        Any: An :obj:`requests_oauthlib.OAuth1` authentication object.
+
+    Raises:
+        ImportError: If :obj:`requests_oauthlib` is not installed.
+    """
+    try:
+        from requests_oauthlib import OAuth1
+    except ImportError as exc:
+        raise ImportError(
+            "The `requests_oauthlib` package is required to use the Twitter "
+            "toolkit. Please install it with "
+            "`pip install requests_oauthlib`."
+        ) from exc
+
+    return OAuth1(
+        os.getenv("TWITTER_CONSUMER_KEY"),
+        os.getenv("TWITTER_CONSUMER_SECRET"),
+        os.getenv("TWITTER_ACCESS_TOKEN"),
+        os.getenv("TWITTER_ACCESS_TOKEN_SECRET"),
+    )
