@@ -553,3 +553,88 @@ it('should convert nullable string enum', () => {
     },
   });
 });
+
+it('should keep nested empty object schemas (no `undefined` values)', () => {
+  const input: JSONSchema7 = {
+    type: 'object',
+    properties: {
+      nested: {
+        type: 'object',
+        properties: {
+          emptyObject: { type: 'object' },
+        },
+      },
+      emptyObject: { type: 'object', properties: {} },
+    },
+    required: ['nested', 'emptyObject'],
+  };
+
+  const result = convertJSONSchemaToOpenAPISchema(input) as {
+    properties: Record<string, unknown>;
+  };
+
+  expect(result.properties.nested).toEqual({
+    type: 'object',
+    properties: {
+      emptyObject: { type: 'object' },
+    },
+  });
+  expect(result.properties.emptyObject).toEqual({ type: 'object' });
+  expect(result.properties.emptyObject).not.toBeUndefined();
+});
+
+it('should handle record schemas (additionalProperties) without generating undefined', () => {
+  const input: JSONSchema7 = {
+    type: 'object',
+    properties: {
+      metadata: {
+        type: 'object',
+        additionalProperties: { type: 'string' },
+      },
+    },
+    required: ['metadata'],
+    additionalProperties: false,
+  };
+
+  expect(convertJSONSchemaToOpenAPISchema(input)).toEqual({
+    type: 'object',
+    properties: {
+      metadata: { type: 'object' },
+    },
+    required: ['metadata'],
+  });
+});
+
+it('should handle record schemas nested in arrays', () => {
+  const input: JSONSchema7 = {
+    type: 'object',
+    properties: {
+      entries: {
+        type: 'array',
+        items: {
+          type: 'object',
+          additionalProperties: { type: 'number' },
+        },
+      },
+    },
+  };
+
+  expect(convertJSONSchemaToOpenAPISchema(input)).toEqual({
+    type: 'object',
+    properties: {
+      entries: {
+        type: 'array',
+        items: { type: 'object' },
+      },
+    },
+  });
+});
+
+it('should not convert a record schema at the root to undefined', () => {
+  const input: JSONSchema7 = {
+    type: 'object',
+    additionalProperties: { type: 'string' },
+  };
+
+  expect(convertJSONSchemaToOpenAPISchema(input)).toEqual({ type: 'object' });
+});
