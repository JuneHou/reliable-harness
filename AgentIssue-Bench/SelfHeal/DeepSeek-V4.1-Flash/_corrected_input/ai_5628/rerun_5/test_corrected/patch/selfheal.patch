     },
   });
 });
+
+it('should handle record schemas (additionalProperties) without producing undefined', () => {
+  const input: JSONSchema7 = {
+    type: 'object',
+    properties: {
+      headers: {
+        type: 'object',
+        additionalProperties: { type: 'string' },
+      },
+      metadata: {
+        type: 'object',
+        additionalProperties: { type: 'number' },
+      },
+    },
+    required: ['headers', 'metadata'],
+    additionalProperties: false,
+    $schema: 'http://json-schema.org/draft-07/schema#',
+  };
+
+  expect(convertJSONSchemaToOpenAPISchema(input)).toEqual({
+    type: 'object',
+    properties: {
+      headers: {
+        type: 'object',
+      },
+      metadata: {
+        type: 'object',
+      },
+    },
+    required: ['headers', 'metadata'],
+  });
+});
+
+it('should handle a record schema at the root without producing undefined', () => {
+  const input: JSONSchema7 = {
+    type: 'object',
+    additionalProperties: { type: 'string' },
+  };
+
+  expect(convertJSONSchemaToOpenAPISchema(input)).toEqual({
+    type: 'object',
+  });
+});
+
+it('should not drop nested empty object schemas', () => {
+  const input: JSONSchema7 = {
+    type: 'object',
+    properties: {
+      emptyObject: { type: 'object' },
+      arrayOfEmptyObjects: {
+        type: 'array',
+        items: { type: 'object' },
+      },
+    },
+    required: ['emptyObject'],
+  };
+
+  expect(convertJSONSchemaToOpenAPISchema(input)).toEqual({
+    type: 'object',
+    properties: {
+      emptyObject: { type: 'object' },
+      arrayOfEmptyObjects: {
+        type: 'array',
+        items: { type: 'object' },
+      },
+    },
+    required: ['emptyObject'],
+  });
+});
