@@ -553,3 +553,115 @@ it('should convert nullable string enum', () => {
     },
   });
 });
+
+it('should handle record (additionalProperties) schemas instead of returning undefined', () => {
+  // `z.record(z.string())`
+  const input: JSONSchema7 = {
+    type: 'object',
+    additionalProperties: { type: 'string' },
+  };
+
+  expect(convertJSONSchemaToOpenAPISchema(input)).toEqual({
+    type: 'object',
+    additionalProperties: { type: 'string' },
+  });
+});
+
+it('should handle nested record schemas', () => {
+  // `z.object({ metadata: z.record(z.string()) })`
+  const input: JSONSchema7 = {
+    type: 'object',
+    properties: {
+      metadata: {
+        type: 'object',
+        additionalProperties: { type: 'string' },
+      },
+    },
+    required: ['metadata'],
+    additionalProperties: false,
+    $schema: 'http://json-schema.org/draft-07/schema#',
+  };
+
+  const expected = {
+    type: 'object',
+    properties: {
+      metadata: {
+        type: 'object',
+        additionalProperties: { type: 'string' },
+      },
+    },
+    required: ['metadata'],
+  };
+
+  expect(convertJSONSchemaToOpenAPISchema(input)).toEqual(expected);
+});
+
+it('should handle records with nested object values and inside arrays', () => {
+  // `z.object({ settings: z.array(z.record(z.object({ value: z.string() }))) })`
+  const input: JSONSchema7 = {
+    type: 'object',
+    properties: {
+      settings: {
+        type: 'array',
+        items: {
+          type: 'object',
+          additionalProperties: {
+            type: 'object',
+            properties: { value: { type: 'string' } },
+            required: ['value'],
+            additionalProperties: false,
+          },
+        },
+      },
+    },
+  };
+
+  const expected = {
+    type: 'object',
+    properties: {
+      settings: {
+        type: 'array',
+        items: {
+          type: 'object',
+          additionalProperties: {
+            type: 'object',
+            properties: { value: { type: 'string' } },
+            required: ['value'],
+          },
+        },
+      },
+    },
+  };
+
+  const converted = convertJSONSchemaToOpenAPISchema(input);
+
+  expect(converted).toEqual(expected);
+  expect(JSON.stringify(converted)).not.toContain('undefined');
+});
+
+it('should not produce undefined values for nested empty object schemas', () => {
+  const input: JSONSchema7 = {
+    type: 'object',
+    properties: {
+      empty: { type: 'object', properties: {} },
+      list: {
+        type: 'array',
+        items: [{ type: 'string' }, { type: 'object' }],
+      },
+    },
+  };
+
+  const converted = convertJSONSchemaToOpenAPISchema(input);
+
+  expect(converted).toEqual({
+    type: 'object',
+    properties: {
+      empty: { type: 'object', properties: {} },
+      list: {
+        type: 'array',
+        items: [{ type: 'string' }, { type: 'object', properties: {} }],
+      },
+    },
+  });
+  expect(JSON.stringify(converted)).not.toContain('undefined');
+});
