+it('should keep additionalProperties schemas of nested records', () => {
+  const input: JSONSchema7 = {
+    type: 'object',
+    properties: {
+      metadata: {
+        type: 'object',
+        properties: {},
+        additionalProperties: { type: 'string' },
+      },
+    },
+    required: ['metadata'],
+  };
+
+  expect(convertJSONSchemaToOpenAPISchema(input)).toEqual({
+    type: 'object',
+    properties: {
+      metadata: {
+        type: 'object',
+        properties: {},
+        additionalProperties: { type: 'string' },
+      },
+    },
+    required: ['metadata'],
+  });
+});
+
+it('should keep records (additionalProperties) at the root', () => {
+  const input: JSONSchema7 = {
+    type: 'object',
+    additionalProperties: { type: 'number' },
+  };
+
+  expect(convertJSONSchemaToOpenAPISchema(input)).toEqual({
+    type: 'object',
+    additionalProperties: { type: 'number' },
+  });
+});
+
+it('should not produce undefined values for nested empty object schemas', () => {
+  const input: JSONSchema7 = {
+    type: 'object',
+    properties: {
+      emptyObject: {
+        type: 'object',
+        properties: {},
+      },
+      map: {
+        type: 'object',
+        additionalProperties: { type: 'string' },
+      },
+      name: { type: 'string' },
+    },
+  };
+
+  const converted = convertJSONSchemaToOpenAPISchema(input) as any;
+
+  expect(converted.properties.emptyObject).not.toBeUndefined();
+  expect(converted.properties.map).not.toBeUndefined();
+  expect(JSON.stringify(converted).includes('undefined')).toBe(false);
+  expect(converted).toMatchObject({
+    type: 'object',
+    properties: {
+      map: {
+        type: 'object',
+        additionalProperties: { type: 'string' },
+      },
+      name: { type: 'string' },
+    },
+  });
+});
