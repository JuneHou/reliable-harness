     from crewai.task import Task
 
 
+def is_telemetry_disabled() -> bool:
+    """Check whether telemetry has been explicitly disabled.
+
+    OpenTelemetry's `OTEL_SDK_DISABLED` environment variable is honored so users
+    can fully opt out of telemetry (no tracer provider, no span processor and
+    no export attempts that could hang or time out).
+
+    The value is read on every call (instead of only at construction time) so
+    that setting the variable at any point also stops telemetry from being
+    exported.
+    """
+    return os.getenv("OTEL_SDK_DISABLED", "false").strip().lower() == "true"
+
+
