+def is_telemetry_disabled() -> bool:
+    """Check whether the user explicitly disabled OpenTelemetry.
+
+    The check is evaluated on demand (and not only once, at import time) so
+    that `OTEL_SDK_DISABLED="true"` is honored even when the environment
+    variable is set after the telemetry module has already been imported
+    (e.g. when a `.env` file or `os.environ` is populated late).
+    """
+    value = os.getenv("OTEL_SDK_DISABLED", "false")
+    return str(value).strip().lower() in {"true", "1", "yes", "on"}
+
