+def is_telemetry_disabled() -> bool:
+    """Return True when telemetry must be fully disabled.
+
+    `OTEL_SDK_DISABLED="true"` is the standard way to turn OpenTelemetry off
+    for the whole process. When it is set, no tracer provider, span processor
+    or exporter may be created and no telemetry operation may run, so nothing
+    is ever exported (and therefore nothing can ever time out).
+    """
+    disabled = os.getenv("OTEL_SDK_DISABLED", "false")
+    return disabled.strip().lower() in ("true", "1", "yes", "on")
+
