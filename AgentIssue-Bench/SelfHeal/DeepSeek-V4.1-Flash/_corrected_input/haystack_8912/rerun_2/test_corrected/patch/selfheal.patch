+def _set_additional_properties_false(schema: Any) -> None:
+    """
+    Recursively set `additionalProperties` to `False` for every object defined in a JSON schema.
+
+    OpenAI strict mode requires `additionalProperties` to be explicitly set to `False` for the root object
+    **and** for every nested object contained in the tool's parameters schema. Schemas generated from Python
+    objects (for example the ones created by `ComponentTool` starting from Pydantic models) usually only define
+    `properties` for nested objects without setting `additionalProperties`, which makes OpenAI reject the whole
+    tool definition.
+
+    :param schema: The JSON schema (or sub-schema) to update in place.
+    """
+    if isinstance(schema, list):
+        for item in schema:
+            _set_additional_properties_false(item)
+        return
+
+    if not isinstance(schema, dict):
+        return
+
+    properties = schema.get("properties")
+    is_object = schema.get("type") == "object" or isinstance(properties, dict)
+
+    if is_object:
+        # OpenAI strict mode requires this to be explicitly set to False for every object
+        schema["additionalProperties"] = False
+        for property_schema in (properties or {}).values():
+            _set_additional_properties_false(property_schema)
+
+    # recurse into all the keywords that can contain sub-schemas
+    for key in ("items", "prefixItems", "anyOf", "oneOf", "allOf", "not"):
+        if key in schema:
+            _set_additional_properties_false(schema[key])
+
+    # nested definitions (Pydantic v1 uses `definitions`, Pydantic v2 uses `$defs`)
+    for key in ("definitions", "$defs"):
+        definitions = schema.get(key)
+        if isinstance(definitions, dict):
+            for definition_schema in definitions.values():
+                _set_additional_properties_false(definition_schema)
+
+
+def _convert_to_openai_tools(tools: List[Tool], tools_strict: bool = False) -> List[Dict[str, Any]]:
+    """
+    Converts a list of Haystack Tools to the tool definitions format expected by the OpenAI API.
+
+    When `tools_strict` is enabled, the JSON schema of each tool is adjusted so that it satisfies OpenAI's
+    strict mode requirements, that is `additionalProperties` is set to `False` for the root object and,
+    recursively, for every nested object of the parameters schema.
+
+    The tool specs of the passed Tools are never mutated: a deep copy is used to build the OpenAI definitions.
+
+    :param tools: The list of Haystack Tools to convert.
+    :param tools_strict: Whether to enable strict schema adherence for tool calls.
+    :returns: A list of tool definitions in the format expected by the OpenAI API.
+    """
+    tool_definitions: List[Dict[str, Any]] = []
+    for tool in tools:
+        # deep copy to avoid mutating the original tool spec (and therefore the Tool itself)
+        function_spec = copy.deepcopy(tool.tool_spec)
+
+        if tools_strict:
+            function_spec["strict"] = True
+            parameters = function_spec.get("parameters")
+            if isinstance(parameters, dict):
+                _set_additional_properties_false(parameters)
+
+        tool_definitions.append({"type": "function", "function": function_spec})
+
+    return tool_definitions
+
+
 @component
 class OpenAIChatGenerator:
     """
