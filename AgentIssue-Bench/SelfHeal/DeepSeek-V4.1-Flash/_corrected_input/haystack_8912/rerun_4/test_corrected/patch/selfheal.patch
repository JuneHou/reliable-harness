+    @staticmethod
+    def _prepare_tools_for_openai(tools: List[Tool], tools_strict: bool = False) -> List[Dict[str, Any]]:
+        """
+        Prepares tools for the OpenAI API.
+
+        :param tools: The tools to prepare.
+        :param tools_strict: Whether to enable strict schema adherence for tool calls.
+        :returns:
+            The tool definitions in the format expected by the OpenAI API.
+        """
+        tool_definitions: List[Dict[str, Any]] = []
+        for tool in tools:
+            # Deep copy the tool spec to avoid mutating the original tool specifications, which are shared
+            # between multiple calls (and potentially between multiple generators).
+            function_spec: Dict[str, Any] = deepcopy(tool.tool_spec)
+
+            if tools_strict:
+                function_spec["strict"] = True
+                # OpenAI strict mode requires `additionalProperties: False` on every object of the schema
+                # (nested objects included) and all properties to be listed in `required`.
+                parameters = function_spec.get("parameters")
+                if not isinstance(parameters, dict):
+                    parameters = {"type": "object", "properties": {}}
+                function_spec["parameters"] = _convert_to_recursive_strict(parameters)
+
+            tool_definitions.append({"type": "function", "function": function_spec})
+
+        return tool_definitions
+
