+def _convert_to_recursive_strict(schema: Dict[str, Any]) -> Dict[str, Any]:
+    """
+    Recursively make a JSON schema compatible with OpenAI's strict mode.
+
+    OpenAI's strict tool calling requires `additionalProperties` to be set to `False` for **every** object
+    in the schema (not only the root one) and that every property of an object is listed in `required`.
+    Nested objects, objects inside arrays (`items`), and subschemas such as those defined in `$defs`/
+    `definitions` or in `anyOf`/`oneOf`/`allOf` are all handled.
+
+    :param schema: The JSON schema to convert. It is modified in place.
+    :returns:
+        The same schema object, made strict.
+    """
+    if not isinstance(schema, dict):
+        return schema
+
+    is_object = schema.get("type") == "object" or "properties" in schema
+
+    if is_object:
+        schema["additionalProperties"] = False
+
+        properties = schema.get("properties")
+        if isinstance(properties, dict):
+            # OpenAI strict mode requires all properties to be listed as required
+            schema["required"] = list(properties.keys())
+            for property_schema in properties.values():
+                _convert_to_recursive_strict(property_schema)
+
+    # Schema of the elements of an array
+    items = schema.get("items")
+    if isinstance(items, dict):
+        _convert_to_recursive_strict(items)
+
+    # Subschemas that can contain nested objects: combinators and definitions
+    for key in ("anyOf", "oneOf", "allOf", "prefixItems", "definitions", "$defs"):
+        subschemas = schema.get(key)
+        if isinstance(subschemas, dict):
+            for subschema in subschemas.values():
+                _convert_to_recursive_strict(subschema)
+        elif isinstance(subschemas, list):
+            for subschema in subschemas:
+                _convert_to_recursive_strict(subschema)
+
+    # `additionalProperties` itself can be a schema
+    additional_properties = schema.get("additionalProperties")
+    if isinstance(additional_properties, dict):
+        _convert_to_recursive_strict(additional_properties)
+
+    return schema
+
