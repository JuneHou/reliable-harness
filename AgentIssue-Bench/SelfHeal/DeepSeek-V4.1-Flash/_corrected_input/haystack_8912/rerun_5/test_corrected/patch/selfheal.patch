+# JSON schema keywords whose value is a map of sub-schemas (i.e. `{"<name>": {<schema>}}`)
+_JSON_SCHEMA_MAP_KEYWORDS = ("properties", "patternProperties", "$defs", "definitions", "dependentSchemas")
+
+# JSON schema keywords whose value is a sub-schema (or a list of sub-schemas)
+_JSON_SCHEMA_SUB_SCHEMA_KEYWORDS = (
+    "items",
+    "additionalItems",
+    "additionalProperties",
+    "contains",
+    "not",
+    "if",
+    "then",
+    "else",
+    "propertyNames",
+    "unevaluatedItems",
+    "unevaluatedProperties",
+    "anyOf",
+    "oneOf",
+    "allOf",
+    "prefixItems",
+)
+
+
+def _set_additional_properties_false(schema: Any) -> None:
+    """
+    Recursively set `additionalProperties` to `False` for all the objects of a JSON schema.
+
+    OpenAI's strict mode requires `additionalProperties` to be explicitly set to `False` for every
+    object in the schema. `ComponentTool` (and Pydantic in general) generates schemas with nested
+    objects and definitions in `$defs` that don't have this keyword, so setting it only on the
+    top-level object makes the OpenAI API reject the tool with an error like:
+    "'additionalProperties' is required to be supplied and to be false".
+
+    The schema is modified in place, so callers should pass a copy if the original must be preserved.
+
+    :param schema: The JSON schema (or a portion of it) to update.
+    """
+    if isinstance(schema, list):
+        for item in schema:
+            _set_additional_properties_false(item)
+        return
+
+    if not isinstance(schema, dict):
+        return
+
+    # Recurse into the keywords that hold maps of sub-schemas (e.g. `properties` and `$defs`)
+    for map_keyword in _JSON_SCHEMA_MAP_KEYWORDS:
+        sub_schemas = schema.get(map_keyword)
+        if isinstance(sub_schemas, dict):
+            for sub_schema in sub_schemas.values():
+                _set_additional_properties_false(sub_schema)
+
+    # Recurse into the keywords that hold one or more sub-schemas directly (e.g. `items` and `anyOf`)
+    for sub_schema_keyword in _JSON_SCHEMA_SUB_SCHEMA_KEYWORDS:
+        sub_schema = schema.get(sub_schema_keyword)
+        if isinstance(sub_schema, (dict, list)):
+            _set_additional_properties_false(sub_schema)
+
+    if schema.get("type") == "object" or "properties" in schema:
+        # Schemas with a schema-based `additionalProperties` (e.g. `Dict[str, Any]`) describe objects
+        # with a dynamic set of keys: replacing them with `False` would change their meaning, so we
+        # keep them as they are (their nested schemas have already been fixed above).
+        if not isinstance(schema.get("additionalProperties"), dict):
+            schema["additionalProperties"] = False
+
+
+def _convert_tools_to_openai_format(tools: List[Tool], tools_strict: bool) -> List[Dict[str, Any]]:
+    """
+    Convert Haystack tools into OpenAI tool definitions.
+
+    The tool specs are deep-copied so that the tools used by this component are never modified.
+
+    When `tools_strict` is `True`, OpenAI's strict mode is enabled and `additionalProperties` is set
+    to `False` on every object of the tool parameters schema (nested objects and `$defs` included),
+    as required by the OpenAI API to accept strict tools.
+
+    :param tools: The Haystack tools to convert.
+    :param tools_strict: Whether to enable strict schema adherence for tool calls.
+    :returns: A list of OpenAI tool definitions.
+    """
+    tool_definitions: List[Dict[str, Any]] = []
+    for tool in tools:
+        function_spec = copy.deepcopy(tool.tool_spec)
+        if tools_strict:
+            function_spec["strict"] = True
+            # OpenAI strict mode requires all objects of the schema to disallow additional properties
+            parameters = function_spec.get("parameters")
+            if isinstance(parameters, dict):
+                _set_additional_properties_false(parameters)
+        tool_definitions.append({"type": "function", "function": function_spec})
+    return tool_definitions
+
+
 @component
 class OpenAIChatGenerator:
