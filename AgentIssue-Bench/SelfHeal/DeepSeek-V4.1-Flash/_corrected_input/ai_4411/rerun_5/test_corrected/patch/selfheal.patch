+
+/**
+ * Returns the JSON schema that is used to describe the given tool parameters.
+ *
+ * Descriptions that are defined on Zod wrapper schemas (e.g.
+ * `z.string().optional().describe('...')`) are lost when the Zod schema is
+ * converted into a JSON schema: the wrapper schema is reduced to its inner
+ * schema, and the description that is attached to the wrapper is not carried
+ * over. Since these descriptions are important hints for the language model,
+ * the missing descriptions are restored from the Zod schema.
+ */
+function getParametersJsonSchema(parameters: unknown): JSONSchema7 {
+  const jsonSchema = asSchema(parameters as any).jsonSchema;
+
+  const zodSchema = getZodSchema(parameters);
+
+  if (zodSchema == null) {
+    return jsonSchema;
+  }
+
+  // clone the schema so that the schema of the caller is never mutated:
+  const result = deepClone(jsonSchema);
+
+  applyZodDescriptions(zodSchema, result);
+
+  return result;
+}
+
+/**
+ * Returns the Zod schema when the tool parameters are (or wrap) a Zod schema.
+ */
+function getZodSchema(parameters: unknown): z.ZodTypeAny | undefined {
+  if (parameters instanceof z.ZodType) {
+    return parameters;
+  }
+
+  const wrappedSchema = (parameters as { schema?: unknown } | undefined)
+    ?.schema;
+
+  return wrappedSchema instanceof z.ZodType ? wrappedSchema : undefined;
+}
+
+/**
+ * Adds the descriptions that are defined in the Zod schema
+ * but are missing in the generated JSON schema.
+ */
+function applyZodDescriptions(
+  zodSchema: z.ZodTypeAny,
+  jsonSchema: JSONSchema7,
+): void {
+  if (jsonSchema == null || typeof jsonSchema !== 'object') {
+    return;
+  }
+
+  // restore the description of the current schema if it was lost:
+  addMissingDescription(zodSchema, jsonSchema);
+
+  // descend into the property schemas of objects:
+  if (zodSchema instanceof z.ZodObject) {
+    const properties = jsonSchema.properties;
+
+    if (properties == null) {
+      return;
+    }
+
+    const shape = (zodSchema as z.ZodObject<z.ZodRawShape>).shape;
+
+    for (const [key, propertyJsonSchema] of Object.entries(properties)) {
+      const propertyZodSchema = shape[key];
+
+      if (
+        propertyZodSchema == null ||
+        propertyJsonSchema == null ||
+        typeof propertyJsonSchema !== 'object'
+      ) {
+        continue;
+      }
+
+      applyZodDescriptions(
+        propertyZodSchema,
+        propertyJsonSchema as JSONSchema7,
+      );
+    }
+
+    return;
+  }
+
+  // descend into the item schemas of arrays:
+  if (zodSchema instanceof z.ZodArray) {
+    const items = jsonSchema.items;
+
+    if (items != null && !Array.isArray(items)) {
+      applyZodDescriptions(zodSchema.element, items as JSONSchema7);
+    }
+
+    return;
+  }
+
+  // descend into the value schemas of records:
+  if (zodSchema instanceof z.ZodRecord) {
+    const additionalProperties = jsonSchema.additionalProperties;
+
+    if (
+      additionalProperties != null &&
+      typeof additionalProperties === 'object'
+    ) {
+      applyZodDescriptions(
+        zodSchema.valueSchema,
+        additionalProperties as JSONSchema7,
+      );
+    }
+
+    return;
+  }
+
+  // unwrap wrapper schemas and continue with the inner schema:
+  const innerSchema = unwrapZodSchema(zodSchema);
+
+  if (innerSchema != null) {
+    applyZodDescriptions(innerSchema, jsonSchema);
+  }
+}
+
+/**
+ * Returns the inner schema of a Zod wrapper schema,
+ * or undefined when the schema is not a wrapper schema.
+ */
+function unwrapZodSchema(zodSchema: z.ZodTypeAny): z.ZodTypeAny | undefined {
+  if (zodSchema instanceof z.ZodOptional) {
+    return zodSchema.unwrap();
+  }
+
+  if (zodSchema instanceof z.ZodNullable) {
+    return zodSchema.unwrap();
+  }
+
+  const def = zodSchema._def as unknown as Record<string, any>;
+
+  switch (def.typeName) {
+    case 'ZodDefault':
+    case 'ZodCatch':
+    case 'ZodReadonly':
+      return def.innerType;
+    case 'ZodEffects':
+      return def.schema;
+    case 'ZodPipeline':
+      return def.in;
+    case 'ZodBranded':
+      return def.type;
+    case 'ZodLazy':
+      return def.getter();
+    default:
+      return undefined;
+  }
+}
+
+/**
+ * Returns the description of the Zod schema, unwrapping wrapper schemas
+ * until a description is found.
+ */
+function getZodDescription(zodSchema: z.ZodTypeAny): string | undefined {
+  let current: z.ZodTypeAny | undefined = zodSchema;
+
+  for (let depth = 0; current != null && depth < 20; depth++) {
+    if (current.description != null) {
+      return current.description;
+    }
+
+    const def = current._def as unknown as Record<string, any>;
+
+    if (def.description != null) {
+      return def.description as string;
+    }
+
+    current = unwrapZodSchema(current);
+  }
+
+  return undefined;
+}
+
+function addMissingDescription(
+  zodSchema: z.ZodTypeAny,
+  jsonSchema: JSONSchema7,
+): void {
+  if (jsonSchema.description != null) {
+    return;
+  }
+
+  const description = getZodDescription(zodSchema);
+
+  if (description != null) {
+    jsonSchema.description = description;
+  }
+}
+
+function deepClone<T>(value: T): T {
+  if (Array.isArray(value)) {
+    return value.map(item => deepClone(item)) as unknown as T;
+  }
+
+  if (value != null && typeof value === 'object') {
+    const result: Record<string, unknown> = {};
+
+    for (const [key, item] of Object.entries(value as Record<string, unknown>)) {
+      result[key] = deepClone(item);
+    }
+
+    return result as T;
+  }
+
+  return value;
+}
