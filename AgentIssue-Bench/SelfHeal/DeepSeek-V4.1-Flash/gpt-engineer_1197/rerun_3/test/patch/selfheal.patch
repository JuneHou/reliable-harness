     # validate and correct diffs
 
-    for _, diff in diffs.items():
+    applicable_diffs = {}
+    for diff_key, diff in diffs.items():
         # if diff is a new file, validation and correction is unnecessary
-        if not diff.is_new_file():
-            problems = diff.validate_and_correct(
-                file_to_lines_dict(files_dict[diff.filename_pre])
+        if diff.is_new_file():
+            applicable_diffs[diff_key] = diff
+            continue
+
+        # A diff can only be applied to a file that is part of the codebase.
+        # Diffs referring to unknown files (for example when the AI tries to
+        # create a new configuration file or script without using the
+        # "--- /dev/null" notation) must not abort the whole improvement with a
+        # KeyError: instead they are reported back to the AI so it can rewrite
+        # them as proper file creations.
+        if diff.filename_pre not in files_dict:
+            error_messages.append(
+                f"The diff for {diff.filename_post} refers to the file "
+                f"{diff.filename_pre} which does not exist in the code. If "
+                f"{diff.filename_post} is a new file, rewrite the diff so that it "
+                "starts with '--- /dev/null' followed by '+++ <filename>' and only "
+                "contains added lines ('+')."
             )
-            error_messages.extend(problems)
-    files_dict = apply_diffs(diffs, files_dict)
+            continue
+
+        problems = diff.validate_and_correct(
+            file_to_lines_dict(files_dict[diff.filename_pre])
+        )
+        error_messages.extend(problems)
+        applicable_diffs[diff_key] = diff
+
+    files_dict = apply_diffs(applicable_diffs, files_dict)
     memory.log(IMPROVE_LOG_FILE, "\n\n".join(x.pretty_repr() for x in messages))
     memory.log(DIFF_LOG_FILE, "\n\n".join(error_messages))
     return files_dict, error_messages
