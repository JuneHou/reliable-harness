+        # The improvement can add, rename or delete files (e.g. additional
+        # configuration files such as `application-local.yml` and
+        # `application-stage.yml`, or additional scripts such as
+        # `run-local.sh` and `run-stage.sh`). The entrypoint therefore has to be
+        # regenerated from the *improved* codebase, otherwise `run.sh` keeps
+        # describing the project as it was before the improvement and the
+        # requested changes never take effect when the code is executed.
+        entrypoint = gen_entrypoint(
+            self.ai, prompt, files_dict, self.memory, self.preprompts_holder
+        )
+        combined_dict = {**files_dict, **entrypoint}
+        files_dict = FilesDict(combined_dict)
+        # Process (upload and, if the user agrees, execute) the improved
+        # codebase so the regenerated entrypoint actually runs.
+        files_dict = self.process_code_fn(
+            self.ai,
+            self.execution_env,
+            files_dict,
+            preprompts_holder=self.preprompts_holder,
+            prompt=prompt,
+            memory=self.memory,
+        )
 
         return files_dict
diff --git a/gpt_engineer/core/default/steps.py b/gpt_engineer/core/default/steps.py
index d778948..ed37961 100644
--- a/gpt_engineer/core/default/steps.py
+++ b/gpt_engineer/core/default/steps.py
@@ -347,6 +347,18 @@ def salvage_correct_hunks(
     for _, diff in diffs.items():
         # if diff is a new file, validation and correction is unnecessary
         if not diff.is_new_file():
+            # A diff can only be applied to a file that is part of the codebase.
+            # Instead of raising a KeyError (which would abort the whole
+            # improvement, e.g. when the model edits a file it just introduced),
+            # report the problem so the model can fix its answer.
+            if diff.filename_pre not in files_dict:
+                error_messages.append(
+                    "The code does not contain the file "
+                    + diff.filename_pre
+                    + ", so the diff could not be applied. If the file should be created, "
+                    + "write it as a new file; otherwise only edit files that exist in the code."
+                )
+                continue
             problems = diff.validate_and_correct(
                 file_to_lines_dict(files_dict[diff.filename_pre])
             )
