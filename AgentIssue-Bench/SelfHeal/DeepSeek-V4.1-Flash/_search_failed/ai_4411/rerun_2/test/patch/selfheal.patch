+/**
+ * Checks whether the given value is a JSON schema object.
+ */
+function isJsonSchemaObject(value: unknown): value is JSONSchema7 {
+  return value != null && typeof value === 'object' && !Array.isArray(value);
+}
+
+/**
+ * Returns the description of the first `anyOf` / `oneOf` branch that has a
+ * description.
+ */
+function getUnionDescription(schema: JSONSchema7): string | undefined {
+  const unionSchemas: Array<JSONSchema7Definition> = [
+    ...(Array.isArray(schema.anyOf) ? schema.anyOf : []),
+    ...(Array.isArray(schema.oneOf) ? schema.oneOf : []),
+  ];
+
+  for (const unionSchema of unionSchemas) {
+    if (isJsonSchemaObject(unionSchema) && unionSchema.description != null) {
+      return unionSchema.description;
+    }
+  }
+
+  return undefined;
+}
+
+/**
+ * Preserves the descriptions of nested schemas in a union.
+ */
+function preservePropertyDescriptionsInArray(
+  schemas: Array<JSONSchema7Definition>,
+): Array<JSONSchema7Definition> {
+  return schemas.map(schema =>
+    isJsonSchemaObject(schema) ? preservePropertyDescriptions(schema) : schema,
+  );
+}
+
+/**
+ * Optional (and nullable) fields are converted into `anyOf` / `oneOf` unions
+ * by the JSON schema generator. The description of such a field is then stored
+ * inside the union branches and is no longer visible to language models, which
+ * only read the description of the property schema.
+ *
+ * This function hoists the descriptions of union branches to the schema that
+ * contains the union, so that the descriptions of optional fields are
+ * preserved in the generated tool parameter schemas.
+ */
+function preservePropertyDescriptions(schema: JSONSchema7): JSONSchema7 {
+  const result: JSONSchema7 = { ...schema };
+
+  if (result.description == null) {
+    const description = getUnionDescription(result);
+
+    if (description != null) {
+      result.description = description;
+    }
+  }
+
+  // recurse into unions:
+  if (result.anyOf != null) {
+    result.anyOf = preservePropertyDescriptionsInArray(result.anyOf);
+  }
+
+  if (result.oneOf != null) {
+    result.oneOf = preservePropertyDescriptionsInArray(result.oneOf);
+  }
+
+  if (result.allOf != null) {
+    result.allOf = preservePropertyDescriptionsInArray(result.allOf);
+  }
+
+  // recurse into array item schemas:
+  if (Array.isArray(result.items)) {
+    result.items = preservePropertyDescriptionsInArray(result.items);
+  } else if (isJsonSchemaObject(result.items)) {
+    result.items = preservePropertyDescriptions(result.items);
+  }
+
+  // recurse into object property schemas:
+  if (isJsonSchemaObject(result.properties)) {
+    const properties: Record<string, JSONSchema7Definition> = {};
+
+    for (const [propertyName, propertySchema] of Object.entries(
+      result.properties,
+    )) {
+      properties[propertyName] = isJsonSchemaObject(propertySchema)
+        ? preservePropertyDescriptions(propertySchema)
+        : propertySchema;
+    }
+
+    result.properties = properties;
+  }
+
+  // recurse into additional property schemas:
+  if (isJsonSchemaObject(result.additionalProperties)) {
+    result.additionalProperties = preservePropertyDescriptions(
+      result.additionalProperties,
+    );
+  }
+
+  // recurse into negated schemas:
+  if (isJsonSchemaObject(result.not)) {
+    result.not = preservePropertyDescriptions(result.not);
+  }
+
+  return result;
+}
