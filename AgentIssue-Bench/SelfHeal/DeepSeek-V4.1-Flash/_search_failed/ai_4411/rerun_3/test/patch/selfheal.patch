+/**
+Copies the `description` values of a zod schema to the JSON schema that was
+generated from it.
+
+zod schemas that wrap another schema (e.g. `z.string().optional().describe(..)`,
+`z.string().nullable().describe(..)`, or `z.string().default(..).describe(..)`)
+store the description on the wrapper. The zod -> JSON schema conversion unwraps
+these schemas and only uses the inner schema, which drops the description of the
+wrapper. Without this step, such descriptions would be lost for the language
+model.
+ */
+function copyZodDescriptionsToJsonSchema({
+  zodSchema,
+  jsonSchema,
+}: {
+  zodSchema: unknown;
+  jsonSchema: unknown;
+}): void {
+  const zodDef = getZodDef(zodSchema);
+
+  if (zodDef == null || !isJsonSchemaObject(jsonSchema)) {
+    return;
+  }
+
+  const schema = jsonSchema as Record<string, unknown>;
+
+  if (zodDef.description != null && schema.description == null) {
+    schema.description = zodDef.description;
+  }
+
+  switch (zodDef.typeName) {
+    // wrappers that keep the description of the wrapped schema:
+    case 'ZodOptional':
+    case 'ZodNullable':
+    case 'ZodDefault':
+    case 'ZodCatch':
+    case 'ZodReadonly':
+    case 'ZodBranded':
+    case 'ZodEffects':
+      copyZodDescriptionsToJsonSchema({
+        zodSchema: getWrappedZodSchema(zodDef),
+        jsonSchema,
+      });
+      break;
+
+    case 'ZodObject': {
+      const shape =
+        typeof zodDef.shape === 'function'
+          ? (zodDef.shape as () => unknown)()
+          : zodDef.shape;
+
+      const properties = schema.properties;
+
+      if (
+        shape == null ||
+        typeof shape !== 'object' ||
+        properties == null ||
+        typeof properties !== 'object' ||
+        Array.isArray(properties)
+      ) {
+        break;
+      }
+
+      for (const [key, value] of Object.entries(
+        shape as Record<string, unknown>,
+      )) {
+        copyZodDescriptionsToJsonSchema({
+          zodSchema: value,
+          jsonSchema: (properties as Record<string, unknown>)[key],
+        });
+      }
+      break;
+    }
+
+    case 'ZodArray':
+      copyZodDescriptionsToJsonSchema({
+        zodSchema: zodDef.type,
+        jsonSchema: schema.items,
+      });
+      break;
+
+    case 'ZodRecord':
+      copyZodDescriptionsToJsonSchema({
+        zodSchema: zodDef.valueType,
+        jsonSchema: schema.additionalProperties,
+      });
+      break;
+
+    case 'ZodUnion':
+    case 'ZodDiscriminatedUnion': {
+      const zodOptions = zodDef.options;
+
+      const options: unknown[] =
+        zodOptions instanceof Map
+          ? Array.from(zodOptions.values())
+          : Array.isArray(zodOptions)
+          ? zodOptions
+          : [];
+
+      const jsonSchemaOptions = schema.anyOf;
+
+      if (!Array.isArray(jsonSchemaOptions)) {
+        break;
+      }
+
+      for (let i = 0; i < options.length; i++) {
+        copyZodDescriptionsToJsonSchema({
+          zodSchema: options[i],
+          jsonSchema: jsonSchemaOptions[i],
+        });
+      }
+      break;
+    }
+
+    default:
+      break;
+  }
+}
+
+interface ZodDefLike {
+  typeName?: string;
+  description?: string;
+  innerType?: unknown;
+  schema?: unknown;
+  type?: unknown;
+  shape?: unknown;
+  valueType?: unknown;
+  options?: unknown;
+  [key: string]: unknown;
+}
+
+function getZodDef(zodSchema: unknown): ZodDefLike | undefined {
+  if (zodSchema == null || typeof zodSchema !== 'object') {
+    return undefined;
+  }
+
+  const def = (zodSchema as { _def?: unknown })._def;
+
+  return def != null && typeof def === 'object' ? (def as ZodDefLike) : undefined;
+}
+
+function getWrappedZodSchema(zodDef: ZodDefLike): unknown {
+  return zodDef.innerType ?? zodDef.schema ?? zodDef.type;
+}
+
+function isJsonSchemaObject(value: unknown): boolean {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
