+  let current: any = zodSchema;
+
+  while (current?._def != null) {
+    switch (current._def.typeName) {
+      case 'ZodOptional':
+      case 'ZodNullable':
+      case 'ZodReadonly':
+      case 'ZodDefault':
+      case 'ZodCatch':
+        current = current._def.innerType;
+        break;
+      case 'ZodBranded':
+        current = current._def.type;
+        break;
+      case 'ZodEffects':
+        current = current._def.schema;
+        break;
+      default:
+        return current;
+    }
+  }
