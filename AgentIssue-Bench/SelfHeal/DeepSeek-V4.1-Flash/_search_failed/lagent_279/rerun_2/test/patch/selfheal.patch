+        def need_retry(result) -> bool:
+            """Whether the execution result indicates the kernel misbehaved.
+
+            The kernel is considered unresponsive when it returned nothing but
+            a ``KeyboardInterrupt`` traceback or when it failed to become ready
+            in time.
+            """
+            if not isinstance(result, tuple) or not result:
+                return False
+            return result[-1].strip() in [
+                'KeyboardInterrupt',
+                f"Kernel didn't respond in {wait_for_ready_timeout} seconds",
+            ]
+
+        async def run_with_retry():
+            """Run the code, retrying a bounded number of times.
+
+            This is a dependency free implementation of the retry logic that
+            previously relied on ``tenacity``, so that importing ``lagent``
+            does not require ``tenacity`` to be installed.
+            """
+            result = await run()
+            attempt = 1
+            while need_retry(result) and attempt < max_attempts:
+                attempt += 1
+                logger.info(
+                    f'Retrying kernel execution (attempt {attempt}/{max_attempts})'
+                )
+                if retry_interval:
+                    await asyncio.sleep(retry_interval)
+                result = await run()
+            return result
