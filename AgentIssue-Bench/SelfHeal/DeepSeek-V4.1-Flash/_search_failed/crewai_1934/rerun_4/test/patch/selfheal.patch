+def test_crew_kickoff_raises_llm_errors_instead_of_hanging():
+    """LLM errors (e.g. authentication failures) must surface instead of looping forever.
+
+    `_invoke_loop` only advances `iterations` after a successful LLM response, so
+    swallowing unexpected exceptions (like an authentication error) made `kickoff`
+    spin indefinitely instead of raising.
+    """
+    agent = Agent(
+        role="Researcher",
+        goal="Make the best research and analysis on content about AI and AI agents",
+        backstory="You're an expert researcher specialized in AI and startups.",
+        allow_delegation=False,
+    )
+
+    task = Task(
+        description="Say hi",
+        expected_output="Hi",
+        agent=agent,
+    )
+
+    crew = Crew(agents=[agent], tasks=[task])
+
+    llm_error = Exception("AuthenticationError: Incorrect API key provided")
+
+    with patch.object(
+        CrewAgentExecutor, "_get_llm_response", side_effect=llm_error
+    ) as mock_get_llm_response:
+        with pytest.raises(Exception, match="AuthenticationError"):
+            crew.kickoff()
+
+    # The failure must not be retried endlessly, the first call is enough
+    assert mock_get_llm_response.call_count == 1
+
+
+def test_agent_executor_reraises_non_context_window_errors():
+    """Unexpected exceptions raised by tool/parsing code must not be swallowed."""
+    agent = Agent(
+        role="Researcher",
+        goal="Research things",
+        backstory="An expert researcher.",
+        allow_delegation=False,
+    )
+
+    task = Task(
+        description="Do something",
+        expected_output="Something",
+        agent=agent,
+    )
+
+    crew = Crew(agents=[agent], tasks=[task])
+
+    with patch.object(
+        CrewAgentExecutor,
+        "_process_llm_response",
+        side_effect=RuntimeError("boom"),
+    ):
+        with pytest.raises(RuntimeError, match="boom"):
+            crew.kickoff()
