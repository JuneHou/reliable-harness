+def test_agent_executor_raises_on_llm_authentication_error_instead_of_hanging():
+    """Regression test for LLM errors (e.g. authentication failures) being swallowed.
+
+    Previously the agent executor loop caught every exception, and since a failed
+    LLM call happened *before* the iteration counter was incremented, the loop kept
+    retrying the exact same failing call forever. That made `crew.kickoff()` hang
+    instead of failing gracefully with the underlying error.
+    """
+    from crewai.agents.crew_agent_executor import CrewAgentExecutor
+    from crewai.agents.tools_handler import ToolsHandler
+
+    llm = MagicMock()
+    llm.stop = []
+    llm.call.side_effect = Exception(
+        "Error code: 401 - Incorrect API key provided: sk-invalid"
+    )
+
+    executor_agent = Agent(
+        role="Researcher",
+        goal="Say hi",
+        backstory="You say hi to everyone.",
+        allow_delegation=False,
+    )
+
+    task = Task(
+        description="Say hi",
+        expected_output="hi",
+        agent=executor_agent,
+    )
+
+    executor = CrewAgentExecutor(
+        llm=llm,
+        task=task,
+        crew=None,
+        agent=executor_agent,
+        prompt={"prompt": "Say hi"},
+        max_iter=3,
+        tools=[],
+        tools_names="",
+        stop_words=[],
+        tools_description="",
+        tools_handler=ToolsHandler(),
+        callbacks=[],
+    )
+
+    with pytest.raises(Exception, match="Incorrect API key provided"):
+        executor.invoke({"input": "hi", "tool_names": "", "tools": ""})
+
+    # The failing LLM call must not be retried forever, it must fail fast
+    assert llm.call.call_count == 1
