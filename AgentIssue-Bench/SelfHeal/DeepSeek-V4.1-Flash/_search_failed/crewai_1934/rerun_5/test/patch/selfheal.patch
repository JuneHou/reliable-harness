@@ -146,6 +146,16 @@ class CrewAgentExecutor(CrewAgentExecutorMixin):
                     self._handle_context_length()
                     continue
 
+                # Any other failure (e.g. authentication/API errors, rate limiting,
+                # invalid responses) must not be silently swallowed, otherwise the
+                # loop keeps retrying the very same failing call forever and
+                # `Crew.kickoff()` hangs instead of failing gracefully.
+                self._printer.print(
+                    content=f"An error occurred while running the agent: {e}",
+                    color="red",
+                )
+                raise e
+
         self._show_logs(formatted_answer)
         return formatted_answer
 
