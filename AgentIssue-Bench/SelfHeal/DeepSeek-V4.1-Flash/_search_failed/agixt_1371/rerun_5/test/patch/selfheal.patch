+    def get_chain_step_argument_values(self, session, step_id):
+        """Return a dict of ``{argument_name: value}`` for a single chain step.
+
+        Only the two columns that are actually needed are selected, so every
+        returned row is guaranteed to hold exactly two values. Querying whole
+        entities (``session.query(Argument, ChainStepArgument)``) and unpacking
+        the rows with ``for argument, chain_step_argument in arguments`` raises
+        ``ValueError: too many values to unpack (expected 2)`` as soon as a row
+        contains anything other than the two expected items, which is what made
+        the ``chain`` GraphQL query fail.
+        """
+        if step_id is None:
+            return {}
+        arguments = (
+            session.query(Argument.name, ChainStepArgument.value)
+            .join(ChainStepArgument, ChainStepArgument.argument_id == Argument.id)
+            .filter(ChainStepArgument.chain_step_id == step_id)
+            .all()
+        )
+        prompt_args = {}
+        for row in arguments:
+            # Be tolerant about the row shape instead of assuming exactly two
+            # values: indexes 0 and 1 are the argument name and value.
+            try:
+                row_values = tuple(row)
+            except TypeError:
+                continue
+            if len(row_values) < 2:
+                continue
+            argument_name, argument_value = row_values[0], row_values[1]
+            # Support both plain values and rows made of ORM objects.
+            argument_name = getattr(argument_name, "name", argument_name)
+            argument_value = getattr(argument_value, "value", argument_value)
+            if argument_name is None:
+                continue
+            prompt_args[argument_name] = argument_value
+        return prompt_args
+
