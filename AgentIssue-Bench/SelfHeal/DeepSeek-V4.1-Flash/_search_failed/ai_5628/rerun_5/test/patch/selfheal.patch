 });
+
+it('should keep nested empty object schemas', () => {
+  const input: JSONSchema7 = {
+    type: 'object',
+    properties: {
+      nested: {
+        type: 'object',
+        properties: {},
+      },
+      plainNested: {
+        type: 'object',
+      },
+    },
+  };
+
+  expect(convertJSONSchemaToOpenAPISchema(input)).toEqual({
+    type: 'object',
+    properties: {
+      nested: {
+        type: 'object',
+        properties: {},
+      },
+      plainNested: {
+        type: 'object',
+      },
+    },
+  });
+});
+
+it('should handle record schemas (e.g. z.record(z.string())) without producing undefined', () => {
+  const input: JSONSchema7 = {
+    type: 'object',
+    properties: {
+      record: {
+        type: 'object',
+        additionalProperties: { type: 'string' },
+      },
+      records: {
+        type: 'array',
+        items: {
+          type: 'object',
+          additionalProperties: { type: 'number' },
+        },
+      },
+      nullableRecord: {
+        anyOf: [
+          {
+            type: 'object',
+            additionalProperties: { type: 'string' },
+          },
+          { type: 'null' },
+        ],
+      },
+    },
+    required: ['record', 'records', 'nullableRecord'],
+    additionalProperties: false,
+  };
+
+  const result = convertJSONSchemaToOpenAPISchema(input) as Record<
+    string,
+    unknown
+  >;
+
+  expect(result).toEqual({
+    type: 'object',
+    properties: {
+      record: {
+        type: 'object',
+      },
+      records: {
+        type: 'array',
+        items: {
+          type: 'object',
+        },
+      },
+      nullableRecord: {
+        type: 'object',
+        nullable: true,
+      },
+    },
+    required: ['record', 'records', 'nullableRecord'],
+  });
+
+  // the generated schema must not contain `undefined` anywhere,
+  // otherwise Vertex AI rejects the request
+  expect(JSON.stringify(result)).toBe(JSON.stringify(result));
+  expect(containsUndefined(result)).toBe(false);
+});
+
+function containsUndefined(value: unknown): boolean {
+  if (value === undefined) {
+    return true;
+  }
+
+  if (Array.isArray(value)) {
+    return value.some(containsUndefined);
+  }
+
+  if (typeof value === 'object' && value != null) {
+    return Object.values(value).some(containsUndefined);
+  }
+
+  return false;
+}
