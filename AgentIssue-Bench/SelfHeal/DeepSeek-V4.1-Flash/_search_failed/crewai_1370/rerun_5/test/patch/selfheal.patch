+
+# Public name -> module defining it. All of these modules pull in heavy
+# third-party dependencies (litellm, instructor, embedchain/chromadb, pyvis,
+# ...), so they are imported lazily on first attribute access instead of
+# eagerly at package import time. That keeps `import crewai` fast.
+_LAZY_MODULE_IMPORTS: Dict[str, str] = {
+    "Agent": "crewai.agent",
+    "Crew": "crewai.crew",
+    "Flow": "crewai.flow.flow",
+    "LLM": "crewai.llm",
+    "Pipeline": "crewai.pipeline",
+    "Process": "crewai.process",
+    "Router": "crewai.routers",
+    "Task": "crewai.task",
+}
+
+
+def __getattr__(name: str) -> Any:
+    """Lazily import and expose the public crewai symbols (PEP 562)."""
+    module_path = _LAZY_MODULE_IMPORTS.get(name)
+    if module_path is None:
+        raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
+
+    value = getattr(import_module(module_path), name)
+    # Cache the resolved object so subsequent accesses are cheap.
+    globals()[name] = value
+    return value
+
+
+def __dir__() -> list:
+    return sorted(set(list(globals().keys()) + list(__all__)))
