+def to_int(value, default: int = 0) -> int:
+    """Safely normalize a value coming from user/API input to an int."""
+    if isinstance(value, bool):
+        return int(value)
+    try:
+        return int(value)
+    except (TypeError, ValueError):
+        try:
+            return int(float(str(value).strip()))
+        except (TypeError, ValueError):
+            return default
+
+
+def to_bool(value) -> bool:
+    """Safely normalize a value coming from user/API input to a bool."""
+    if isinstance(value, bool):
+        return value
+    if value is None:
+        return False
+    return str(value).strip().lower() in ("true", "1", "yes", "y", "on")
+
