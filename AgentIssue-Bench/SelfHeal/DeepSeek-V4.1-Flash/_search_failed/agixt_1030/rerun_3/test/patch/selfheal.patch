+def safe_int(value, default: int = 0) -> int:
+    """Convert a value that may come as a string (prompt args / API payloads)
+    into an integer without raising when it is not numeric."""
+    if value is None:
+        return default
+    if isinstance(value, bool):
+        return int(value)
+    if isinstance(value, int):
+        return value
+    try:
+        return int(str(value).strip())
+    except (TypeError, ValueError):
+        try:
+            return int(float(str(value).strip()))
+        except (TypeError, ValueError):
+            return default
+
+
+def safe_bool(value, default: bool = False) -> bool:
+    """Convert a value that may come as a boolean or a string into a boolean."""
+    if value is None:
+        return default
+    if isinstance(value, bool):
+        return value
+    return str(value).strip().lower() in ("true", "1", "yes", "on")
+
+
+def add_to_context(context: list, addition) -> list:
+    """Safely add memories / text to the context list.
+
+    Memories can be returned as a list of strings or as a single string, and
+    both must be merged into one flat list of strings.
+    """
+    if context is None:
+        context = []
+    if addition is None or addition == "":
+        return context
+    if isinstance(addition, (list, tuple, set)):
+        context += [str(item) for item in addition if item]
+    else:
+        context.append(str(addition))
+    return context
+
+
