+# Lazy imports keep this package importable even when optional dependencies of the
+# component factory (autogen-ext extras such as the OpenAI client, which needs
+# ``tiktoken``) are not installed. Names are resolved on first access (PEP 562).
+from typing import TYPE_CHECKING, Any
+
+if TYPE_CHECKING:
+    from .component_factory import Component, ComponentFactory
+    from .config_manager import ConfigurationManager
+    from .db_manager import DatabaseManager
+
+__all__ = ["Component", "ComponentFactory", "ConfigurationManager", "DatabaseManager"]
+
+
+def __getattr__(name: str) -> Any:
+    if name in globals():
+        return globals()[name]
+
+    if name in ("Component", "ComponentFactory"):
+        from .component_factory import Component, ComponentFactory
+
+        value: Any = Component if name == "Component" else ComponentFactory
+    elif name == "ConfigurationManager":
+        from .config_manager import ConfigurationManager
+
+        value = ConfigurationManager
+    elif name == "DatabaseManager":
+        from .db_manager import DatabaseManager
+
+        value = DatabaseManager
+    else:
+        raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
+
+    globals()[name] = value
+    return value
