+# Lazy imports are used here on purpose: ``import autogenstudio`` must stay cheap and
+# must not require every optional runtime dependency (e.g. ``tiktoken`` via
+# ``autogen_ext.models``) just to start the studio. Optional/heavy dependencies are
+# only imported when the corresponding attribute is actually accessed.
+from typing import TYPE_CHECKING, Any
+
 from .version import __version__
 
+if TYPE_CHECKING:
+    from .database.db_manager import DatabaseManager
+    from .datamodel import Agent, AgentConfig, Model, ModelConfig, Team, TeamConfig, Tool, ToolConfig
+    from .teammanager import TeamManager
+
 __all__ = [
     "Tool",
     "Model",
@@ -16,3 +24,38 @@ __all__ = [
     "TeamManager",
     "__version__",
 ]
+
+_DATAMODEL_NAMES = {
+    "Tool",
+    "Model",
+    "Team",
+    "Agent",
+    "ToolConfig",
+    "ModelConfig",
+    "TeamConfig",
+    "AgentConfig",
+}
+
+
+def __getattr__(name: str) -> Any:
+    """Resolve the public API lazily (PEP 562)."""
+    if name in globals():
+        return globals()[name]
+
+    if name == "DatabaseManager":
+        from .database.db_manager import DatabaseManager
+
+        value: Any = DatabaseManager
+    elif name == "TeamManager":
+        from .teammanager import TeamManager
+
+        value = TeamManager
+    elif name in _DATAMODEL_NAMES:
+        from . import datamodel
+
+        value = getattr(datamodel, name)
+    else:
+        raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
+
+    globals()[name] = value
+    return value
