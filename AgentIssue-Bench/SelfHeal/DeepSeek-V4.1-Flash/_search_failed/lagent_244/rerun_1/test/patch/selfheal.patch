+    def _prepare_special_tokens(self,
+                                generation_config,
+                                device: Optional[str] = None):
+        """Prepare the special token tensors of ``generation_config``.
+
+        ``GenerationMixin.generate`` prepares the private attributes
+        (``_eos_token_tensor``, ``_bos_token_tensor``, ``_pad_token_tensor``,
+        ...) of the generation config with
+        ``GenerationConfig._prepare_special_tokens`` before it relies on the
+        private generation utils such as ``_get_logits_processor``. Because
+        this class implements its own generation loop and never calls
+        ``generate``, those attributes are missing and recent versions of
+        ``transformers`` raise
+        ``AttributeError: 'GenerationConfig' object has no attribute
+        '_eos_token_tensor'``. Prepare them explicitly here, tolerating the
+        different signatures across ``transformers`` versions.
+        """
+        prepared = False
+        # transformers >= 4.45: GenerationMixin._prepare_special_tokens
+        model_prepare = getattr(self.model, '_prepare_special_tokens', None)
+        if callable(model_prepare):
+            for call_kwargs in (dict(device=device), dict()):
+                try:
+                    model_prepare(generation_config, **call_kwargs)
+                    prepared = True
+                    break
+                except TypeError:
+                    # signature mismatch between transformers versions
+                    continue
+                except Exception:
+                    logger.warning(
+                        'Failed to prepare the special tokens of the '
+                        'generation config.',
+                        exc_info=True)
+                    break
+        # transformers 4.44: GenerationConfig._prepare_special_tokens
+        if not prepared:
+            config_prepare = getattr(generation_config,
+                                     '_prepare_special_tokens', None)
+            if callable(config_prepare):
+                for call_kwargs in (dict(device=device), dict()):
+                    try:
+                        config_prepare(**call_kwargs)
+                        prepared = True
+                        break
+                    except TypeError:
+                        continue
+                    except Exception:
+                        prepared = False
+                        break
+        if prepared:
+            return generation_config
+
+        # Fallback: replicate the attributes that the generation utils use.
+        import torch
+
+        def to_tensor(token_ids):
+            if token_ids is None:
+                return None
+            if isinstance(token_ids, int):
+                token_ids = [token_ids]
+            return torch.tensor(
+                list(token_ids),
+                dtype=torch.long,
+                device=device if device is not None else 'cpu')
+
+        generation_config._eos_token_tensor = to_tensor(
+            generation_config.eos_token_id)
+        generation_config._bos_token_tensor = to_tensor(
+            generation_config.bos_token_id)
+        generation_config._pad_token_tensor = to_tensor(
+            generation_config.pad_token_id)
+        return generation_config
+
