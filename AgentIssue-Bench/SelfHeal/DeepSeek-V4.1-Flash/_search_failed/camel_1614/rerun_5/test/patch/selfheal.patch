+def test_remove_think_content():
+    # Text without any thinking block is returned unchanged.
+    assert remove_think_content("") == ""
+    assert remove_think_content("plain text") == "plain text"
+
+    # A complete thinking block is removed together with its tags.
+    assert remove_think_content(" hello") == "hello"
+    assert remove_think_content("first  second") == "first"
+
+    # Multiple thinking blocks.
+    assert remove_think_content(" a  b answer") == "answer"
+
+    # Nested/other tags used by reasoning models.
+    assert remove_think_content(" step 1prompt") == "prompt"
+
+    # Only the closing tag is kept by some platforms.
+    assert remove_think_content("reasoning...</think>The answer") == "The answer"
+
