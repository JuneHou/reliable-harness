     return final_prompt
+
+
+# Tags that reasoning models (e.g. DeepSeek R1) use to wrap their thinking
+# process. The content wrapped by these tags should never be sent back to the
+# models as a part of the chat history.
+THINK_TAGS: List[str] = ["think", "thinking", "redacted_thinking"]
+
+
+def remove_think_content(text: str) -> str:
+    r"""Remove the thinking (reasoning) content from the given text.
+
+    Some models, such as DeepSeek R1, wrap their reasoning process inside
+    special tags, e.g. ```` ... ```` or
+    ```` ... ````. Such content is useless (and sometimes
+    harmful) when it is sent back to the model as a part of the request, and
+    it should not be regarded as the answer of the model either. This function
+    removes the thinking blocks together with their tags.
+
+    Args:
+        text (str): The text to be cleaned.
+
+    Returns:
+        str: The text without the thinking content.
+
+    Example:
+        >>> remove_think_content(' let me compute  Hello!')
+        'Hello!'
+        >>> remove_think_content('Plain text.')
+        'Plain text.'
+    """
+    if not text:
+        return text
+
+    cleaned_text = text
+    for tag in THINK_TAGS:
+        cleaned_text = re.sub(
+            rf"<{tag}>.*?</{tag}>",
+            "",
+            cleaned_text,
+            flags=re.DOTALL | re.IGNORECASE,
+        )
+
+    # Some platforms only keep the closing tag of the thinking block, e.g.
+    # "reasoning...</think>The final answer".
+    cleaned_text = re.sub(
+        r"^.*?</think>",
+        "",
+        cleaned_text,
+        flags=re.DOTALL | re.IGNORECASE,
+    )
+
+    if cleaned_text != text:
+        # Strip the redundant whitespaces left by the removed blocks.
+        cleaned_text = cleaned_text.strip()
+
+    return cleaned_text
+
+
+# Readability aliases of :obj:`remove_think_content`.
+strip_think_content = remove_think_content
+remove_think_tags = remove_think_content
