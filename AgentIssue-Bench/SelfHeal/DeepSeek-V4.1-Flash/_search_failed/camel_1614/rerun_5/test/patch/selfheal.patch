+def test_base_message_to_openai_assistant_message_think_content():
+    message = BaseMessage(
+        role_name="test_role_name",
+        role_type=RoleType.ASSISTANT,
+        meta_dict=None,
+        content=(
+            "Let me compute 6 * 7 step by step. 6 * 7 = 42"
+            "The answer is 42."
+        ),
+    )
+    assert message.content == (
+        "Let me compute 6 * 7 step by step. 6 * 7 = 42"
+        "The answer is 42."
+    )
+
+    openai_message = message.to_openai_assistant_message()
+    assert openai_message == {"role": "assistant", "content": "The answer is 42."}
+
+    # The original message must stay untouched.
+    assert "" in message.content
+
+    # Also test the generic conversion path.
+    openai_message = message.to_openai_message(OpenAIBackendRole.ASSISTANT)
+    assert openai_message == {"role": "assistant", "content": "The answer is 42."}
+
+
+def test_base_message_to_openai_user_message_think_content():
+    message = BaseMessage(
+        role_name="test_role_name",
+        role_type=RoleType.USER,
+        meta_dict=None,
+        content="some thinking  hello world",
+    )
+    assert message.to_openai_user_message() == {
+        "role": "user",
+        "content": "hello world",
+    }
+
