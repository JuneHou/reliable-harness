+def remove_think_r1(text: str) -> Any:
+    r"""Removes the think (reasoning) content from the given text.
+
+    Reasoning models, such as DeepSeek R1, wrap their chain of thought in
+    ``...`` tags. Such content is useless (and even harmful) once the
+    final answer has been produced, especially when it is sent back to the
+    model as a part of the conversation history, so it is removed here.
+
+    Args:
+        text (str): The text which may contain think content.
+
+    Returns:
+        Any: The text with all the think content removed. If :obj:`text` is
+            not a string, it is returned unchanged.
+    """
+    if not isinstance(text, str):
+        return text
+
+    try:
+        # Remove all the complete think blocks, e.g. "reasoning".
+        cleaned_text = re.sub(r'', '', text, flags=re.DOTALL)
+
+        # Handle a dangling closing tag, which appears when the opening tag
+        # is missing (for instance when the text has been truncated or was
+        # streamed in chunks): everything before it is think content.
+        if '' in cleaned_text:
+            cleaned_text = cleaned_text.rsplit('', 1)[-1]
+
+        # Handle a dangling opening tag, which appears when the closing tag
+        # is missing: what follows it is an unfinished reasoning block.
+        if '' in cleaned_text:
+            cleaned_text = cleaned_text.split('', 1)[0]
+
+        return cleaned_text.strip()
+    except Exception as e:
+        logger.error(f"Error in remove_think_r1: {e}")
+        return text
+
+
+# Alias kept for readability at the call sites.
+remove_think_content = remove_think_r1
+
+
