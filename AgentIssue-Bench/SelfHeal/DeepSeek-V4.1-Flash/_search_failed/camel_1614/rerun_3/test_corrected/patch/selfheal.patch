+def test_base_message_remove_think_content():
+    think_content = "This is the reasoning content of the model."
+    content = "This is the final answer."
+    raw_content = f"<\u200bthink\u200b>{think_content}</think>{content}"
+
+    message = BaseMessage.make_assistant_message(
+        role_name="test_assistant",
+        content=raw_content,
+    )
+
+    # The think content should be removed from the stored content as well as
+    # from every request sent to the model.
+    assert message.content == content
+
+    assert message.to_openai_message(OpenAIBackendRole.ASSISTANT) == {
+        "role": "assistant",
+        "content": content,
+    }
+    assert message.to_openai_assistant_message() == {
+        "role": "assistant",
+        "content": content,
+    }
+    assert message.to_openai_user_message() == {
+        "role": "user",
+        "content": content,
+    }
+    assert message.to_openai_system_message() == {
+        "role": "system",
+        "content": content,
+    }
+    assert message.to_sharegpt().value == content
+
+
+def test_base_message_remove_think_content_without_opening_tag():
+    content = "This is the final answer."
+    raw_content = f"{content}</think>"[::-1]
+
+    message = BaseMessage.make_assistant_message(
+        role_name="test_assistant",
+        content=raw_content,
+    )
+
+    assert message.content == content
+    assert message.to_openai_assistant_message() == {
+        "role": "assistant",
+        "content": content,
+    }
+
+
+def test_base_message_without_think_content():
+    content = "This is the final answer."
+    message = BaseMessage.make_assistant_message(
+        role_name="test_assistant",
+        content=content,
+    )
+
+    assert message.content == content
+    assert message.to_openai_assistant_message() == {
+        "role": "assistant",
+        "content": content,
+    }
+
