@@ -19,6 +19,26 @@ from metagpt.roles import Role
 from metagpt.utils.common import any_to_str
 
 
+def get_restricted_to(message) -> set[str]:
+    """Return the set of roles a message is restricted to.
+
+    Only werewolf's `WwMessage` defines `restricted_to`. Other messages flowing through the environment
+    (for example the user requirement published by `Team.run_project`, or messages published by plain
+    `Role`s such as the Moderator) are ordinary `Message` instances which do not have that attribute.
+    They are public messages, so an empty set is returned instead of raising
+    `AttributeError: 'Message' object has no attribute 'restricted_to'`.
+    """
+    if message is None:
+        return set()
+    restricted_to = getattr(message, "restricted_to", None)
+    if not restricted_to:
+        return set()
+    if isinstance(restricted_to, str):
+        # tolerate a comma separated string such as "Moderator, Seer"
+        return {v.strip() for v in restricted_to.split(",") if v.strip()}
+    return set(restricted_to)
+
+
 class BasePlayer(Role):
     name: str = "PlayerXYZ"
     profile: str = "BasePlayer"
