     return False
 
 
+def get_restricted_to(message: "Message") -> set:
+    """Return the restricted recipients of `message`.
+
+    `restricted_to` is an optional attribute provided by some Message subclasses (e.g. werewolf's `WwMessage`).
+    A plain `Message` does not define it, so it must be read defensively to avoid
+    `AttributeError: 'Message' object has no attribute 'restricted_to'`.
+    An empty result means the message is visible to the whole audience.
+    """
+    restricted_to = getattr(message, "restricted_to", None)
+    return set(restricted_to) if restricted_to else set()
+
