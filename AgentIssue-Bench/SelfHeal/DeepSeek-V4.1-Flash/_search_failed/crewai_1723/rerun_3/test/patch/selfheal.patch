+def test_reset(short_term_memory):
+    """Resetting the memory must delegate to the underlying storage reset."""
+    with patch.object(RAGStorage, "reset") as mock_reset:
+        short_term_memory.reset()
+
+    mock_reset.assert_called_once()
+
+
+def test_storage_reset_resets_app_before_deleting_storage_folder():
+    """The chromadb client has to be reset before the storage folder is removed,
+    otherwise removing the folder fails with a disk I/O error."""
+    storage = RAGStorage.__new__(RAGStorage)
+    storage.type = "short_term"
+
+    call_order = []
+
+    fake_app = MagicMock()
+    fake_app.reset.side_effect = lambda: call_order.append("app.reset")
+
+    with (
+        patch.object(storage, "app", fake_app, create=True),
+        patch(
+            "crewai.memory.storage.rag_storage.shutil.rmtree",
+            side_effect=lambda *args, **kwargs: call_order.append("rmtree"),
+        ) as mock_rmtree,
+    ):
+        storage.reset()
+
+    mock_rmtree.assert_called_once()
+    assert call_order == ["app.reset", "rmtree"], (
+        "app.reset() must be called before the storage folder is deleted"
+    )
+
+
+def test_storage_reset_ignores_readonly_database_error():
+    """A readonly database error while resetting should not be raised."""
+    storage = RAGStorage.__new__(RAGStorage)
+    storage.type = "short_term"
+
+    fake_app = MagicMock()
+    fake_app.reset.side_effect = Exception("attempt to write a readonly database")
+
+    with (
+        patch.object(storage, "app", fake_app, create=True),
+        patch("crewai.memory.storage.rag_storage.shutil.rmtree"),
+    ):
+        storage.reset()
