diff --git a/src/crewai/memory/storage/rag_storage.py b/src/crewai/memory/storage/rag_storage.py
index bf40aee..af806bf 100644
--- a/src/crewai/memory/storage/rag_storage.py
+++ b/src/crewai/memory/storage/rag_storage.py
@@ -150,9 +150,14 @@ class RAGStorage(BaseRAGStorage):
 
     def reset(self) -> None:
         try:
-            shutil.rmtree(f"{db_storage_path()}/{self.type}")
+            # Reset the chroma client *before* deleting its storage folder.
+            # Deleting the folder first leaves the client (and its sqlite
+            # connections) pointing at paths that no longer exist, so the
+            # following reset fails with a "disk I/O error".
             if self.app:
                 self.app.reset()
+
+            shutil.rmtree(f"{db_storage_path()}/{self.type}")
         except Exception as e:
             if "attempt to write a readonly database" in str(e):
                 # Ignore this specific error
diff --git a/tests/memory/short_term_memory_test.py b/tests/memory/short_term_memory_test.py
index c09b226..03e218a 100644
--- a/tests/memory/short_term_memory_test.py
+++ b/tests/memory/short_term_memory_test.py
@@ -59,3 +59,50 @@ def test_save_and_search(short_term_memory):
         find = short_term_memory.search("test value", score_threshold=0.01)[0]
         assert find["context"] == memory.data, "Data value mismatch."
         assert find["metadata"]["agent"] == "test_agent", "Agent value mismatch."
+
+
+def test_reset_resets_app_before_deleting_storage_folder(short_term_memory):
+    """The chroma client must be reset before its storage folder is removed."""
+    storage = short_term_memory.storage
+    call_order = []
+
+    with (
+        patch.object(storage, "app", create=True) as mocked_app,
+        patch("crewai.memory.storage.rag_storage.shutil.rmtree") as mocked_rmtree,
+    ):
+        mocked_app.reset.side_effect = lambda: call_order.append("reset")
+        mocked_rmtree.side_effect = lambda *args, **kwargs: call_order.append("rmtree")
+
+        storage.reset()
+
+    assert call_order == [
+        "reset",
+        "rmtree",
+    ], "The chroma client must be reset before the storage folder is deleted."
+
+
+def test_reset_ignores_readonly_database_error(short_term_memory):
+    """A readonly database error during reset must not be re-raised."""
+    storage = short_term_memory.storage
+
+    with (
+        patch.object(storage, "app", create=True) as mocked_app,
+        patch("crewai.memory.storage.rag_storage.shutil.rmtree"),
+    ):
+        mocked_app.reset.side_effect = Exception("attempt to write a readonly database")
+
+        storage.reset()
+
+
+def test_reset_raises_on_other_errors(short_term_memory):
+    """Unexpected errors during reset are surfaced as a memory reset error."""
+    storage = short_term_memory.storage
+
+    with (
+        patch.object(storage, "app", create=True) as mocked_app,
+        patch("crewai.memory.storage.rag_storage.shutil.rmtree"),
+    ):
+        mocked_app.reset.side_effect = Exception("boom")
+
+        with pytest.raises(Exception, match="An error occurred while resetting"):
+            storage.reset()
