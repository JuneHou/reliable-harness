     def reset(self) -> None:
         try:
-            shutil.rmtree(f"{db_storage_path()}/{self.type}")
+            # The ChromaDB client keeps the SQLite/hnsw files of the storage
+            # folder open. Deleting the folder while the client is still alive
+            # leaves it pointing at files that no longer exist and any further
+            # operation on it fails with a "disk I/O error". So reset the client
+            # first and only then delete the storage folder.
             if self.app:
                 self.app.reset()
+            shutil.rmtree(f"{db_storage_path()}/{self.type}")
         except Exception as e:
