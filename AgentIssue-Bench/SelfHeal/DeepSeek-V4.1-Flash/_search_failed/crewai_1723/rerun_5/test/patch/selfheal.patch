+
+
+def test_reset_memory(short_term_memory):
+    """Resetting must reset the ChromaDB client before deleting the storage folder.
+
+    Removing the storage folder while the client still holds its files open
+    made ChromaDB fail later on with a "disk I/O error".
+    """
+    storage = short_term_memory.storage
+    manager = MagicMock()
+
+    with (
+        patch.object(storage, "app", manager.app),
+        patch("crewai.memory.storage.rag_storage.shutil.rmtree", manager.rmtree),
+    ):
+        short_term_memory.reset()
+
+    assert manager.mock_calls == [
+        call.app.reset(),
+        call.rmtree(ANY),
+    ], f"Client must be reset before the folder is removed: {manager.mock_calls}"
