-            shutil.rmtree(f"{db_storage_path()}/{self.type}")
-            if self.app:
+            # Reset the Chroma client *before* removing the storage folder.
+            # Deleting the directory while the client still holds open handles
+            # to the underlying persistent database files leaves the storage in
+            # a broken state, so subsequent operations fail with disk I/O
+            # errors. Resetting first flushes/closes it properly.
+            if getattr(self, "app", None) is not None:
                 self.app.reset()
+
+            # The folder may legitimately not exist yet (nothing persisted),
+            # which must not be treated as a reset failure.
+            with contextlib.suppress(FileNotFoundError):
+                shutil.rmtree(f"{db_storage_path()}/{self.type}")
+
+            # Invalidate the client/collection references so they get lazily
+            # recreated against a fresh storage directory on next use.
+            self.app = None
+            self.collection = None
