+def parse_command_state(enabled):
+    """Normalize a command enabled value coming from an API request into a bool."""
+    if isinstance(enabled, bool):
+        return enabled
+    if isinstance(enabled, str):
+        return enabled.strip().lower() in ("true", "1", "yes", "on", "enabled")
+    if enabled is None:
+        return False
+    return bool(enabled)
