+def convert_to_bool(value):
+    """Normalize the different ways a command state can be provided into a bool."""
+    if isinstance(value, bool):
+        return value
+    if isinstance(value, str):
+        return value.strip().lower() in ("true", "1", "yes", "on", "enabled")
+    if value is None:
+        return False
+    return bool(value)
+
+
+def get_or_create_command(session, command_name):
+    """Return the command with the given name, creating it when it is missing.
+
+    Commands that are not (yet) in the database used to be silently skipped which
+    made the agent command selections appear as if they were never saved.
+    """
+    command = session.query(Command).filter_by(name=command_name).first()
+    if not command:
+        command = Command(name=command_name)
+        session.add(command)
+        session.commit()
+    return command
+
+
