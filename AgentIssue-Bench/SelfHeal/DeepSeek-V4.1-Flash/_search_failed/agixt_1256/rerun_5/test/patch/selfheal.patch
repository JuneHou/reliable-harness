+def to_bool(value):
+    """Normalize all of the different values a command state can be stored as."""
+    if isinstance(value, bool):
+        return value
+    if value is None:
+        return False
+    if isinstance(value, str):
+        return value.strip().lower() in ["true", "1", "yes", "on", "enabled"]
+    return bool(value)
+
+
+def normalize_command_name(command_name):
+    """Commands can be referenced by their function name or friendly name."""
+    if command_name is None:
+        return ""
+    return (
+        str(command_name).replace("_", " ").replace("-", " ").strip().lower()
+    )
+
+
+def get_command_by_name(session, command_name, all_commands=None):
+    """Get the command record for a command name, tolerating friendly/function names."""
+    if command_name is None:
+        return None
+    command_name = str(command_name).strip()
+    if not command_name:
+        return None
+    if all_commands is None:
+        all_commands = session.query(Command).all()
+    for command in all_commands:
+        if str(command.name) == command_name:
+            return command
+    normalized_command_name = normalize_command_name(command_name)
+    for command in all_commands:
+        if normalize_command_name(command.name) == normalized_command_name:
+            return command
+    return None
+
+
+def set_agent_command_state(session, agent_id, command_id, enabled):
+    """Persist the enabled state of a command for an agent, cleaning up duplicates."""
+    enabled = to_bool(enabled)
+    agent_commands = (
+        session.query(AgentCommand)
+        .filter_by(agent_id=agent_id, command_id=command_id)
+        .all()
+    )
+    if not agent_commands:
+        session.add(
+            AgentCommand(agent_id=agent_id, command_id=command_id, state=enabled)
+        )
+        return
+    agent_commands[0].state = enabled
+    for duplicate_agent_command in agent_commands[1:]:
+        session.delete(duplicate_agent_command)
+
+
