@@ -48,6 +48,24 @@ class TestRetrieveUtils:
         with pytest.raises(AssertionError):
             split_text_to_chunks("A" * 10000, chunk_mode="bogus_chunk_mode")
 
+    def test_split_text_to_chunks_with_overlap(self):
+        # build a text with many short lines so that multi_lines chunking happens
+        lines = [f"This is line number {i} of the test document." for i in range(200)]
+        long_text = "\n".join(lines)
+        chunks = split_text_to_chunks(long_text, max_tokens=100, chunk_mode="multi_lines", overlap=5)
+        assert all(count_token(chunk) <= 100 for chunk in chunks)
+        assert len(chunks) > 1
+        # consecutive chunks should share some lines because of the overlap
+        overlap_found = False
+        for prev_chunk, next_chunk in zip(chunks, chunks[1:]):
+            prev_lines = prev_chunk.split("\n")
+            next_lines = next_chunk.split("\n")
+            shared = set(prev_lines[-5:]) & set(next_lines[:5])
+            if len(shared) > 0:
+                overlap_found = True
+                break
+        assert overlap_found
+
     def test_extract_text_from_pdf(self):
