+# Fields that a `ChatMessage` is able to accept. Newer OpenAI API versions add
+# extra fields to the returned message objects (e.g. `audio`, `refusal`,
+# `annotations`, `function_call`, `tool_calls`), which must not be forwarded to
+# `ChatMessage.__init__` because it would raise a `TypeError`.
+CHAT_MESSAGE_SUPPORTED_KEYS = {"role", "content"}
+
+
+def build_chat_message(role_name: str, role_type: RoleType,
+                       raw_message: Dict[str, Any]) -> ChatMessage:
+    r"""Builds a :obj:`ChatMessage` from a raw OpenAI message.
+
+    Args:
+        role_name (str): The name of the role that generates the message.
+        role_type (RoleType): The type of the role.
+        raw_message (Dict[str, Any]): The raw message returned by the OpenAI
+            API (either an object or a dict), which may contain fields that are
+            not supported by :obj:`ChatMessage`.
+
+    Returns:
+        ChatMessage: The constructed chat message.
+    """
+    if not isinstance(raw_message, dict):
+        try:
+            raw_message = dict(raw_message)
+        except (TypeError, ValueError):
+            raw_message = {
+                "role": getattr(raw_message, "role", "assistant"),
+                "content": getattr(raw_message, "content", ""),
+            }
+
+    kwargs = {
+        key: value
+        for key, value in raw_message.items()
+        if key in CHAT_MESSAGE_SUPPORTED_KEYS
+    }
+    if kwargs.get("content") is None:
+        kwargs["content"] = ""
+    kwargs.setdefault("role", "assistant")
+
+    return ChatMessage(role_name=role_name,
+                       role_type=role_type,
+                       meta_dict=dict(),
+                       **kwargs)
+
+
