+def _set_additional_properties_to_false(schema: Any) -> None:
+    """
+    Recursively sets `additionalProperties` to `False` in the given JSON schema.
+
+    OpenAI's strict mode requires `additionalProperties` to be explicitly set to `False` for every object in the
+    schema, nested objects included. Otherwise the request is rejected with an "Invalid schema for function" error.
+
+    :param schema: The (JSON) schema to update in place.
+    """
+    if isinstance(schema, list):
+        for item in schema:
+            _set_additional_properties_to_false(item)
+        return
+
+    if not isinstance(schema, dict):
+        return
+
+    # recurse into sub-schemas that are stored in a mapping of names to schemas
+    for key in ("properties", "$defs", "definitions", "patternProperties"):
+        sub_schemas = schema.get(key)
+        if isinstance(sub_schemas, dict):
+            for sub_schema in sub_schemas.values():
+                _set_additional_properties_to_false(sub_schema)
+
+    # recurse into sub-schemas that are stored directly under a key
+    for key in ("items", "contains", "not", "if", "then", "else", "additionalProperties"):
+        sub_schema = schema.get(key)
+        if isinstance(sub_schema, (dict, list)):
+            _set_additional_properties_to_false(sub_schema)
+
+    # recurse into sub-schemas that are stored in a list of schemas
+    for key in ("anyOf", "oneOf", "allOf", "prefixItems"):
+        sub_schemas = schema.get(key)
+        if isinstance(sub_schemas, list):
+            for sub_schema in sub_schemas:
+                _set_additional_properties_to_false(sub_schema)
+
+    schema_type = schema.get("type")
+    is_object_schema = (
+        schema_type == "object"
+        or "properties" in schema
+        or (isinstance(schema_type, list) and "object" in schema_type)
+    )
+    if is_object_schema:
+        schema["additionalProperties"] = False
+
+
 @component
 class OpenAIChatGenerator:
