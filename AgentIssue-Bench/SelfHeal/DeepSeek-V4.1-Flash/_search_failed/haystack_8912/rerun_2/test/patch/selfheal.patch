 logger = logging.getLogger(__name__)
 
+# JSON schema keys whose values are literal values and not subschemas, so they must not be altered
+_NON_SCHEMA_KEYS = ("const", "default", "enum", "example", "examples")
+
+
+def _is_object_schema(schema: Dict[str, Any]) -> bool:
+    """
+    Return whether the given JSON schema describes an object.
+    """
+    schema_type = schema.get("type")
+    if schema_type == "object":
+        return True
+    if isinstance(schema_type, list) and "object" in schema_type:
+        return True
+    # Schema generators (e.g. the Pydantic one used by `ComponentTool`) may omit "type" when "properties" is set
+    return schema_type is None and "properties" in schema
+
+
+def _convert_to_openai_strict_schema(schema: Any) -> Any:
+    """
+    Recursively convert a JSON schema into the format required by OpenAI's strict tool use.
+
+    OpenAI's strict mode requires every object of the tool's parameters schema to explicitly set
+    `additionalProperties` to `False`, including the nested ones (for example the objects generated from
+    Pydantic models and stored in `$defs`). Only setting it on the root object makes the OpenAI API reject
+    the schema of tools with nested parameters, like the `ComponentTool`s created from components that have
+    complex input types.
+
+    The input schema is not modified in place, a new schema is returned instead.
+
+    :param schema: The JSON schema to convert. It can be a schema, a list of schemas or a plain value.
+    :returns: A new JSON schema where `additionalProperties` is set to `False` for every object.
+    """
+    if isinstance(schema, list):
+        return [_convert_to_openai_strict_schema(item) for item in schema]
+
+    if not isinstance(schema, dict):
+        return schema
+
+    strict_schema: Dict[str, Any] = {}
+    for key, value in schema.items():
+        strict_schema[key] = value if key in _NON_SCHEMA_KEYS else _convert_to_openai_strict_schema(value)
+
+    if _is_object_schema(strict_schema):
+        strict_schema["additionalProperties"] = False
+
+    return strict_schema
+
 
