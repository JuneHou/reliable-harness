+def _apply_strict_schema_to_parameters(schema: Any) -> None:
+    """
+    Recursively set `additionalProperties` to `False` on every object contained in a JSON schema.
+
+    OpenAI's strict mode requires `additionalProperties` to be explicitly set to `False` for the root object of the
+    schema *and* for every nested object (for example the ones generated for components by `ComponentTool`).
+    The schema is modified in place, so pass a copy if the original must be preserved.
+
+    :param schema: The JSON schema (or any nested value of it) to make strict.
+    """
+    if isinstance(schema, dict):
+        if schema.get("type") == "object" or "properties" in schema:
+            schema["additionalProperties"] = False
+        # recurse into all nested schemas (properties, items, $defs, anyOf/oneOf/allOf, ...)
+        for value in schema.values():
+            _apply_strict_schema_to_parameters(value)
+    elif isinstance(schema, list):
+        for item in schema:
+            _apply_strict_schema_to_parameters(item)
+
