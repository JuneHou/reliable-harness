diff --git a/python/packages/autogen-core/src/autogen_core/application/__init__.py b/python/packages/autogen-core/src/autogen_core/application/__init__.py
index 0caa89c..55bfd1d 100644
--- a/python/packages/autogen-core/src/autogen_core/application/__init__.py
+++ b/python/packages/autogen-core/src/autogen_core/application/__init__.py
@@ -2,8 +2,32 @@
 The :mod:`autogen_core.application` module provides implementations of core components that are used to compose an application
 """
 
+from typing import Any
+
 from ._single_threaded_agent_runtime import SingleThreadedAgentRuntime
-from ._worker_runtime import WorkerAgentRuntime
-from ._worker_runtime_host import WorkerAgentRuntimeHost
 
 __all__ = ["SingleThreadedAgentRuntime", "WorkerAgentRuntime", "WorkerAgentRuntimeHost"]
+
+
+def __getattr__(name: str) -> Any:
+    """Lazily import the gRPC-backed runtimes.
+
+    ``WorkerAgentRuntime`` and ``WorkerAgentRuntimeHost`` depend on the optional
+    ``grpc`` package. Importing them eagerly here would make the whole
+    ``autogen_core.application`` module -- and therefore ``SingleThreadedAgentRuntime``,
+    which is used by ``autogen_agentchat`` teams -- fail with
+    ``ModuleNotFoundError: No module named 'grpc'`` when gRPC is not installed.
+
+    Deferring the import ensures the in-process ``SingleThreadedAgentRuntime`` can be
+    used without gRPC, while the distributed runtime still raises its intended
+    gRPC import error when it is actually accessed.
+    """
+    if name == "WorkerAgentRuntime":
+        from ._worker_runtime import WorkerAgentRuntime
+
+        return WorkerAgentRuntime
+    if name == "WorkerAgentRuntimeHost":
+        from ._worker_runtime_host import WorkerAgentRuntimeHost
+
+        return WorkerAgentRuntimeHost
+    raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
