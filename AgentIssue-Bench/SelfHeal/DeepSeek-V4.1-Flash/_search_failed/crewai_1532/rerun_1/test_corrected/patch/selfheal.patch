+# Values that, when assigned to a telemetry disable flag, are treated as truthy.
+_TRUTHY_TELEMETRY_VALUES = ("true", "1", "yes", "on")
+
+# Environment variables that can be used to fully disable CrewAI telemetry.
+# `CREWAI_DISABLE_TELEMETRY` disables only CrewAI's own exporter, while
+# `OTEL_SDK_DISABLED` is the standard OpenTelemetry kill switch.
+_TELEMETRY_DISABLE_ENV_VARS = ("CREWAI_DISABLE_TELEMETRY", "OTEL_SDK_DISABLED")
+
+
+def _is_telemetry_disabled() -> bool:
+    """Return ``True`` if telemetry has been disabled via an env var.
+
+    Either ``CREWAI_DISABLE_TELEMETRY`` or ``OTEL_SDK_DISABLED`` set to one of
+    ``true``, ``1``, ``yes`` or ``on`` (case-insensitive) disables CrewAI's
+    telemetry exporter so it no longer attempts to send data.
+    """
+    return any(
+        (os.getenv(env_var) or "").strip().lower() in _TRUTHY_TELEMETRY_VALUES
+        for env_var in _TELEMETRY_DISABLE_ENV_VARS
+    )
+
