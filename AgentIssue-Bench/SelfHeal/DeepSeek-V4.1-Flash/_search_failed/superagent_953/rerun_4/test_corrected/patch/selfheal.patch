diff --git a/libs/.docker/ui/docker-compose.ui.yml b/libs/.docker/ui/docker-compose.ui.yml
index 4e952f1..8218994 100644
--- a/libs/.docker/ui/docker-compose.ui.yml
+++ b/libs/.docker/ui/docker-compose.ui.yml
@@ -19,6 +19,8 @@ services:
         NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY: ${NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY}
         NEXT_PUBLIC_LANGFUSE_PUBLIC_KEY: ${NEXT_PUBLIC_LANGFUSE_PUBLIC_KEY}
         NEXT_PUBLIC_LANGFUSE_BASE_URL: ${NEXT_PUBLIC_LANGFUSE_BASE_URL}
+    # The Supabase CLI is installed in the image (see libs/ui/Dockerfile), so the
+    # database migrations can be pushed before the Next.js server is started.
     command: /bin/sh -c "npm run supabase:docker:push --debug && npm start"
     environment:
       - PORT=3000
diff --git a/libs/ui/Dockerfile b/libs/ui/Dockerfile
index b5a9c34..5aadb01 100644
--- a/libs/ui/Dockerfile
+++ b/libs/ui/Dockerfile
@@ -49,8 +49,24 @@ RUN npm run build
 # Runner stage
 FROM node:18-buster AS runner
 
-# Install bash and netcat in the runner stage
-RUN apt-get update && apt-get install -y bash netcat-openbsd libvips-dev libfftw3-dev build-essential python3
+# Install bash, netcat and the Supabase CLI in the runner stage.
+# The Supabase CLI is required at runtime because the container entrypoint runs
+# `npm run supabase:docker:push` (supabase db push --db-url ...) before `npm start`.
+RUN apt-get update && apt-get install -y \
+    bash \
+    netcat-openbsd \
+    libvips-dev \
+    libfftw3-dev \
+    build-essential \
+    python3 \
+    curl \
+    ca-certificates \
+    && curl -fsSL https://github.com/supabase/cli/releases/latest/download/supabase_linux_amd64.tar.gz \
+    | tar -xz -C /usr/local/bin supabase \
+    && chmod +x /usr/local/bin/supabase \
+    && supabase --version \
+    && apt-get clean \
+    && rm -rf /var/lib/apt/lists/*
 
 # Set environment variables
 ENV NODE_ENV production
