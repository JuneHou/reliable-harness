+# Only the fields accepted by ``ChatMessage`` are forwarded from the raw
+# OpenAI message payload.  Newer versions of the OpenAI SDK add extra keys
+# (e.g. ``refusal``, ``audio``, ``annotations``, ``tool_calls``), passing
+# them through with ``**dict(message)`` made ``ChatMessage.__init__`` fail
+# with "unexpected keyword argument".
+CHAT_MESSAGE_FIELDS = ("role", "content")
+
+
+def _message_dict_from_openai_message(message: Any) -> Dict[str, Any]:
+    r"""Extracts the ``ChatMessage`` compatible keyword arguments from a
+    (new or old API) OpenAI chat completion message.
+
+    Args:
+        message (Any): A pydantic model (new API) or a ``dict`` (old API)
+            describing the assistant reply.
+
+    Returns:
+        Dict[str, Any]: The keyword arguments accepted by ``ChatMessage``.
+    """
+    if isinstance(message, Mapping):
+        raw_message: Dict[str, Any] = dict(message)
+    else:
+        # pydantic v1 / v2 models, dataclass-like objects, ...
+        if hasattr(message, "model_dump"):
+            raw_message = message.model_dump()
+        elif hasattr(message, "dict"):
+            raw_message = message.dict()
+        else:
+            raw_message = dict(vars(message))
+
+    message_dict = {
+        key: value
+        for key, value in raw_message.items() if key in CHAT_MESSAGE_FIELDS
+    }
+    # ``role`` and ``content`` are required positional fields of ChatMessage.
+    message_dict.setdefault("role", "assistant")
+    content = message_dict.get("content")
+    message_dict["content"] = "" if content is None else content
+    return message_dict
+
+
