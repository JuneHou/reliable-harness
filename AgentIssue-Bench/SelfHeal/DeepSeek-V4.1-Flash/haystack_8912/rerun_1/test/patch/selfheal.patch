+def _add_additional_properties_false(schema: Any) -> None:
+    """
+    Recursively add `additionalProperties: False` to every object in a JSON schema.
+
+    OpenAI's strict tool use requires that `additionalProperties` is explicitly set to `False` for
+    every object in the schema of a tool, including nested objects. Since tools such as
+    `ComponentTool` generate schemas that can contain nested objects (for example for `Dict`
+    parameters), setting the flag only on the top-level `parameters` object is not enough and
+    results in the request being rejected by the OpenAI API.
+
+    :param schema:
+        The JSON schema (or any nested part of it) to update in place.
+    """
+    if isinstance(schema, dict):
+        # Mark every object schema (including those without `properties`, e.g. free-form dicts) as strict.
+        if schema.get("type") == "object" or "properties" in schema:
+            schema["additionalProperties"] = False
+        # Recurse into all nested schemas (properties, items, $defs, anyOf/oneOf/allOf, etc.).
+        for value in schema.values():
+            _add_additional_properties_false(value)
+    elif isinstance(schema, list):
+        for value in schema:
+            _add_additional_properties_false(value)
+
