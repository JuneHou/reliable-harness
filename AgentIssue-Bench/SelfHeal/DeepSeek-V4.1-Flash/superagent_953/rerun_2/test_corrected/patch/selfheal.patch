 # Set working directory
 WORKDIR /app
@@ -49,8 +53,29 @@ RUN npm run build
 # Runner stage
 FROM node:18-buster AS runner
 
-# Install bash and netcat in the runner stage
-RUN apt-get update && apt-get install -y bash netcat-openbsd libvips-dev libfftw3-dev build-essential python3
+# Install bash, netcat, curl and the runtime libraries in the runner stage
+RUN apt-get update && apt-get install -y \
+    bash \
+    netcat-openbsd \
+    libvips-dev \
+    libfftw3-dev \
+    build-essential \
+    python3 \
+    curl \
+    ca-certificates \
+    && apt-get clean \
+    && rm -rf /var/lib/apt/lists/*
+
+# Install the Supabase CLI, which is required at container start-up by the
+# `supabase:docker:push` npm script used in docker-compose.ui.yml.
+RUN set -eux; \
+    ARCH="$(dpkg --print-architecture)"; \
+    SUPABASE_VERSION="1.115.0"; \
+    curl -fsSL -o /tmp/supabase.deb \
+        "https://github.com/supabase/cli/releases/download/v${SUPABASE_VERSION}/supabase_${SUPABASE_VERSION}_linux_${ARCH}.deb"; \
+    dpkg -i /tmp/supabase.deb || apt-get install -y -f; \
+    rm -f /tmp/supabase.deb; \
+    supabase --version
 
 # Set environment variables
 ENV NODE_ENV production
