+def _extract_message_fields(message: Any) -> Dict[str, Any]:
+    r"""Extracts only the fields that :obj:`ChatMessage` accepts from an
+    OpenAI chat completion message.
+
+    The newer OpenAI API returns messages with additional fields (e.g.
+    :obj:`audio`, :obj:`refusal`, :obj:`annotations`, :obj:`function_call`,
+    :obj:`tool_calls`). Blindly forwarding the whole message payload to
+    :obj:`ChatMessage` therefore raises a :obj:`TypeError` such as
+    ``ChatMessage.__init__() got an unexpected keyword argument 'audio'``.
+    Only the ``role`` and ``content`` fields are kept here.
+    """
+    if isinstance(message, dict):
+        role = message.get("role", "assistant")
+        content = message.get("content")
+    else:
+        role = getattr(message, "role", "assistant")
+        content = getattr(message, "content", None)
+
+    if role is None:
+        role = "assistant"
+    if content is None:
+        content = ""
+    elif not isinstance(content, str):
+        content = str(content)
+
+    return {"role": role, "content": content}
+
+
