+def _get_message_content(message: Any) -> str:
+    r"""Safely extracts the textual content from an OpenAI chat message.
+
+    Args:
+        message (Any): An OpenAI chat completion message object (new api) or
+            a plain dict (old api).
+
+    Returns:
+        str: The content of the message, an empty string if it is missing.
+    """
+    if message is None:
+        return ""
+    if isinstance(message, dict):
+        content = message.get("content")
+    else:
+        content = getattr(message, "content", None)
+    if content is None:
+        return ""
+    return content
+
+
+def _get_message_role(message: Any, default_role: str = "assistant") -> str:
+    r"""Safely extracts the role of an OpenAI chat message.
+
+    Args:
+        message (Any): An OpenAI chat completion message object (new api) or
+            a plain dict (old api).
+        default_role (str): Fallback role name. (default: :obj:`"assistant"`)
+
+    Returns:
+        str: The role of the message.
+    """
+    if isinstance(message, dict):
+        role = message.get("role")
+    else:
+        role = getattr(message, "role", None)
+    if not role:
+        return default_role
+    return role
+
+
