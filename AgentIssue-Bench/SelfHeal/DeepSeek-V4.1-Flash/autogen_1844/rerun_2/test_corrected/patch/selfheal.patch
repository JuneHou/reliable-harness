diff --git a/test/test_retrieve_utils.py b/test/test_retrieve_utils.py
index c2ade23..2fb046e 100755
--- a/test/test_retrieve_utils.py
+++ b/test/test_retrieve_utils.py
@@ -48,6 +48,20 @@ class TestRetrieveUtils:
         with pytest.raises(AssertionError):
             split_text_to_chunks("A" * 10000, chunk_mode="bogus_chunk_mode")
 
+    def test_split_text_to_chunks_overlap(self):
+        # Consecutive chunks should share the overlapping lines, which means more chunks are
+        # required to cover the same text when the overlap is larger.
+        text = "\n\n".join([f"Line {i} " + "word " * 20 for i in range(50)])
+        chunks_without_overlap = split_text_to_chunks(text, max_tokens=100, overlap=0)
+        chunks_with_overlap = split_text_to_chunks(text, max_tokens=100, overlap=2)
+        assert len(chunks_without_overlap) > 1
+        assert len(chunks_with_overlap) > len(chunks_without_overlap)
+        # the overlapping lines are duplicated in two consecutive chunks
+        for previous_chunk, current_chunk in zip(chunks_with_overlap, chunks_with_overlap[1:]):
+            previous_lines = {line for line in previous_chunk.split("\n") if line.strip()}
+            current_lines = {line for line in current_chunk.split("\n") if line.strip()}
+            assert previous_lines & current_lines
+
     def test_extract_text_from_pdf(self):
         pdf_file_path = os.path.join(test_dir, "example.pdf")
         assert "".join(expected_text.split()) == "".join(extract_text_from_pdf(pdf_file_path).strip().split())
