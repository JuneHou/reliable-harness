diff --git a/test/test_retrieve_utils.py b/test/test_retrieve_utils.py
index c2ade23..8f4a2cd 100755
--- a/test/test_retrieve_utils.py
+++ b/test/test_retrieve_utils.py
@@ -48,6 +48,27 @@ class TestRetrieveUtils:
         with pytest.raises(AssertionError):
             split_text_to_chunks("A" * 10000, chunk_mode="bogus_chunk_mode")
 
+    def test_split_text_to_chunks_with_overlap(self):
+        lines = [f"line number {i} holds a couple of words" for i in range(60)]
+        long_text = "\n".join(lines)
+
+        chunks = split_text_to_chunks(long_text, max_tokens=100, must_break_at_empty_line=False, overlap=2)
+        assert len(chunks) > 1
+        # the `overlap` parameter must be honored: consecutive chunks share lines
+        assert any(
+            line in next_chunk.split("\n")
+            for prev_chunk, next_chunk in zip(chunks, chunks[1:])
+            for line in prev_chunk.split("\n")[-2:]
+        )
+
+        # with overlap=0 no line is repeated across consecutive chunks
+        chunks_no_overlap = split_text_to_chunks(long_text, max_tokens=100, must_break_at_empty_line=False, overlap=0)
+        assert len(chunks_no_overlap) > 1
+        assert all(
+            prev_chunk.split("\n")[-1] != next_chunk.split("\n")[0]
+            for prev_chunk, next_chunk in zip(chunks_no_overlap, chunks_no_overlap[1:])
+        )
+
     def test_extract_text_from_pdf(self):
