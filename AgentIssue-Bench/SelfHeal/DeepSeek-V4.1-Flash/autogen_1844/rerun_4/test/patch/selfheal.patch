diff --git a/test/test_retrieve_utils.py b/test/test_retrieve_utils.py
index c2ade23..646c24f 100755
--- a/test/test_retrieve_utils.py
+++ b/test/test_retrieve_utils.py
@@ -48,6 +48,22 @@ class TestRetrieveUtils:
         with pytest.raises(AssertionError):
             split_text_to_chunks("A" * 10000, chunk_mode="bogus_chunk_mode")
 
+    def test_split_text_to_chunks_overlap(self):
+        # Build a text made of paragraphs separated by empty lines, so that it can be split at empty lines.
+        paragraphs = [f"Paragraph {i}: " + "A" * 100 for i in range(100)]
+        long_text = "\n\n".join(paragraphs)
+
+        chunks_without_overlap = split_text_to_chunks(long_text, max_tokens=500, overlap=0)
+        chunks_with_overlap = split_text_to_chunks(long_text, max_tokens=500, overlap=5)
+
+        assert len(chunks_without_overlap) > 1
+        assert len(chunks_with_overlap) > 1
+        # The `overlap` lines are repeated at the beginning of the following chunks, therefore the
+        # total length of the chunks must be larger when overlap > 0.
+        assert sum(len(chunk) for chunk in chunks_with_overlap) > sum(
+            len(chunk) for chunk in chunks_without_overlap
+        )
+
     def test_extract_text_from_pdf(self):
         pdf_file_path = os.path.join(test_dir, "example.pdf")
         assert "".join(expected_text.split()) == "".join(extract_text_from_pdf(pdf_file_path).strip().split())
