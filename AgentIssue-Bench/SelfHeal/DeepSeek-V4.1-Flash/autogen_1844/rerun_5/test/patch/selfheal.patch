diff --git a/test/test_retrieve_utils.py b/test/test_retrieve_utils.py
index c2ade23..7d95c46 100755
--- a/test/test_retrieve_utils.py
+++ b/test/test_retrieve_utils.py
@@ -44,6 +44,27 @@ class TestRetrieveUtils:
         chunks = split_text_to_chunks(long_text, max_tokens=1000)
         assert all(count_token(chunk) <= 1000 for chunk in chunks)
 
+    def test_split_text_to_chunks_overlap(self):
+        # The overlap parameter must actually be used: consecutive chunks have to share some lines.
+        long_text = "\n".join([f"Line {i}" for i in range(200)])
+
+        chunks_without_overlap = split_text_to_chunks(
+            long_text, max_tokens=40, chunk_mode="multi_lines", must_break_at_empty_line=False, overlap=0
+        )
+        chunks_with_overlap = split_text_to_chunks(
+            long_text, max_tokens=40, chunk_mode="multi_lines", must_break_at_empty_line=False, overlap=5
+        )
+        assert len(chunks_without_overlap) > 1
+        assert len(chunks_with_overlap) > 1
+
+        # Without overlap, the chunks are disjoint.
+        for prev, cur in zip(chunks_without_overlap, chunks_without_overlap[1:]):
+            assert not set(prev.split("\n")) & set(cur.split("\n"))
+
+        # With overlap, each chunk starts with (some of) the lines ending the previous chunk.
+        for prev, cur in zip(chunks_with_overlap, chunks_with_overlap[1:]):
+            assert set(prev.split("\n")) & set(cur.split("\n")[:5])
+
     def test_split_text_to_chunks_raises_on_invalid_chunk_mode(self):
         with pytest.raises(AssertionError):
             split_text_to_chunks("A" * 10000, chunk_mode="bogus_chunk_mode")
