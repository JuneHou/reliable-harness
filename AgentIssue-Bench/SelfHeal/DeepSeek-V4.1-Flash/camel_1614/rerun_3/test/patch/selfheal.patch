diff --git a/test/messages/test_message_base.py b/test/messages/test_message_base.py
index 2fe00e7..648d45a 100644
--- a/test/messages/test_message_base.py
+++ b/test/messages/test_message_base.py
@@ -58,6 +58,47 @@ def test_base_message_contains_operator(base_message: BaseMessage):
     assert "foo" not in base_message
 
 
+def test_base_message_remove_think_content():
+    r"""The thinking content should never be part of the message that is sent
+    back to the model.
+    """
+    think_content = (
+        "This is the thinking content."
+        "This is the response."
+    )
+    message = BaseMessage.make_assistant_message(
+        role_name="assistant",
+        content=think_content,
+    )
+
+    # The thinking content is removed from the message content
+    assert message.content == "This is the response."
+    assert message.to_openai_assistant_message() == {
+        "role": "assistant",
+        "content": "This is the response.",
+    }
+
+    user_message = BaseMessage.make_user_message(
+        role_name="user",
+        content="reasoning",
+    )
+    assert user_message.to_openai_user_message() == {
+        "role": "user",
+        "content": "reasoning",
+    }
+    assert user_message.to_openai_message(OpenAIBackendRole.USER) == {
+        "role": "user",
+        "content": "reasoning",
+    }
+    assert user_message.to_openai_system_message() == {
+        "role": "system",
+        "content": "reasoning",
+    }
+
+    # It is also removed when the message is converted to sharegpt
+    assert message.to_sharegpt().value == "This is the response."
+
+
