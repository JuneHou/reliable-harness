     return new_tasks_list
 
 
+def remove_think_tags(text: Optional[str] = None) -> str:
+    r"""Removes the thinking content from the given text.
+
+    Some models (e.g. DeepSeek R1) return their reasoning process enclosed
+    between the `` think `` and `` /think `` tags. Such content should never
+    be sent back to the model, so this helper strips both the tags and the
+    content they enclose from the given text.
+
+    Args:
+        text (Optional[str]): The input text from which the think tags and
+            the content they enclose will be removed.
+            (default: :obj:`None`)
+
+    Returns:
+        str: The text with the think tag content removed.
+
+    Raises:
+        ValueError: If the input text is :obj:`None`.
+
+    Example:
+        >>> text = "hello world"
+        >>> remove_think_tags(text)
+        'hello world'
+    """
+    if text is None:
+        raise ValueError("Input text cannot be None")
+
+    think_pattern = r'...'
+    cleaned_text = re.sub(think_pattern, '', text, flags=re.DOTALL)
+    return cleaned_text.strip()
+
