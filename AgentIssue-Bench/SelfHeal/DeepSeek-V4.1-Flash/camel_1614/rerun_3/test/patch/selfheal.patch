 def test_get_task_list():
@@ -54,6 +55,36 @@ def test_get_task_list():
     assert len(task_list) == 1
 
 
+def test_remove_think_tags():
+    # Text without think tags is left untouched
+    text = "This is a normal text without think tags."
+    assert remove_think_tags(text) == text
+
+    # Leading think content is removed
+    text = "...This is the response."
+    assert remove_think_tags(text) == "This is the response."
+
+    # Trailing think content is removed
+    text = "This is the response...."
+    assert remove_think_tags(text) == "This is the response."
+
+    # Several think blocks are all removed
+    text = "First...0.1Second...Second"
+    assert remove_think_tags(text) == "FirstSecond"
+
+    # Multi-line and multi-step thinking content is removed
+    text = "Multi-line\n..."
+    assert remove_think_tags(text) == "Multi-line"
+
+    # Empty strings are supported
+    assert remove_think_tags("") == ""
+
+
+def test_remove_think_tags_with_none():
+    with pytest.raises(ValueError):
+        remove_think_tags(None)
+
