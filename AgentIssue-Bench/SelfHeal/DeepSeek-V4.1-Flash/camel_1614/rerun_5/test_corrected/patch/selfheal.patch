+def parse_and_remove_think_tags(text: str) -> str:
+    r"""Removes the thinking (reasoning) content wrapped by ```` tags
+    from the given text.
+
+    Some reasoning models, such as DeepSeek R1, wrap their chain-of-thought
+    into ```` tags. Such content should not be sent back to the
+    model in the following requests, thus it is parsed out and removed here.
+
+    Args:
+        text (str): The input text which may contain ```` tags.
+
+    Returns:
+        str: The text with all the think tags and their content removed.
+
+    Example:
+        >>> parse_and_remove_think_tags("Hi  thinkinghmm...</think> there!")
+        'Hi  there!'
+    """
+    if not text:
+        return text
+
+    # Non-greedy matching (with DOTALL) so that every think block, even a
+    # multi-line one or when several blocks are present, is removed.
+    pattern = r'<think\b[^>]*>.*?</think\s*>'
+    return re.sub(pattern, '', text, flags=re.DOTALL)
+
+
+# Alias kept for readability at the call sites.
+remove_think_tags = parse_and_remove_think_tags
+
