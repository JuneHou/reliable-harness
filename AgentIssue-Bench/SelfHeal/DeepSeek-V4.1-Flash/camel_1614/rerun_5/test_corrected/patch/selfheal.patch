+def test_parse_and_remove_think_tags():
+    # No think tags, the text is returned unchanged.
+    assert parse_and_remove_think_tags("Just a normal text.") == (
+        "Just a normal text."
+    )
+    assert parse_and_remove_think_tags("") == ""
+
+    # A single think block is removed, together with its content.
+    assert (
+        parse_and_remove_think_tags(
+            "Hello  thinkingsome reasoning here</think> world!"
+        )
+        == "Hello  world!"
+    )
+
+    # Multi-line think blocks are removed as well.
+    assert (
+        parse_and_remove_think_tags(
+            "Answer: 42.  thinkingline 1\nline 2\nline 3</think> Done."
+        )
+        == "Answer: 42.  Done."
+    )
+
+    # Several think blocks in the same text are all removed.
+    assert (
+        parse_and_remove_think_tags(
+            "a  thinkingx</think> b  thinkingy</think> c"
+        )
+        == "a  b  c"
+    )
+
+    # Tags which are not `think` tags are kept untouched.
+    assert (
+        parse_and_remove_think_tags("<thinking>keep me</thinking>")
+        == "<thinking>keep me</thinking>"
+    )
+
