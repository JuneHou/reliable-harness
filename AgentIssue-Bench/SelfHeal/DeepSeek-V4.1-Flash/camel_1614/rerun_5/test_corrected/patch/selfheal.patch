+def test_openai_assistant_message_removes_think_tags():
+    r"""The thinking content should not be sent back to the model."""
+    content = "This is the answer.  thinkingLet me reason here.\n</think>"
+    message = BaseMessage.make_assistant_message(
+        role_name="assistant",
+        content=content,
+    )
+
+    # The original content is left untouched ...
+    assert message.content == content
+    # ... but the thinking content is removed from the request payload.
+    assert message.to_openai_assistant_message() == {
+        "role": "assistant",
+        "content": "This is the answer.  ",
+    }
+    assert message.to_openai_message(OpenAIBackendRole.ASSISTANT) == {
+        "role": "assistant",
+        "content": "This is the answer.  ",
+    }
+
+
+def test_openai_assistant_message_without_think_tags():
+    content = "This is the answer."
+    message = BaseMessage.make_assistant_message(
+        role_name="assistant",
+        content=content,
+    )
+    assert message.to_openai_assistant_message() == {
+        "role": "assistant",
+        "content": content,
+    }
