+def remove_think_content(content: str) -> str:
+    r"""Remove the thinking content from the given text.
+
+    Reasoning models such as DeepSeek R1 wrap their chain of thought between
+    `` thinking`` and ``</think>`` tags. Such content is only meaningful for
+    the turn in which it has been generated, and it should not be sent back to
+    the model, as it is useless for the model and some platforms even raise an
+    error when it is present in the request.
+
+    Args:
+        content (str): The text which may contain thinking content.
+
+    Returns:
+        str: The text with all the thinking content removed.
+
+    Example:
+        >>> remove_think_content('Hello  thinkinghmm</think>world')
+        'Hello world'
+    """
+    if not isinstance(content, str) or not content:
+        return content
+
+    # Remove all the complete thinking blocks, tags included.
+    cleaned = THINK_BLOCK_PATTERN.sub("", content)
+
+    # A dangling closing tag means that the reasoning has been opened before
+    # the text, thus keep only the part after the tag.
+    closing_tag = CLOSING_THINK_TAG_PATTERN.search(cleaned)
+    if closing_tag is not None:
+        cleaned = cleaned[closing_tag.end() :]
+
+    # An unterminated thinking block (e.g. a truncated response) is dropped
+    # together with everything which follows the opening tag.
+    opening_tag = OPENING_THINK_TAG_PATTERN.search(cleaned)
+    if opening_tag is not None:
+        cleaned = cleaned[: opening_tag.start()]
+
+    if cleaned == content:
+        # Nothing has been removed, keep the original text untouched.
+        return content
+
+    return cleaned.strip()
+
+
