+def test_remove_think_content():
+    # Text without any thinking content should stay untouched.
+    assert remove_think_content("") == ""
+    assert remove_think_content("No think tags here.") == (
+        "No think tags here."
+    )
+
+    # A complete thinking block is removed together with its tags.
+    assert (
+        remove_think_content("Hello  thinkinghidden reasoning</think>world")
+        == "Hello world"
+    )
+    assert (
+        remove_think_content(
+            "<thinking>step by step</thinking>The final answer."
+        )
+        == "The final answer."
+    )
+
+    # Multiple thinking blocks.
+    assert (
+        remove_think_content("A  thinkingx</think>B  thinkingy</think>C")
+        == "A B C"
+    )
+
+    # A dangling closing tag: only the answer after it is kept.
+    assert remove_think_content("previous reasoning</think>The answer.") == (
+        "The answer."
+    )
+
+    # An unterminated thinking block: the truncated reasoning is dropped.
+    assert (
+        remove_think_content("The answer.  thinkingstill reasoning")
+        == "The answer."
+    )
+
+    # A message consisting only of thinking content becomes empty.
+    assert remove_think_content(" only thinking</think>") == ""
+
