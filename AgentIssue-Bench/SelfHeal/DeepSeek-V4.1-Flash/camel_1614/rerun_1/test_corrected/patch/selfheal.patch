+def test_openai_messages_remove_think_content():
+    content = (
+        "Here is the answer.  thinkingLet me reason about the question "
+        "step by step, this part should never be sent back.</think>"
+        "The result is 42."
+    )
+    expected_content = "Here is the answer. The result is 42."
+
+    message = BaseMessage(
+        role_name="test_role_name",
+        role_type=RoleType.ASSISTANT,
+        meta_dict=dict(),
+        content=content,
+    )
+
+    # The content of the message itself is kept untouched.
+    assert message.content == content
+
+    assistant_message = message.to_openai_message(
+        OpenAIBackendRole.ASSISTANT
+    )
+    assert assistant_message == {
+        "role": "assistant",
+        "content": expected_content,
+    }
+
+    user_message = message.to_openai_message(OpenAIBackendRole.USER)
+    assert user_message == {"role": "user", "content": expected_content}
+
+    system_message = message.to_openai_message(OpenAIBackendRole.SYSTEM)
+    assert system_message == {"role": "system", "content": expected_content}
+
+
+def test_openai_messages_remove_unfinished_think_content():
+    # A response truncated while the model was still thinking.
+    message = BaseMessage(
+        role_name="test_role_name",
+        role_type=RoleType.ASSISTANT,
+        meta_dict=dict(),
+        content="The answer is 42.  with a closing tag",
+    )
+    assert (
+        message.to_openai_assistant_message()["content"] == "The answer is 42."
+    )
+
+    message = BaseMessage(
+        role_name="test_role_name",
+        role_type=RoleType.ASSISTANT,
+        meta_dict=dict(),
+        content="The answer is 42.  thinkingtruncated reasoning",
+    )
+    assert (
+        message.to_openai_assistant_message()["content"] == "The answer is 42."
+    )
+
+
