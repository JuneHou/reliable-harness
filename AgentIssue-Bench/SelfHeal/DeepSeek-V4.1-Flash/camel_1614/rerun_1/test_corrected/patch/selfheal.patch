+# Pattern matching a complete thinking block, e.g. `` thinking ... </think>``
+# or ``<thinking> ... </thinking>``, together with its tags.
+THINK_BLOCK_PATTERN = re.compile(
+    r"<think(?:ing)?>.*?</think(?:ing)?>", re.DOTALL | re.IGNORECASE
+)
+
+# Pattern matching an opening thinking tag, e.g. `` thinking``.
+OPENING_THINK_TAG_PATTERN = re.compile(r"<think(?:ing)?>", re.IGNORECASE)
+
+# Pattern matching a closing thinking tag, e.g. ``</think>``.
+CLOSING_THINK_TAG_PATTERN = re.compile(r"</think(?:ing)?>", re.IGNORECASE)
+
 
