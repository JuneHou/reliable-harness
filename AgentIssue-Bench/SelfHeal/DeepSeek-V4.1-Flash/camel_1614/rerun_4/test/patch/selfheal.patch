--- a/test/messages/test_message_base.py
+++ b/test/messages/test_message_base.py
@@ -138,6 +138,80 @@ def test_base_message():
     }
 
 
+def test_base_message_remove_think_content():
+    content = (
+        "The answer is 4.  Let me think step by step: 2 + 2 = 4. "
+    )
+    message = BaseMessage.make_assistant_message(
+        role_name="assistant",
+        content=content,
+    )
+
+    # The thinking content is removed from the message content.
+    assert message.content == "The answer is 4."
+
+    # And it is never sent back to the model.
+    assert message.to_openai_assistant_message() == {
+        "role": "assistant",
+        "content": "The answer is 4.",
+    }
+    assert message.to_openai_message(OpenAIBackendRole.ASSISTANT) == {
+        "role": "assistant",
+        "content": "The answer is 4.",
+    }
+
+
+def test_base_message_remove_multiple_think_contents():
+    content = (
+        "First answer.  reasoning one "
+        "Second answer.  reasoning\non multiple\nlines "
+    )
+    message = BaseMessage.make_assistant_message(
+        role_name="assistant",
+        content=content,
+    )
+    assert message.content == "First answer.  Second answer."
+
+
+def test_base_message_remove_unclosed_think_content():
+    content = "The answer is 4.  Let me think step by step: 2 + 2"
+    message = BaseMessage.make_assistant_message(
+        role_name="assistant",
+        content=content,
+    )
+    assert message.content == "The answer is 4."
+
+
+def test_base_message_without_think_content_is_untouched():
+    content = "This is the content.\n\n```python\nprint('hello')\n```\n"
+    message = BaseMessage.make_user_message(
+        role_name="user",
+        content=content,
+    )
+    assert message.content == content
+    assert message.to_openai_user_message() == {
+        "role": "user",
+        "content": content,
+    }
+
+
+def test_to_openai_message_does_not_send_think_content(base_message):
+    # Content assigned after the message creation must not be sent either.
+    base_message.content = "Answer.  hidden reasoning "
+    assert base_message.to_openai_system_message() == {
+        "role": "system",
+        "content": "Answer.",
+    }
+    assert base_message.to_openai_user_message() == {
+        "role": "user",
+        "content": "Answer.",
+    }
+    assert base_message.to_openai_assistant_message() == {
+        "role": "assistant",
+        "content": "Answer.",
+    }
+
