+def strip_think_content(content: str) -> str:
+    r"""Removes the thinking content from the given string.
+
+    Reasoning models (e.g. DeepSeek R1) may return their chain of thought
+    wrapped in :obj:` think ... </think> ` tags. This content is only meant
+    to be consumed once and should neither be kept in the memory nor be
+    sent back to the model, so it is removed by this helper.
+
+    Both complete blocks and truncated blocks (i.e. content containing an
+    opening tag but no closing tag, which happens when the generation stops
+    before the answer is produced) are handled.
+
+    Args:
+        content (str): The content to be cleaned.
+
+    Returns:
+        str: The content without any thinking block.
+
+    Example:
+        >>> strip_think_content("2 + 2 = 4.  Let me verify. ")
+        '2 + 2 = 4.'
+    """
+    if not content or not isinstance(content, str):
+        return content
+
+    cleaned_content = THINK_BLOCK_PATTERN.sub("", content)
+    # Handle truncated thinking content, i.e. a block which was never closed
+    # because the generation stopped too early.
+    cleaned_content = UNCLOSED_THINK_BLOCK_PATTERN.sub("", cleaned_content)
+
+    if cleaned_content == content:
+        # Nothing was removed, keep the original content untouched.
+        return content
+
+    return cleaned_content.strip()
+
+
+# Aliases kept to make the call sites more readable.
+remove_think_content = strip_think_content
+strip_think = strip_think_content
+
+
