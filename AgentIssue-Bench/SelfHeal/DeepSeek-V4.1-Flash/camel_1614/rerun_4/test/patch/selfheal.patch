+# Pattern matching a complete thinking/chain-of-thought block, such as the
+# one produced by DeepSeek R1 (i.e. ` think ... </think> `).
+THINK_BLOCK_PATTERN = re.compile(
+    r"<\s*think\s*>[^<]*?(?:<(?!\s*/\s*think\s*>)[^<]*?)*?<\s*/\s*think\s*>",
+    re.DOTALL,
+)
+
+# Pattern matching a thinking block whose closing tag is missing, which
+# happens when the generation is truncated before the answer is produced.
+UNCLOSED_THINK_BLOCK_PATTERN = re.compile(r"<\s*think\s*>.*\Z", re.DOTALL)
+
 
