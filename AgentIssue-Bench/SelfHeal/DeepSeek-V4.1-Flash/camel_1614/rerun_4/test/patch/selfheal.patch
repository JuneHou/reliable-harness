+def test_strip_think_content_without_think():
+    content = "This is a plain content."
+    assert strip_think_content(content) == content
+
+    content = "Text with a code block.\n\n```python\nprint(1)\n```\n"
+    assert strip_think_content(content) == content
+
+    assert strip_think_content("") == ""
+
+
+def test_strip_think_content_with_think():
+    content = "The answer is 4.  Let me think step by step. "
+    assert strip_think_content(content) == "The answer is 4."
+
+    content = "Before.  Step 1: ... Step 2: ...  After."
+    assert strip_think_content(content) == "Before.  After."
+
+
+def test_strip_think_content_with_multiple_think_blocks():
+    content = "First.  a  Second.  b "
+    content += "Third."
+    assert strip_think_content(content) == "First.  Second.  Third."
+
+
+def test_strip_think_content_with_multiline_think_block():
+    content = "Result.  First line.\nSecond line.\n"
+    assert strip_think_content(content) == "Result."
+
+
+def test_strip_think_content_with_unclosed_think_block():
+    content = "Result.  Still thinking..."
+    assert strip_think_content(content) == "Result."
+
+
+def test_strip_think_content_only_think_block():
+    assert strip_think_content(" Only reasoning. ") == ""
