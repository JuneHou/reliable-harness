+# Byte order marks that unambiguously identify an encoding.
+_BOMS = (
+    (codecs.BOM_UTF32_LE, "utf-32-le"),
+    (codecs.BOM_UTF32_BE, "utf-32-be"),
+    (codecs.BOM_UTF8, "utf-8-sig"),
+    (codecs.BOM_UTF16_LE, "utf-16-le"),
+    (codecs.BOM_UTF16_BE, "utf-16-be"),
+)
+
+# Encodings tried (in order) when the content is not valid UTF-8 and no
+# third party detector is available. GB18030 is a superset of GBK/GB2312,
+# so it covers Chinese (GBK) encoded configuration files.
+_FALLBACK_ENCODINGS = (
+    "gb18030",
+    "gbk",
+    "big5",
+    "shift_jis",
+    "euc-kr",
+    "cp1252",
+    "latin-1",  # Decodes any byte sequence, used as an absolute last resort
+)
+
+
+def _detect_encoding(raw_bytes: bytes) -> str:
+    """Detect the most likely encoding of the given bytes.
+
+    UTF-8 (and BOM marked encodings) are detected first, then optional
+    third party detectors (charset-normalizer / chardet) are used when
+    available, and finally a list of common encodings is tried.
+    """
+    if not raw_bytes:
+        return "utf-8"
+
+    for bom, encoding in _BOMS:
+        if raw_bytes.startswith(bom):
+            return encoding
+
+    try:
+        raw_bytes.decode("utf-8")
+        return "utf-8"
+    except UnicodeDecodeError:
+        pass
+
+    try:
+        from charset_normalizer import from_bytes as _from_bytes
+
+        best_match = _from_bytes(raw_bytes).best()
+        if best_match is not None and best_match.encoding:
+            return best_match.encoding
+    except Exception:
+        pass
+
+    try:
+        import chardet
+
+        detected = chardet.detect(raw_bytes).get("encoding")
+        if detected:
+            return detected
+    except Exception:
+        pass
+
+    for encoding in _FALLBACK_ENCODINGS:
+        try:
+            raw_bytes.decode(encoding)
+            return encoding
+        except (UnicodeDecodeError, LookupError):
+            continue
+
+    return "utf-8"
+
+
+def _decode_bytes(raw_bytes: bytes) -> str:
+    """Decode the given bytes, falling back gracefully if needed."""
+    encoding = _detect_encoding(raw_bytes)
+    try:
+        return raw_bytes.decode(encoding)
+    except (UnicodeDecodeError, LookupError):
+        for fallback in ("utf-8", "gb18030"):
+            try:
+                return raw_bytes.decode(fallback)
+            except (UnicodeDecodeError, LookupError):
+                continue
+        return raw_bytes.decode("utf-8", errors="replace")
+
+
+def _load_yaml_file(config_path: Path) -> Any:
+    """Read a YAML file, automatically detecting its encoding."""
+    with open(config_path, "rb") as file:
+        raw_bytes = file.read()
+
+    return yaml.safe_load(_decode_bytes(raw_bytes))
+
 
