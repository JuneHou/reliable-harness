+# Encodings tried, in order, when the encoding of a YAML file cannot be
+# detected (or when the detection result cannot decode the file).
+# ``gb18030`` is a superset of ``gbk``/``gb2312`` and covers most Chinese
+# documents, while ``latin-1`` can decode any byte sequence and is therefore
+# used as the very last resort.
+_FALLBACK_ENCODINGS = ("utf-8", "gb18030", "gbk", "big5", "latin-1")
+
+
+def _detect_encoding(raw_content: bytes) -> str:
+    """Detect the encoding of ``raw_content`` and return an encoding name.
+
+    UTF-8 is preferred (it is the most common encoding for YAML files), then
+    the encoding guessed by ``chardet`` (when available), and finally a list of
+    common encodings such as GB18030/GBK are tried so that files containing
+    non-ASCII characters (e.g. Chinese text) can be loaded regardless of the
+    encoding they were saved with.
+    """
+    # Respect explicit byte order marks before anything else.
+    if raw_content.startswith(b"\xef\xbb\xbf"):
+        return "utf-8-sig"
+    if raw_content.startswith((b"\xff\xfe", b"\xfe\xff")):
+        return "utf-16"
+
+    candidates = []
+
+    # Plain UTF-8 first: if the content decodes cleanly, it is UTF-8.
+    candidates.append("utf-8")
+
+    if chardet is not None:
+        try:
+            detected = chardet.detect(raw_content) or {}
+        except Exception:  # pragma: no cover - never fail because of detection
+            detected = {}
+
+        detected_encoding = detected.get("encoding")
+        if detected_encoding:
+            candidates.append(detected_encoding)
+
+    candidates.extend(_FALLBACK_ENCODINGS)
+
+    seen = set()
+    for encoding in candidates:
+        if not encoding or encoding.lower() in seen:
+            continue
+        seen.add(encoding.lower())
+        try:
+            raw_content.decode(encoding)
+        except (UnicodeDecodeError, LookupError):
+            continue
+        return encoding
+
+    # Nothing matched; let the caller raise a meaningful error while decoding.
+    return "utf-8"
+
 
