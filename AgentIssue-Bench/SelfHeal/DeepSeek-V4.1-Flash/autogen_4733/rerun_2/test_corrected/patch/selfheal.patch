+@pytest.mark.asyncio
+async def test_can_load_function_with_reqs_alias() -> None:
+    with tempfile.TemporaryDirectory() as temp_dir:
+        cancellation_token = CancellationToken()
+        executor = LocalCommandLineCodeExecutor(work_dir=temp_dir, functions=[load_data_with_alias])
+        code = f"""from {executor.functions_module} import load_data_with_alias
+
+# Get first row's name
+data = load_data_with_alias()
+print(data['name'][0])"""
+
+        result = await executor.execute_code_blocks(
+            code_blocks=[
+                CodeBlock(language="python", code=code),
+            ],
+            cancellation_token=cancellation_token,
+        )
+        assert result.output == "John\n"
+        assert result.exit_code == 0
+
+
