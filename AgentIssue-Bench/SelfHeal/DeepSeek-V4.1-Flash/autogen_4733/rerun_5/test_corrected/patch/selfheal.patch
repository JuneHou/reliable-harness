+@pytest.mark.asyncio
+async def test_can_load_multiple_functions_with_non_hashable_global_imports() -> None:
+    # Building the functions module for several functions whose global imports
+    # are `Alias` / `ImportFromModule` objects (which are not hashable) must not
+    # raise `TypeError: unhashable type`.
+    with tempfile.TemporaryDirectory() as temp_dir:
+        cancellation_token = CancellationToken()
+        executor = LocalCommandLineCodeExecutor(
+            work_dir=temp_dir,
+            functions=[
+                get_current_dir_alias_import,
+                join_two_paths,
+                get_current_dir_alias_import,
+                add_two_numbers,
+            ],
+        )
+        code = f"""from {executor.functions_module} import get_current_dir_alias_import, join_two_paths
+print(join_two_paths("a", "b"))
+print(len(get_current_dir_alias_import()) > 0)"""
+
+        result = await executor.execute_code_blocks(
+            code_blocks=[
+                CodeBlock(language="python", code=code),
+            ],
+            cancellation_token=cancellation_token,
+        )
+        assert result.output == "a/b\nTrue\n"
+        assert result.exit_code == 0
