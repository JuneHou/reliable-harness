+def _imports_to_strs(imports: Sequence[Import]) -> List[str]:
+    """Convert a sequence of imports to strings, removing duplicates while preserving order.
+
+    `Alias` and `ImportFromModule` are (mutable) dataclasses and therefore not hashable, so the
+    de-duplication has to be done on the rendered string representation of the imports instead of
+    on the import objects themselves.
+    """
+    seen: Set[str] = set()
+    import_strs: List[str] = []
+    for im in imports:
+        import_str = _import_to_str(im)
+        if import_str not in seen:
+            seen.add(import_str)
+            import_strs.append(import_str)
+    return import_strs
+
