+    @staticmethod
+    def _get_restricted_to(msg) -> set:
+        """Get the restricted audience of a message.
+
+        Only `WwMessage` carries the `restricted_to` attribute; ordinary `Message` objects
+        (such as the initial `UserRequirement` published by `Team.run_project`) do not have it,
+        so they are treated as broadcast messages instead of raising `AttributeError`.
+        """
+        return getattr(msg, "restricted_to", None) or set()
+
     async def _observe(self, ignore_memory=False) -> int:
         if self.status != RoleState.ALIVE:
             # 死者不再参与游戏
@@ -60,7 +70,8 @@ class BasePlayer(Role):
