+# Values that are considered as "the user explicitly turned telemetry off".
+# `OTEL_SDK_DISABLED` is the standard OpenTelemetry opt-out env var.
+_DISABLED_ENV_VALUES = {"true", "1", "yes", "on"}
+
+# Env vars that can be used to turn telemetry off.
+_DISABLED_ENV_VARS = ("OTEL_SDK_DISABLED", "CREWAI_DISABLE_TELEMETRY")
+
+
+def is_telemetry_disabled() -> bool:
+    """Return whether telemetry has been explicitly disabled by the user.
+
+    The check is intentionally performed on every call (rather than once at
+    import time) so that setting ``OTEL_SDK_DISABLED=true`` - even after
+    ``crewai`` has been imported - reliably stops all telemetry work instead
+    of silently keeping the exporter alive and timing out.
+    """
+    for env_var in _DISABLED_ENV_VARS:
+        value = os.getenv(env_var)
+        if value is None:
+            continue
+        if value.strip().lower() in _DISABLED_ENV_VALUES:
+            return True
+    return False
+
+
