+# Capabilities assumed for models that are not listed in the model capabilities table, for example
+# models served by OpenAI-compatible endpoints such as Groq's
+# `llama3-groq-70b-8192-tool-use-preview`. Like the official OpenAI SDK, unknown model names are not
+# rejected: capabilities are simply assumed, and the remote API decides what is actually supported.
+# Users who know better should pass `model_capabilities` explicitly.
+_DEFAULT_MODEL_CAPABILITIES: Dict[str, bool] = {
+    "vision": True,
+    "function_calling": True,
+    "json_output": True,
+}
+
+# Token limit assumed for models whose token limit is not known.
+_DEFAULT_TOKEN_LIMIT = 128_000
+
+
+def _get_capabilities_or_default(model: str) -> ModelCapabilities:
+    """Look up the capabilities of ``model`` and fall back to defaults for unknown models.
+
+    Models that are absent from the model capabilities table used to raise a ``KeyError`` when the
+    client was created without explicit ``model_capabilities``. Instead, a warning is emitted and
+    default capabilities are used.
+    """
+    capabilities: Optional[ModelCapabilities] = None
+    try:
+        capabilities = _model_info.get_capabilities(model)
+    except KeyError:
+        capabilities = None
+
+    if capabilities is None:
+        warnings.warn(
+            f"Model capabilities not found for model '{model}'. "
+            f"Using default capabilities {dict(_DEFAULT_MODEL_CAPABILITIES)}. "
+            "Pass 'model_capabilities' to the client to override them.",
+            stacklevel=3,
+        )
+        return cast(ModelCapabilities, dict(_DEFAULT_MODEL_CAPABILITIES))
+
+    return capabilities
+
+
+def _get_resolved_model_or_none(model: str) -> Optional[str]:
+    """Resolve ``model`` to the name used by the API, or ``None`` if the model is unknown."""
+    try:
+        return _model_info.resolve_model(model)
+    except KeyError:
+        return None
+
 
