+def to_int(value, default: int = 0) -> int:
+    """Normalize a value that may arrive as a string (i.e. from prompt args/kwargs) to an int."""
+    try:
+        return int(float(value))
+    except (TypeError, ValueError):
+        return default
+
+
+def to_bool(value) -> bool:
+    """Normalize a value that may arrive as "true"/"false"/"1"/"0" strings to a bool."""
+    if isinstance(value, bool):
+        return value
+    return str(value).strip().lower() in ["true", "1", "yes", "on"]
+
