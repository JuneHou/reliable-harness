+def to_int(value, default: int = 0) -> int:
+    """Convert a value (usually a string coming from the API) into an int.
+
+    Values that cannot be converted fall back to `default` so that
+    comparisons such as `websearch_depth > 0` never raise a TypeError.
+    """
+    if value is None:
+        return default
+    try:
+        return int(value)
+    except (TypeError, ValueError):
+        pass
+    try:
+        return int(float(value))
+    except (TypeError, ValueError):
+        return default
+
