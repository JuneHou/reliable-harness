@@ -85,8 +91,12 @@ class Chain:
             )
 
             prompt_args = {}
-            for argument, chain_step_argument in arguments:
-                prompt_args[argument.name] = chain_step_argument.value
+            for argument in arguments:
+                argument_obj = argument[0]
+                chain_step_argument = argument[1]
+                if argument_obj is None or chain_step_argument is None:
+                    continue
+                prompt_args[argument_obj.name] = chain_step_argument.value
 
             prompt.update(prompt_args)
 
