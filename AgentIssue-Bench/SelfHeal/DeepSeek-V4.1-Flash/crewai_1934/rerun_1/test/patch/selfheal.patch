+def test_crew_kickoff_raises_error_instead_of_hanging(monkeypatch):
+    """
+    Kickoff must surface the underlying LLM error instead of silently retrying
+    forever (which made the crew hang when e.g. an authentication error occurred).
+    """
+    monkeypatch.setenv("OPENAI_API_KEY", "test-key")
+
+    failing_agent = Agent(
+        role="Failing Agent",
+        goal="Fail loudly instead of hanging.",
+        backstory="You are used to validate that errors are properly propagated.",
+        allow_delegation=False,
+    )
+
+    task = Task(
+        description="Perform a task that will fail because of an LLM error.",
+        expected_output="An output that will never be produced.",
+        agent=failing_agent,
+    )
+
+    crew = Crew(agents=[failing_agent], tasks=[task], process=Process.sequential)
+
+    with patch.object(
+        CrewAgentExecutor,
+        "_get_llm_response",
+        side_effect=Exception("AuthenticationError: Incorrect API key provided"),
+    ):
+        with pytest.raises(Exception, match="AuthenticationError"):
+            crew.kickoff()
+
+
+def test_crew_agent_executor_reraises_unexpected_errors(monkeypatch):
+    """
+    The agent executor loop must re-raise unexpected errors (such as
+    authentication errors) so that they are not swallowed forever.
+    """
+    monkeypatch.setenv("OPENAI_API_KEY", "test-key")
+
+    llm = MagicMock()
+    llm.stop = None
+    llm.supports_stop_words.return_value = True
+
+    executor = CrewAgentExecutor(
+        llm=llm,
+        task=MagicMock(),
+        crew=MagicMock(),
+        agent=MagicMock(),
+        prompt={"prompt": "Do something"},
+        max_iter=3,
+        tools=[],
+        tools_names="",
+        stop_words=[],
+        tools_description="",
+        tools_handler=MagicMock(),
+    )
+    executor.messages = [{"role": "user", "content": "Do something"}]
+    executor._get_llm_response = MagicMock(
+        side_effect=Exception("AuthenticationError: Incorrect API key provided")
+    )
+
+    with pytest.raises(Exception, match="AuthenticationError"):
+        executor._invoke_loop()
