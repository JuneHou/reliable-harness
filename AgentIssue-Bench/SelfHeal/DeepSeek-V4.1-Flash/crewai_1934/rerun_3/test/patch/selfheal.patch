+def test_crew_kickoff_raises_llm_error_instead_of_hanging():
+    """An LLM error (e.g. an authentication error) must propagate out of kickoff.
+
+    Regression test: non context-length exceptions raised during the agent's
+    execution loop used to be silently swallowed, which meant the iteration
+    counter never advanced and `kickoff` looped forever instead of failing.
+    """
+
+    agent = Agent(
+        role="Researcher",
+        goal="Be super empathetic.",
+        backstory="You love to say howdy.",
+        allow_delegation=False,
+    )
+
+    task = Task(description="say howdy", expected_output="Howdy!", agent=agent)
+
+    crew = Crew(agents=[agent], tasks=[task])
+
+    llm_error = Exception("AuthenticationError: Incorrect API key provided")
+
+    with patch.object(
+        CrewAgentExecutor, "_get_llm_response", side_effect=llm_error
+    ) as get_llm_response:
+        with pytest.raises(Exception, match="AuthenticationError"):
+            crew.kickoff()
+
+        # The error must be raised right away, the loop must not retry forever.
+        assert get_llm_response.call_count == 1
+
+
+def test_invoke_loop_reraises_non_context_length_errors():
+    """`CrewAgentExecutor._invoke_loop` should re-raise unexpected exceptions."""
+
+    from crewai.agents.crew_agent_executor import CrewAgentExecutor as Executor
+    from crewai.agents.tools_handler import ToolsHandler
+
+    class _FakeLLM:
+        stop: list = []
+
+        def supports_stop_words(self) -> bool:
+            return True
+
+        def call(self, *args, **kwargs):
+            raise Exception("AuthenticationError: Incorrect API key provided")
+
+    executor = Executor(
+        llm=_FakeLLM(),
+        task=Task(
+            description="say howdy",
+            expected_output="Howdy!",
+            agent=Agent(
+                role="Researcher",
+                goal="Be super empathetic.",
+                backstory="You love to say howdy.",
+                allow_delegation=False,
+            ),
+        ),
+        crew=None,
+        agent=Agent(
+            role="Researcher",
+            goal="Be super empathetic.",
+            backstory="You love to say howdy.",
+            allow_delegation=False,
+        ),
+        prompt={"prompt": "{input} {tool_names} {tools}"},
+        max_iter=2,
+        tools=[],
+        tools_names="",
+        stop_words=[],
+        tools_description="",
+        tools_handler=ToolsHandler(),
+    )
+
+    with pytest.raises(Exception, match="AuthenticationError"):
+        executor._invoke_loop()
