+/**
+ * Creates the JSON schema for the tool parameters and makes sure that all
+ * descriptions defined in the zod schema are preserved.
+ */
+function prepareParametersJsonSchema(
+  parameters: z.ZodSchema<any> | Schema<any>,
+): JSONSchema7 {
+  // for zod schemas, asSchema converts the zod schema into a JSON schema.
+  // the conversion attaches the description of a schema to the generated JSON
+  // schema, but it loses the description of wrapper schemas, e.g.
+  // `z.string().optional().describe('...')`, because the wrapper is unwrapped
+  // without taking its description into account:
+  const jsonSchema = asSchema(parameters).jsonSchema;
+
+  return isZodSchema(parameters)
+    ? addZodDescriptions(jsonSchema, parameters)
+    : jsonSchema;
+}
+
+/**
+ * Walks the zod schema and the generated JSON schema in parallel and copies the
+ * descriptions of the zod schemas into the JSON schema.
+ *
+ * This restores descriptions that are defined on wrapper schemas, such as
+ * `z.string().optional().describe('...')`, which would otherwise be lost
+ * during the JSON schema conversion. The JSON schema passed in is the freshly
+ * generated JSON schema of the zod schema, so it is safe to modify it.
+ */
+function addZodDescriptions(
+  jsonSchema: JSONSchema7,
+  zodSchema: z.ZodTypeAny,
+): JSONSchema7 {
+  if (!isJsonSchemaObject(jsonSchema)) {
+    return jsonSchema;
+  }
+
+  const zodDef = (zodSchema as any)?._def;
+
+  if (zodDef == null) {
+    return jsonSchema;
+  }
+
+  const jsonSchemaObject = jsonSchema as any;
+
+  // add the description of the zod schema if the JSON schema does not
+  // already have one (the description might have been added by the
+  // conversion of the wrapped schema):
+  if (
+    typeof zodDef.description === 'string' &&
+    jsonSchemaObject.description == null
+  ) {
+    jsonSchemaObject.description = zodDef.description;
+  }
+
+  switch (zodDef.typeName) {
+    // wrapper schemas that do not change the shape of the wrapped schema:
+    case 'ZodOptional':
+    case 'ZodNullable':
+    case 'ZodDefault':
+    case 'ZodCatch':
+    case 'ZodReadonly':
+    case 'ZodBranded':
+    case 'ZodPromise': {
+      const innerSchema = zodDef.innerType ?? zodDef.type;
+
+      if (innerSchema != null) {
+        addZodDescriptions(jsonSchema, innerSchema);
+      }
+      break;
+    }
+
+    // refined schemas:
+    case 'ZodEffects': {
+      if (zodDef.schema != null) {
+        addZodDescriptions(jsonSchema, zodDef.schema);
+      }
+      break;
+    }
+
+    case 'ZodObject': {
+      const shape =
+        typeof zodDef.shape === 'function' ? zodDef.shape() : zodDef.shape;
+      const properties = jsonSchemaObject.properties;
+
+      if (shape == null || properties == null) {
+        break;
+      }
+
+      for (const key of Object.keys(shape)) {
+        const propertyJsonSchema = properties[key];
+
+        if (isJsonSchemaObject(propertyJsonSchema)) {
+          addZodDescriptions(propertyJsonSchema, shape[key]);
+        }
+      }
+      break;
+    }
+
+    case 'ZodArray': {
+      const items = jsonSchemaObject.items;
+
+      if (isJsonSchemaObject(items) && zodDef.type != null) {
+        addZodDescriptions(items, zodDef.type);
+      }
+      break;
+    }
+
+    case 'ZodUnion':
+    case 'ZodDiscriminatedUnion': {
+      const options: Array<z.ZodTypeAny> =
+        zodDef.options instanceof Map
+          ? Array.from(zodDef.options.values())
+          : zodDef.options;
+      const anyOf = jsonSchemaObject.anyOf;
+
+      if (!Array.isArray(anyOf) || !Array.isArray(options)) {
+        break;
+      }
+
+      for (
+        let index = 0;
+        index < anyOf.length && index < options.length;
+        index++
+      ) {
+        if (isJsonSchemaObject(anyOf[index])) {
+          addZodDescriptions(anyOf[index], options[index]);
+        }
+      }
+      break;
+    }
+
+    case 'ZodIntersection': {
+      const allOf = jsonSchemaObject.allOf;
+
+      if (Array.isArray(allOf) && allOf.length === 2) {
+        if (isJsonSchemaObject(allOf[0]) && zodDef.left != null) {
+          addZodDescriptions(allOf[0], zodDef.left);
+        }
+
+        if (isJsonSchemaObject(allOf[1]) && zodDef.right != null) {
+          addZodDescriptions(allOf[1], zodDef.right);
+        }
+      }
+      break;
+    }
+
+    case 'ZodRecord': {
+      const additionalProperties = jsonSchemaObject.additionalProperties;
+
+      if (isJsonSchemaObject(additionalProperties) && zodDef.valueType != null) {
+        addZodDescriptions(additionalProperties, zodDef.valueType);
+      }
+      break;
+    }
+
+    // all other zod types (strings, numbers, enums, literals, etc.)
+    // do not contain nested schemas:
+    default: {
+      break;
+    }
+  }
+
+  return jsonSchema;
+}
+
+function isZodSchema(schema: unknown): schema is z.ZodTypeAny {
+  return (
+    schema != null &&
+    typeof schema === 'object' &&
+    '_def' in schema &&
+    typeof (schema as any).parse === 'function'
+  );
+}
+
+function isJsonSchemaObject(value: unknown): value is JSONSchema7 {
+  return value != null && typeof value === 'object' && !Array.isArray(value);
+}
