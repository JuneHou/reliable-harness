+
+function isJsonSchema(value: unknown): value is JSONSchema7 {
+  return typeof value === 'object' && value != null && !Array.isArray(value);
+}
+
+/**
+ * zod-to-json-schema (which is used by `asSchema` to convert zod schemas into
+ * JSON schemas) represents optional fields as a wrapper, e.g.:
+ *
+ *   `anyOf: [{ not: { anyOf: [...] } }, { type: 'string', description: '...' }]`
+ *
+ * The description of the field (e.g. of `z.string().describe('...').optional()`)
+ * is placed inside the wrapped schema. Providers only forward descriptions that
+ * are attached to the property schema itself, so such descriptions are lost for
+ * the model.
+ *
+ * This function hoists nested descriptions onto the wrapping schema so that the
+ * descriptions of optional fields are preserved in the tool parameter schema.
+ */
+function addDescriptionsToJsonSchema(schema: JSONSchema7): JSONSchema7 {
+  const result: JSONSchema7 = { ...schema };
+
+  // recursively process nested schemas:
+  const properties = result.properties;
+  if (properties != null) {
+    result.properties = Object.fromEntries(
+      Object.entries(properties).map(([key, value]) => [
+        key,
+        isJsonSchema(value) ? addDescriptionsToJsonSchema(value) : value,
+      ]),
+    );
+  }
+
+  const items = result.items;
+  if (Array.isArray(items)) {
+    result.items = items.map(item =>
+      isJsonSchema(item) ? addDescriptionsToJsonSchema(item) : item,
+    );
+  } else if (isJsonSchema(items)) {
+    result.items = addDescriptionsToJsonSchema(items);
+  }
+
+  const additionalProperties = result.additionalProperties;
+  if (isJsonSchema(additionalProperties)) {
+    result.additionalProperties = addDescriptionsToJsonSchema(
+      additionalProperties,
+    );
+  }
+
+  if (result.anyOf != null) {
+    result.anyOf = result.anyOf.map(subschema =>
+      isJsonSchema(subschema)
+        ? addDescriptionsToJsonSchema(subschema)
+        : subschema,
+    );
+  }
+
+  if (result.oneOf != null) {
+    result.oneOf = result.oneOf.map(subschema =>
+      isJsonSchema(subschema)
+        ? addDescriptionsToJsonSchema(subschema)
+        : subschema,
+    );
+  }
+
+  if (result.allOf != null) {
+    result.allOf = result.allOf.map(subschema =>
+      isJsonSchema(subschema)
+        ? addDescriptionsToJsonSchema(subschema)
+        : subschema,
+    );
+  }
+
+  // hoist the description of a single wrapped schema (e.g. an optional field)
+  // onto the wrapping schema, since descriptions on nested schemas are not
+  // forwarded to the model:
+  if (result.description == null) {
+    const nestedDescriptions = [
+      ...(result.anyOf ?? []),
+      ...(result.oneOf ?? []),
+      ...(result.allOf ?? []),
+    ]
+      .filter(isJsonSchema)
+      .map(subschema => subschema.description)
+      .filter(description => description != null);
+
+    if (nestedDescriptions.length === 1) {
+      result.description = nestedDescriptions[0];
+    }
+  }
+
+  return result;
+}
