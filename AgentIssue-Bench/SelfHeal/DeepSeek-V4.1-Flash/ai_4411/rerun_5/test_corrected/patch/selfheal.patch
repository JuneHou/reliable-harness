+it('should preserve the description of an optional zod field in the tool parameters', () => {
+  const toolsWithOptionalField: Record<string, CoreTool> = {
+    tool3: tool({
+      description: 'Tool 3 description',
+      parameters: z.object({
+        city: z.string().optional().describe('The city to get the weather for'),
+      }),
+    }),
+  };
+
+  const result = prepareToolsAndToolChoice({
+    tools: toolsWithOptionalField,
+    toolChoice: undefined,
+    activeTools: undefined,
+  });
+
+  const parameters = result.tools?.[0].parameters as any;
+
+  expect(parameters.properties.city.description).toBe(
+    'The city to get the weather for',
+  );
+});
+
+it('should preserve field descriptions in nested objects and arrays', () => {
+  const nestedTools: Record<string, CoreTool> = {
+    tool4: tool({
+      description: 'Tool 4 description',
+      parameters: z.object({
+        location: z
+          .object({
+            name: z.string().optional().describe('The name of the location'),
+          })
+          .describe('The location'),
+        tags: z
+          .array(z.string().optional().describe('A tag'))
+          .describe('The tags'),
+      }),
+    }),
+  };
+
+  const result = prepareToolsAndToolChoice({
+    tools: nestedTools,
+    toolChoice: undefined,
+    activeTools: undefined,
+  });
+
+  const parameters = result.tools?.[0].parameters as any;
+
+  expect(parameters.properties.location.description).toBe('The location');
+  expect(parameters.properties.location.properties.name.description).toBe(
+    'The name of the location',
+  );
+  expect(parameters.properties.tags.description).toBe('The tags');
+});
