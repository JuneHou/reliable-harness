+@pytest.mark.asyncio
+async def test_async_get_human_input_no_tool_responses():
+    """The async human reply must not attach an empty `tool_responses` list to the reply message.
+
+    An empty `tool_responses` was previously kept in the oai message and forwarded to the LLM,
+    which made the OpenAI API fail with a 400 BadRequestError about the unexpected property.
+    """
+    user_proxy = autogen.UserProxyAgent(name="user", human_input_mode="ALWAYS", code_execution_config=False)
+
+    async def custom_a_get_human_input(prompt):
+        return "This is a test"
+
+    user_proxy.a_get_human_input = custom_a_get_human_input
+
+    # A plain message without function/tool calls must not produce `tool_responses`.
+    messages = [{"role": "assistant", "content": "Hello."}]
+    final, response = await user_proxy.a_check_termination_and_human_reply(messages=messages, sender=user_proxy)
+    assert final is True
+    assert response == {"role": "user", "content": "This is a test"}
+    assert "tool_responses" not in response
+
+    # The reply is appended to the conversation without the unexpected property.
+    user_proxy._oai_messages.clear()
+    user_proxy._append_oai_message(response, "user", user_proxy)
+    assert "tool_responses" not in user_proxy._oai_messages[user_proxy][-1]
+
+
+@pytest.mark.asyncio
+async def test_async_get_human_input_with_tool_calls():
+    """Tool calls interrupted by a human reply must still get "USER INTERRUPTED" tool responses."""
+    user_proxy = autogen.UserProxyAgent(name="user", human_input_mode="ALWAYS", code_execution_config=False)
+
+    async def custom_a_get_human_input(prompt):
+        return "USER INPUT"
+
+    user_proxy.a_get_human_input = custom_a_get_human_input
+
+    messages = [
+        {
+            "role": "assistant",
+            "content": None,
+            "tool_calls": [
+                {"id": "call_1", "type": "function", "function": {"name": "echo", "arguments": "{}"}},
+                {"id": "call_2", "type": "function", "function": {"name": "echo", "arguments": "{}"}},
+            ],
+        }
+    ]
+    final, response = await user_proxy.a_check_termination_and_human_reply(messages=messages, sender=user_proxy)
+    assert final is True
+    assert response["role"] == "user"
+    assert response["content"] == "USER INPUT"
+    assert response["tool_responses"] == [
+        {"role": "tool", "tool_call_id": "call_1", "content": "USER INTERRUPTED"},
+        {"role": "tool", "tool_call_id": "call_2", "content": "USER INTERRUPTED"},
+    ]
+
+
 if __name__ == "__main__":
     test_async_get_human_input()
