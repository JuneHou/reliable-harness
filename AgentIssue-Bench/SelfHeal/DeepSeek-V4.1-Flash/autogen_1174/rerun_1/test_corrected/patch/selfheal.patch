+        return "This is a test"
+
+    user_proxy.a_get_human_input = custom_a_get_human_input
+
+    user_proxy.register_reply([autogen.Agent, None], autogen.ConversableAgent.a_check_termination_and_human_reply)
+
+    @user_proxy.register_for_execution()
+    @assistant.register_for_llm(description="This is a test function")
+    def my_function(a: Annotated[str, "description of a parameter"] = "a", b: int = 2) -> str:
+        return f"{a} {b}"
+
+    await user_proxy.a_initiate_chat(assistant, clear_history=True, message="Hello. Please call the function.")
+
+
