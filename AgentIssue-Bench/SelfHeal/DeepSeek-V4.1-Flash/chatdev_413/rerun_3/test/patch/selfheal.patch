+def message_to_chat_message_kwargs(message: Any) -> Dict[str, Any]:
+    r"""Converts a message returned by the OpenAI API into the set of keyword
+    arguments that :obj:`ChatMessage` accepts.
+
+    Different versions of the OpenAI Python SDK expose different fields on a
+    chat completion message. For example, recent versions add a
+    :obj:`refusal` field (and sometimes :obj:`annotations`), which makes the
+    naive ``ChatMessage(..., **dict(choice.message))`` call fail with
+    ``TypeError: ChatMessage.__init__() got an unexpected keyword argument
+    'refusal'``. Therefore only the fields that :obj:`ChatMessage` actually
+    understands are forwarded and the unknown ones are silently ignored.
+
+    Args:
+        message (Any): A message of an OpenAI chat completion response. It can
+            be either a pydantic model or a plain dictionary.
+
+    Returns:
+        Dict[str, Any]: Keyword arguments that can safely be passed to
+            :obj:`ChatMessage`.
+    """
+    if isinstance(message, dict):
+        raw_message: Dict[str, Any] = dict(message)
+    else:
+        # Both pydantic v1 and v2 models can be turned into a dict this way
+        raw_message = dict(message)
+
+    parameters = inspect.signature(ChatMessage.__init__).parameters
+    accepts_var_keyword = any(parameter.kind == inspect.Parameter.VAR_KEYWORD
+                              for parameter in parameters.values())
+    if accepts_var_keyword:
+        # ChatMessage tolerates arbitrary keyword arguments, forward them all
+        allowed_keys = set(raw_message.keys())
+    else:
+        allowed_keys = set(parameters.keys()) - {"self"}
+
+    kwargs = {
+        key: value
+        for key, value in raw_message.items()
+        if key in allowed_keys
+    }
+    # `content` is None when the model only returns tool calls
+    if kwargs.get("content") is None:
+        kwargs["content"] = ""
+    return kwargs
+
+
