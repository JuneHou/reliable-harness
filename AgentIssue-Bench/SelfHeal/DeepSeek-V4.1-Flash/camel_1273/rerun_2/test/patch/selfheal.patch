+def _get_api_key_candidate_names(key: str) -> List[str]:
+    r"""Get the argument/attribute names that may hold the value of the
+    required API key :obj:`key`.
+
+    For instance, a required key such as :obj:`OPENAI_API_KEY` may be provided
+    directly through the generic :obj:`api_key` (or :obj:`_api_key`) argument
+    or instance attribute, while a key such as :obj:`API_KEY_1` may be
+    provided through an argument or attribute of the very same name.
+
+    Args:
+        key (str): The name of the required API key.
+
+    Returns:
+        List[str]: The candidate argument/attribute names.
+    """
+    key_lower = key.lower()
+    candidates = [key, key_lower, f"_{key}", f"_{key_lower}"]
+    # Provider-specific keys (e.g. `OPENAI_API_KEY`) can also be passed
+    # directly through the generic `api_key` argument/attribute.
+    if key_lower.endswith("api_key"):
+        candidates.extend(["api_key", "_api_key"])
+    return candidates
+
+
+def _is_api_key_available(
+    key: str,
+    call_args: Mapping[str, Any],
+    instance: Any,
+) -> bool:
+    r"""Check whether the required API key :obj:`key` is available, either in
+    the environment variables, in the arguments directly passed to the
+    decorated function (which includes the arguments given to a decorated
+    :obj:`__init__` method), or as an instance attribute.
+
+    Args:
+        key (str): The name of the required API key.
+        call_args (Mapping[str, Any]): The arguments the decorated function
+            was called with, keyed by parameter name.
+        instance (Any): The instance the decorated method is bound to, if any.
+
+    Returns:
+        bool: Whether the API key is available.
+    """
+    # 1. Environment variables.
+    if key in os.environ:
+        return True
+
+    # 2. Arguments passed directly to the decorated function and
+    #    attributes already set on the instance.
+    for candidate in _get_api_key_candidate_names(key):
+        if call_args.get(candidate):
+            return True
+        if instance is not None and not candidate.startswith("__"):
+            try:
+                if getattr(instance, candidate, None):
+                    return True
+            except Exception:
+                continue
+
+    return False
+
+
