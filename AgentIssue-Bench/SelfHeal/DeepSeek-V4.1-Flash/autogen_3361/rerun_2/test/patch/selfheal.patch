diff --git a/autogen/coding/func_with_reqs.py b/autogen/coding/func_with_reqs.py
index 21e415d..6fb8456 100644
--- a/autogen/coding/func_with_reqs.py
+++ b/autogen/coding/func_with_reqs.py
@@ -28,12 +28,28 @@ class Alias:
     name: str
     alias: str
 
+    def __hash__(self) -> int:
+        # Dataclasses are unhashable by default, but imports may be collected in hashed
+        # containers (e.g. sets), so make sure aliases can be hashed.
+        return hash((self.name, self.alias))
+
 
 @dataclass
 class ImportFromModule:
     module: str
     imports: List[Union[str, Alias]]
 
+    def __hash__(self) -> int:
+        # `imports` is a list and therefore unhashable, so build a hashable representation
+        # of the imports before hashing the object.
+        imports = []
+        for i in self.imports:
+            if isinstance(i, str):
+                imports.append(i)
+            else:
+                imports.append((i.name, i.alias))
+        return hash((self.module, tuple(imports)))
+
 
 Import = Union[str, ImportFromModule, Alias]
 
