+def _get_tiktoken() -> Any:
+    """Import ``tiktoken`` lazily.
+
+    ``tiktoken`` is an optional dependency. Importing it at module import time made it a
+    hard requirement for every package that (transitively) imports this module - for
+    example AutoGen Studio, which therefore failed to launch when ``tiktoken`` was not
+    installed. The dependency is now only required when tokens actually need to be
+    counted.
+    """
+    try:
+        import tiktoken
+    except ImportError as e:
+        raise ImportError(
+            "tiktoken is required to count tokens. Please install it with `pip install tiktoken`."
+        ) from e
+    return tiktoken
+
+
