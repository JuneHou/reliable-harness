 ]
+
+# The public names are resolved lazily on first access. Importing them eagerly pulled in
+# the whole runtime stack (database manager -> component factory -> openai model client),
+# which in turn required optional third party packages such as ``tiktoken`` to be
+# installed just to import ``autogenstudio``. Because of that, AutoGen Studio could not
+# be launched in environments (e.g. the devcontainer) where ``tiktoken`` is missing.
+_LAZY_IMPORTS: Dict[str, Tuple[str, str]] = {
+    "Agent": (".datamodel", "Agent"),
+    "AgentConfig": (".datamodel", "AgentConfig"),
+    "Model": (".datamodel", "Model"),
+    "ModelConfig": (".datamodel", "ModelConfig"),
+    "Team": (".datamodel", "Team"),
+    "TeamConfig": (".datamodel", "TeamConfig"),
+    "Tool": (".datamodel", "Tool"),
+    "ToolConfig": (".datamodel", "ToolConfig"),
+    "DatabaseManager": (".database.db_manager", "DatabaseManager"),
+    "TeamManager": (".teammanager", "TeamManager"),
+}
+
+
+def __getattr__(name: str) -> Any:
+    """Lazily import public names so that optional dependencies are only required on use."""
+    try:
+        module_path, attribute_name = _LAZY_IMPORTS[name]
+    except KeyError:
+        raise AttributeError(f"module {__name__!r} has no attribute {name!r}") from None
+
+    import importlib
+
+    module = importlib.import_module(module_path, __name__)
+    value = getattr(module, attribute_name)
+    globals()[name] = value
+    return value
+
+
+def __dir__() -> List[str]:
+    return sorted(set(list(globals().keys()) + list(_LAZY_IMPORTS.keys())))
