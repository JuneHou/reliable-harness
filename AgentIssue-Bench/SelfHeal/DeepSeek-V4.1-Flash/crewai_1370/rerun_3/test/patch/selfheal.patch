+def _get_fake_llm_class():
+    """Lazily build (and cache) the ``FakeLLM`` class.
+
+    ``embedchain`` (and its transitive dependencies such as ``chromadb`` and
+    ``langchain``) is very expensive to import, so it must not be imported at
+    module import time; otherwise ``import crewai`` becomes extremely slow.
+    """
+    fake_llm_cls = globals().get("FakeLLM")
+    if fake_llm_cls is None:
+        from embedchain.llm.base import BaseLlm
+
+        class FakeLLM(BaseLlm):
+            pass
+
+        FakeLLM.__module__ = __name__
+        FakeLLM.__qualname__ = "FakeLLM"
+        globals()["FakeLLM"] = FakeLLM
+        fake_llm_cls = FakeLLM
+    return fake_llm_cls
+
+
+def __getattr__(name: str):
+    # Keep `from crewai.memory.storage.rag_storage import FakeLLM` working
+    # without paying the cost of importing embedchain eagerly.
+    if name == "FakeLLM":
+        return _get_fake_llm_class()
+    raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
 
 
