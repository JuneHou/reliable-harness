     module="pydantic.main",
 )
 
+# Importing the submodules below eagerly pulls in very heavy third party
+# dependencies (litellm, embedchain, chromadb, langchain, instructor, pyvis,
+# ...), which made `import crewai` take tens of seconds. The public API is kept
+# exactly the same, but names are resolved lazily on first access.
+_LAZY_IMPORTS = {
+    "Agent": ("crewai.agent", "Agent"),
+    "Crew": ("crewai.crew", "Crew"),
+    "Flow": ("crewai.flow.flow", "Flow"),
+    "LLM": ("crewai.llm", "LLM"),
+    "Pipeline": ("crewai.pipeline", "Pipeline"),
+    "Process": ("crewai.process", "Process"),
+    "Router": ("crewai.routers", "Router"),
+    "Task": ("crewai.task", "Task"),
+}
+
 __all__ = ["Agent", "Crew", "Process", "Task", "Pipeline", "Router", "LLM", "Flow"]
+
+
+def __getattr__(name: str) -> Any:
+    """Resolve the public classes lazily, on first access."""
+    if name in _LAZY_IMPORTS:
+        module_path, attribute = _LAZY_IMPORTS[name]
+        module = importlib.import_module(module_path)
+        value = getattr(module, attribute)
+        # Cache it so subsequent lookups are plain attribute accesses.
+        globals()[name] = value
+        return value
+
+    raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
+
+
+def __dir__():
+    return sorted(set(globals()) | set(_LAZY_IMPORTS))
