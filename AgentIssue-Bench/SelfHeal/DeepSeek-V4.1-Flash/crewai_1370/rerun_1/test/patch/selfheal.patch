 __all__ = ["Agent", "Crew", "Process", "Task", "Pipeline", "Router", "LLM", "Flow"]
+
+# Importing ``crewai.agent`` (and friends) eagerly pulls in a huge dependency
+# tree (litellm, embedchain/chromadb, instructor, pyvis, ...) which is what made
+# ``import crewai`` take tens of seconds. The public API is therefore resolved
+# lazily on first access instead of at package import time.
+_LAZY_IMPORTS: Dict[str, Tuple[str, str]] = {
+    "Agent": ("crewai.agent", "Agent"),
+    "Crew": ("crewai.crew", "Crew"),
+    "Process": ("crewai.process", "Process"),
+    "Task": ("crewai.task", "Task"),
+    "Pipeline": ("crewai.pipeline", "Pipeline"),
+    "Router": ("crewai.routers", "Router"),
+    "LLM": ("crewai.llm", "LLM"),
+    "Flow": ("crewai.flow.flow", "Flow"),
+}
+
+_SUBMODULES = {"agent", "crew", "flow", "llm", "pipeline", "process", "routers", "task"}
+
+
+def __getattr__(name: str) -> Any:
+    """Lazily resolve the public names of the package."""
+    import importlib
+
+    if name in _LAZY_IMPORTS:
+        module_name, attribute = _LAZY_IMPORTS[name]
+        value = getattr(importlib.import_module(module_name), attribute)
+        globals()[name] = value
+        return value
+
+    if name in _SUBMODULES:
+        module = importlib.import_module(f"{__name__}.{name}")
+        globals()[name] = module
+        return module
+
+    raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
+
+
+def __dir__():
+    return sorted(set(globals().keys()) | set(__all__))
