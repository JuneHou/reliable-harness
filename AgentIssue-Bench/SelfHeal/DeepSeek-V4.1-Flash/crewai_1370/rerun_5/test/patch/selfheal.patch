@@ -17,3 +23,38 @@ warnings.filterwarnings(
 )
 
 __all__ = ["Agent", "Crew", "Process", "Task", "Pipeline", "Router", "LLM", "Flow"]
+
+# Maps the public attribute name to the module that actually defines it.
+_LAZY_IMPORTS = {
+    "Agent": ("crewai.agent", "Agent"),
+    "Crew": ("crewai.crew", "Crew"),
+    "Flow": ("crewai.flow.flow", "Flow"),
+    "LLM": ("crewai.llm", "LLM"),
+    "Pipeline": ("crewai.pipeline", "Pipeline"),
+    "Process": ("crewai.process", "Process"),
+    "Router": ("crewai.routers", "Router"),
+    "Task": ("crewai.task", "Task"),
+}
+
+
+def __getattr__(name: str) -> Any:
+    """Import public objects on first access (PEP 562).
+
+    This keeps ``import crewai`` cheap while preserving
+    ``from crewai import Agent`` / ``crewai.Agent`` behaviour.
+    """
+    if name in _LAZY_IMPORTS:
+        import importlib
+
+        module_name, attribute = _LAZY_IMPORTS[name]
+        module = importlib.import_module(module_name)
+        value = getattr(module, attribute)
+        # Cache the resolved object so subsequent lookups are direct.
+        globals()[name] = value
+        return value
+
+    raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
+
+
+def __dir__() -> list:
+    return sorted(set(globals()) | set(__all__))
