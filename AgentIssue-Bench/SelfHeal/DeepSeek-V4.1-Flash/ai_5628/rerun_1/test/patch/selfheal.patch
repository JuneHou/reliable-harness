     },
   });
 });
+
+it('should convert record schemas (additionalProperties) without undefined values', () => {
+  // `z.record(z.string())` is converted by zod to an object schema that only
+  // has `additionalProperties`. Such schemas must not be removed from the
+  // generated schema (which previously produced `undefined` values that
+  // Vertex AI rejected).
+  const input: JSONSchema7 = {
+    type: 'object',
+    properties: {
+      record: {
+        type: 'object',
+        additionalProperties: { type: 'string' },
+      },
+      emptyObject: {
+        type: 'object',
+      },
+    },
+    required: ['record'],
+    additionalProperties: false,
+    $schema: 'http://json-schema.org/draft-07/schema#',
+  };
+
+  const converted = convertJSONSchemaToOpenAPISchema(input);
+
+  expect(converted).toStrictEqual({
+    type: 'object',
+    properties: {
+      record: { type: 'object' },
+      emptyObject: { type: 'object' },
+    },
+    required: ['record'],
+  });
+});
+
+it('should convert a record schema at the root level', () => {
+  const input: JSONSchema7 = {
+    type: 'object',
+    additionalProperties: { type: 'string' },
+  };
+
+  expect(convertJSONSchemaToOpenAPISchema(input)).toStrictEqual({
+    type: 'object',
+  });
+});
+
+it('should not create undefined values in nested arrays and unions', () => {
+  const input: JSONSchema7 = {
+    type: 'object',
+    properties: {
+      list: {
+        type: 'array',
+        items: { type: 'object' },
+      },
+      union: {
+        anyOf: [{ type: 'object' }, { type: 'string' }],
+      },
+    },
+  };
+
+  expect(convertJSONSchemaToOpenAPISchema(input)).toStrictEqual({
+    type: 'object',
+    properties: {
+      list: {
+        type: 'array',
+        items: { type: 'object' },
+      },
+      union: {
+        anyOf: [{ type: 'object' }, { type: 'string' }],
+      },
+    },
+  });
+});
