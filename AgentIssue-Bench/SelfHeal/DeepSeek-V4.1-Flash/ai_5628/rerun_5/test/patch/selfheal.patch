+
+it('should keep record schemas (additionalProperties) and not return undefined', () => {
+  const input: JSONSchema7 = {
+    type: 'object',
+    properties: {
+      metadata: {
+        type: 'object',
+        additionalProperties: { type: 'string' },
+      },
+    },
+    required: ['metadata'],
+  };
+
+  expect(convertJSONSchemaToOpenAPISchema(input)).toEqual({
+    type: 'object',
+    properties: {
+      metadata: {
+        type: 'object',
+        additionalProperties: { type: 'string' },
+      },
+    },
+    required: ['metadata'],
+  });
+});
+
+it('should convert a root level record schema', () => {
+  const input: JSONSchema7 = {
+    type: 'object',
+    additionalProperties: { type: 'number' },
+  };
+
+  expect(convertJSONSchemaToOpenAPISchema(input)).toEqual({
+    type: 'object',
+    additionalProperties: { type: 'number' },
+  });
+});
+
+it('should convert nested record schemas', () => {
+  const input: JSONSchema7 = {
+    type: 'object',
+    properties: {
+      nested: {
+        type: 'object',
+        properties: {
+          values: {
+            type: 'object',
+            additionalProperties: {
+              type: 'object',
+              properties: {
+                id: { type: 'string' },
+              },
+            },
+          },
+        },
+      },
+    },
+  };
+
+  expect(convertJSONSchemaToOpenAPISchema(input)).toEqual({
+    type: 'object',
+    properties: {
+      nested: {
+        type: 'object',
+        properties: {
+          values: {
+            type: 'object',
+            additionalProperties: {
+              type: 'object',
+              properties: {
+                id: { type: 'string' },
+              },
+            },
+          },
+        },
+      },
+    },
+  });
+});
+
+it('should not return undefined for nested empty object schemas', () => {
+  const input: JSONSchema7 = {
+    type: 'object',
+    properties: {
+      emptyObject: { type: 'object', properties: {} },
+      optionalEmptyObject: { type: 'object' },
+      list: {
+        type: 'array',
+        items: { type: 'object', properties: {} },
+      },
+      choice: {
+        anyOf: [{ type: 'object', properties: {} }, { type: 'string' }],
+      },
+    },
+  };
+
+  const converted = convertJSONSchemaToOpenAPISchema(input) as any;
+
+  expect(converted).toEqual({
+    type: 'object',
+    properties: {
+      emptyObject: { type: 'object', properties: {} },
+      optionalEmptyObject: { type: 'object' },
+      list: {
+        type: 'array',
+        items: { type: 'object', properties: {} },
+      },
+      choice: {
+        anyOf: [{ type: 'object', properties: {} }, { type: 'string' }],
+      },
+    },
+  });
+
+  // no `undefined` values may leak into the generated schema:
+  expect(JSON.stringify(converted)).not.toContain('undefined');
+});
