 });
+
+it('should convert additionalProperties (e.g. z.record) schemas', () => {
+  const input: JSONSchema7 = {
+    type: 'object',
+    properties: {
+      metadata: {
+        type: 'object',
+        additionalProperties: { type: 'string' },
+      },
+      scores: {
+        type: 'array',
+        items: {
+          type: 'object',
+          additionalProperties: { type: 'number' },
+        },
+      },
+    },
+    required: ['metadata'],
+    additionalProperties: false,
+  };
+
+  expect(convertJSONSchemaToOpenAPISchema(input)).toEqual({
+    type: 'object',
+    properties: {
+      metadata: {
+        type: 'object',
+        additionalProperties: { type: 'string' },
+      },
+      scores: {
+        type: 'array',
+        items: {
+          type: 'object',
+          additionalProperties: { type: 'number' },
+        },
+      },
+    },
+    required: ['metadata'],
+  });
+});
+
+it('should not drop object schemas that only define additionalProperties', () => {
+  const input: JSONSchema7 = {
+    type: 'object',
+    additionalProperties: { type: 'string' },
+  };
+
+  expect(convertJSONSchemaToOpenAPISchema(input)).toEqual({
+    type: 'object',
+    additionalProperties: { type: 'string' },
+  });
+});
