+
+it('should handle object schemas with additionalProperties (z.record)', () => {
+  const input: JSONSchema7 = {
+    type: 'object',
+    properties: {
+      metadata: {
+        type: 'object',
+        additionalProperties: { type: 'string' },
+      },
+    },
+  };
+
+  const expected = {
+    type: 'object',
+    properties: {
+      metadata: {
+        type: 'object',
+        additionalProperties: { type: 'string' },
+      },
+    },
+  };
+
+  expect(convertJSONSchemaToOpenAPISchema(input)).toEqual(expected);
+});
+
+it('should not return undefined for record schemas used as root schema', () => {
+  const input: JSONSchema7 = {
+    type: 'object',
+    additionalProperties: { type: 'string' },
+  };
+
+  expect(convertJSONSchemaToOpenAPISchema(input)).toEqual({
+    type: 'object',
+    additionalProperties: { type: 'string' },
+  });
+});
+
+it('should handle nested record schemas with object values', () => {
+  const input: JSONSchema7 = {
+    type: 'object',
+    properties: {
+      config: {
+        type: 'object',
+        additionalProperties: {
+          type: 'object',
+          properties: {
+            name: { type: 'string' },
+          },
+          required: ['name'],
+        },
+      },
+    },
+    required: ['config'],
+  };
+
+  const expected = {
+    type: 'object',
+    properties: {
+      config: {
+        type: 'object',
+        additionalProperties: {
+          type: 'object',
+          properties: {
+            name: { type: 'string' },
+          },
+          required: ['name'],
+        },
+      },
+    },
+    required: ['config'],
+  };
+
+  expect(convertJSONSchemaToOpenAPISchema(input)).toEqual(expected);
+});
+
+it('should handle nullable record schemas', () => {
+  const input: JSONSchema7 = {
+    type: 'object',
+    properties: {
+      metadata: {
+        anyOf: [
+          {
+            type: 'object',
+            additionalProperties: { type: 'string' },
+          },
+          {
+            type: 'null',
+          },
+        ],
+      },
+    },
+    required: ['metadata'],
+  };
+
+  const expected = {
+    type: 'object',
+    properties: {
+      metadata: {
+        type: 'object',
+        additionalProperties: { type: 'string' },
+        nullable: true,
+      },
+    },
+    required: ['metadata'],
+  };
+
+  expect(convertJSONSchemaToOpenAPISchema(input)).toEqual(expected);
+});
+
+it('should not include undefined values for empty object properties', () => {
+  const input: JSONSchema7 = {
+    type: 'object',
+    properties: {
+      empty: { type: 'object' },
+      emptyWithProperties: { type: 'object', properties: {} },
+      name: { type: 'string' },
+    },
+    required: ['name'],
+  };
+
+  const expected = {
+    type: 'object',
+    properties: {
+      name: { type: 'string' },
+    },
+    required: ['name'],
+  };
+
+  expect(convertJSONSchemaToOpenAPISchema(input)).toEqual(expected);
+});
+
+it('should omit additionalProperties when it converts to undefined', () => {
+  const input: JSONSchema7 = {
+    type: 'object',
+    properties: {
+      data: {
+        type: 'object',
+        additionalProperties: { type: 'object' },
+      },
+    },
+  };
+
+  const expected = {
+    type: 'object',
+    properties: {
+      data: { type: 'object' },
+    },
+  };
+
+  expect(convertJSONSchemaToOpenAPISchema(input)).toEqual(expected);
+});
