 });
+
+it('should handle a record schema (z.record) at the root', () => {
+  // z.record(z.string()) is
+  // { type: 'object', additionalProperties: { type: 'string' } }
+  const input: JSONSchema7 = {
+    type: 'object',
+    additionalProperties: { type: 'string' },
+  };
+
+  expect(convertJSONSchemaToOpenAPISchema(input)).toEqual({
+    type: 'object',
+    additionalProperties: { type: 'string' },
+  });
+});
+
+it('should handle record properties without producing undefined values', () => {
+  const input: JSONSchema7 = {
+    type: 'object',
+    properties: {
+      metadata: {
+        type: 'object',
+        additionalProperties: { type: 'string' },
+      },
+      name: { type: 'string' },
+    },
+    required: ['metadata', 'name'],
+    additionalProperties: false,
+    $schema: 'http://json-schema.org/draft-07/schema#',
+  };
+
+  const result = convertJSONSchemaToOpenAPISchema(input);
+
+  expect(result).toEqual({
+    type: 'object',
+    properties: {
+      metadata: {
+        type: 'object',
+        additionalProperties: { type: 'string' },
+      },
+      name: { type: 'string' },
+    },
+    required: ['metadata', 'name'],
+  });
+
+  // the converted schema must not contain undefined values,
+  // which serialize into invalid schemas:
+  expect(JSON.stringify(result)).not.toContain('undefined');
+  expect(Object.values(result as Record<string, unknown>)).not.toContain(
+    undefined,
+  );
+});
+
+it('should handle nested records', () => {
+  const input: JSONSchema7 = {
+    type: 'object',
+    properties: {
+      nested: {
+        type: 'object',
+        additionalProperties: {
+          type: 'object',
+          additionalProperties: { type: 'number' },
+        },
+      },
+    },
+  };
+
+  expect(convertJSONSchemaToOpenAPISchema(input)).toEqual({
+    type: 'object',
+    properties: {
+      nested: {
+        type: 'object',
+        additionalProperties: {
+          type: 'object',
+          additionalProperties: { type: 'number' },
+        },
+      },
+    },
+  });
+});
+
+it('should handle arrays of records', () => {
+  const input: JSONSchema7 = {
+    type: 'object',
+    properties: {
+      entries: {
+        type: 'array',
+        items: {
+          type: 'object',
+          additionalProperties: { type: 'string' },
+        },
+      },
+    },
+  };
+
+  expect(convertJSONSchemaToOpenAPISchema(input)).toEqual({
+    type: 'object',
+    properties: {
+      entries: {
+        type: 'array',
+        items: {
+          type: 'object',
+          additionalProperties: { type: 'string' },
+        },
+      },
+    },
+  });
+});
+
+it('should not emit undefined for nested empty object schemas', () => {
+  const input: JSONSchema7 = {
+    type: 'object',
+    properties: {
+      emptyObject: { type: 'object' },
+      name: { type: 'string' },
+    },
+    required: ['name'],
+  };
+
+  const result = convertJSONSchemaToOpenAPISchema(input);
+
+  expect(result).toEqual({
+    type: 'object',
+    properties: {
+      name: { type: 'string' },
+    },
+    required: ['name'],
+  });
+
+  expect(JSON.stringify(result)).not.toContain('undefined');
+});
+
+it('should not emit undefined for empty object schemas in arrays', () => {
+  const input: JSONSchema7 = {
+    type: 'object',
+    properties: {
+      list: {
+        type: 'array',
+        items: { type: 'object', properties: {} },
+      },
+    },
+  };
+
+  expect(convertJSONSchemaToOpenAPISchema(input)).toEqual({
+    type: 'object',
+    properties: {
+      list: {
+        type: 'array',
+      },
+    },
+  });
+});
