+def to_bool(value):
+    """Normalize values coming from API payloads into a real boolean."""
+    if isinstance(value, bool):
+        return value
+    if value is None:
+        return False
+    if isinstance(value, str):
+        return value.strip().lower() in ("true", "1", "yes", "on", "enabled")
+    return bool(value)
+
+
+def get_or_create_command(session, command_name):
+    """Make sure the command exists in the database before relating it to an agent."""
+    command = session.query(Command).filter_by(name=command_name).first()
+    if command:
+        return command
+    try:
+        command = Command(name=command_name)
+        session.add(command)
+        session.flush()
+        return command
+    except Exception as e:
+        session.rollback()
+        logging.error(f"Error creating command {command_name}: {str(e)}")
+        return session.query(Command).filter_by(name=command_name).first()
+
