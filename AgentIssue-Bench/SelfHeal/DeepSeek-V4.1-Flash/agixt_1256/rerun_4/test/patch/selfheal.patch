+def to_bool(value):
+    """Normalize any truthy/falsy representation of a command state to a bool."""
+    if isinstance(value, bool):
+        return value
+    if value is None:
+        return False
+    if isinstance(value, str):
+        return value.strip().lower() in ["true", "1", "yes", "on", "enabled"]
+    if isinstance(value, (int, float)):
+        return value != 0
+    return bool(value)
+
