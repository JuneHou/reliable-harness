@@ -0,0 +1,12 @@
+"""Validation utilities for instrumentation data."""
+# ENHANCED_V1: Accept trace_summary with TRACE_TRUNCATED flag
+
+def validate_trace_summary(summary: dict) -> bool:
+    """Validate a trace summary.
+    Returns True if the summary is acceptable.
+    """
+    # Allow the sentinel flag
+    if summary.get("TRACE_TRUNCATED") is True:
+        return True
+    # Basic sanity check: must be a dict (additional checks can be added)
+    return isinstance(summary, dict)
