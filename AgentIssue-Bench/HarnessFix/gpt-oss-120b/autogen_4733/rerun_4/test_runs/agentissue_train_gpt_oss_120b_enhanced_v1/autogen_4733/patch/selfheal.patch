diff --git a/harnessfix/run_test.sh b/harnessfix/run_test.sh
new file mode 100755
index 0000000..6b8ae6b
--- /dev/null
+++ b/harnessfix/run_test.sh
@@ -0,0 +1,9 @@
+#!/usr/bin/env bash
+# ENHANCED_V1: Guard pip‑install in harness – only install when a packaging manifest exists
+if [[ -f "setup.py" || -f "pyproject.toml" ]]; then
+    echo "Installing package (editable) because setup.py or pyproject.toml detected"
+    pip install -e .
+else
+    echo "Skipping pip install – no packaging manifest found; adding repo root to PYTHONPATH"
+    export PYTHONPATH="${PYTHONPATH}:$(pwd)"
+fi
