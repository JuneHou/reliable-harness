+# ENHANCED_V1: Regression test for pure-Python patch fallback
+import pathlib
+import tempfile
+
+import patch_util
+
+def test_apply_patch_python_fallback():
+    # Create a temporary directory with a file to patch
+    with tempfile.TemporaryDirectory() as td:
+        target_file = pathlib.Path(td) / "example.txt"
+        target_file.write_text("original line\n")
+
+        # Create a simple unified diff that modifies the line
+        patch_content = """\
+--- a/example.txt
++++ b/example.txt
+@@ -1 +1 @@
+-original line
++modified line
+"""
+        patch_path = pathlib.Path(td) / "change.patch"
+        patch_path.write_text(patch_content)
+
+        # Apply the patch using the helper (fallback will be used if system `patch` is absent)
+        assert patch_util.apply_patch(patch_path, pathlib.Path(td))
+
+        # Verify the file content was updated
+        assert target_file.read_text() == "modified line\n"
