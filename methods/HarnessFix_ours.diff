+        return output_file
+
+    if dry_run:
+        print(f"  [DRY RUN] would analyze: {regressed_ids}")
+        return output_file
+
+    with tempfile.NamedTemporaryFile(mode="w", suffix=".txt", delete=False) as f:
+        f.write("\n".join(regressed_ids) + "\n")
