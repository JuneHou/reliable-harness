+# ── AgentDefect mode (stochastic-harness adapter), built on the GAIA mode ──────────────────
+# The case's test decides pass or fail, so there is no expected answer string. The program and
+# test output (test-stdout.txt) is the failure evidence, and info.prediction holds its end.
+
+AGENTDEFECT_EXPECTED = "(decided by the case's test; see the program and test output)"
+
+
+def _agentdefect_get_paths(task_id: str) -> dict:
+    task_dir = _traces_dir() / task_id
+    return {
+        "traj_path": str(task_dir / f"{task_id}.traj.json"),
+        "report_path": "",
+        "test_output_path": str(task_dir / "test-stdout.txt"),
+        "output_path": RESULTS_DIR / f"{task_id}.traj.json",
+    }
+
+
+def _agentdefect_run_analysis(
+    task_id: str,
+    failure_category: str,
+    model_name: str,
+    config: dict,
+    impl_doc: str,
+    logger: logging.Logger,
+) -> dict | None:
+    """Run the analysis agent on one AgentDefect case (GAIA's _gaia_run_analysis, adapted)."""
+    paths = _agentdefect_get_paths(task_id)
+    task_data = _load_gaia_data().get(task_id, {})
+    intent = task_data.get("question") or task_data.get("instruction") or ""
+    predicted_answer = _gaia_extract_traj_prediction(paths["traj_path"])
+    test_output_path = Path(paths["test_output_path"])
+    test_output = test_output_path.read_text(errors="replace") if test_output_path.exists() else ""
+    evidence_anchor = {
+        "predicted_answer": _clean_excerpt(predicted_answer) if predicted_answer else "(empty)",
+        "exit_status": _gaia_extract_traj_exit_status(paths["traj_path"]),
+        "test_output_tail": _clean_excerpt(test_output[-3000:]) if test_output else "",
+    }
+    evidence_anchor = {k: v for k, v in evidence_anchor.items() if v}
+    task_description = f"{intent}\n\nExpected answer: {AGENTDEFECT_EXPECTED}"
+    sanitized_traj_path = write_sanitized_artifact(paths["traj_path"], _sanitized_traj_path(task_id))
+    htir_bundle = compile_gaia_htir(
+        task_id=task_id,
+        failure_category=failure_category,
+        traj_path=paths["traj_path"],
+        question=intent,
+        true_answer=AGENTDEFECT_EXPECTED,
+        predicted_answer=predicted_answer,
+    )
+    htir_path = write_bundle(htir_bundle, _htir_output_path(task_id))
+
+    agent_config = _agent_config_from_analysis_config(config)
+    agent_config["output_path"] = paths["output_path"]
+    env_config = config.get("environment", {})
+    model_config = config.get("model", {})
+    model = LitellmTextbasedModel(
+        model_name=model_name,
+        observation_template=model_config.get("observation_template", ""),
+        format_error_template=model_config.get("format_error_template", ""),
+        action_regex=model_config.get("action_regex", ""),
+        model_kwargs=model_config.get("model_kwargs", {}),
+        cost_tracking="ignore_errors",
+    )
+    env = _make_analysis_environment(env_config)
+    agent = DefaultAgent(model, env, **agent_config)
+    logger.info(f"Running AgentDefect analysis for {task_id} ({failure_category})")
+    try:
+        result = agent.run(
+            instance_id=task_id,
+            failure_category=failure_category,
+            traj_path=str(sanitized_traj_path),
+            raw_traj_path=paths["traj_path"],
+            report_path=paths["report_path"],
+            test_output_path=paths["test_output_path"],
+            impl_doc=impl_doc,
+            task_description=task_description,
+            **_agent_source_context("agentdefect"),
+            question=intent,
+            true_answer=AGENTDEFECT_EXPECTED,
+            predicted_answer=predicted_answer[-2000:],
+            task_level="n/a",
+            htir_path=str(htir_path),
+        )
+    except Exception as e:
+        logger.error(f"Agent raised exception for {task_id}: {e}")
+        return None
+    submission = result.get("submission", "")
+    logger.info(f"Submission for {task_id}: {submission!r}")
+    parsed = parse_submission(submission)
+    if parsed is None:
+        logger.warning(f"Could not parse JSON from submission for {task_id}")
+        return {
+            "instance_id": task_id,
+            "failure_category": failure_category,
+            "exit_status": result.get("exit_status", "unknown"),
+            "api_calls": agent.n_calls,
+            "failure_manifestation": "Analysis agent failed to produce valid JSON",
+            "failure_reason": f"Submission was: {submission}",
+            "agent_design_issue": "unknown",
+            "affected_component": "unknown",
+            "evidence_anchor": evidence_anchor,
+            "htir_path": str(htir_path),
+            "_parse_error": True,
+        }
+    parsed.setdefault("instance_id", task_id)
+    parsed.setdefault("failure_category", failure_category)
+    return _enrich_analysis_output(parsed, evidence_anchor, htir_bundle, htir_path)
+
